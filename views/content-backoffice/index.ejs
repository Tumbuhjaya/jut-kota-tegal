// --- Correct implementation of tampilkanBatas ---
function tampilkanBatas(id_ruas, color, label) {
    if (!id_ruas) return;
    var found = false;
    ruas_layer.eachLayer(function(layer) {
        // Adjust property name as needed – the server returns 'id'
        if (layer.feature.properties.id == id_ruas) {
            var clone = layer.clone();
            clone.setStyle({
                color: color,
                weight: 4,
                opacity: 0.9
            });
            clone.bindTooltip(label, { permanent: false, direction: 'auto' });
            batasGroup.addLayer(clone);
            found = true;
        }
    });
    if (!found) {
        console.warn('Ruas dengan ID ' + id_ruas + ' tidak ditemukan.');
    }
}
