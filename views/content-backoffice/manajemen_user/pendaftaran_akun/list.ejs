<% include ../../../template-backoffice/header.ejs %>
  <!-- Main Content -->
  <div class="main-content">
    <section class="section">
      <div class="w-100" style="padding: 0 30px;">
        <div class="section-header">
          <h1>Data Pendaftaran Akun Perizinan</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="/backoffice">Dashboard</a></div>
            <div class="breadcrumb-item">Data</div>
          </div>
        </div>
      </div>

      <div class="section-body">
        <div class="row">
          <div class="col-lg-12 col-xl-12">
            <div class="card">
              <div class="card-header">
                <div class="form-inline">
                  <label for="filter_status" class="mr-2">Status</label>
                  <select id="filter_status" class="custom-select">
                    <option value="">-- Semua --</option>
                    <option value="menunggu" selected>Menunggu Verifikasi</option>
                    <option value="disetujui">Disetujui</option>
                    <option value="ditolak">Ditolak</option>
                  </select>
                </div>
              </div>
              <div class="card-body">
                <div class="table-responsive">
                  <table class="table table-bordered table-striped table-hover" id="list-data">
                    <thead>
                    <tr>
                      <th class="header">No.</th>
                      <th class="header">Tgl. Daftar</th>
                      <th class="header">Username</th>
                      <th class="header">Nama</th>
                      <th class="header">Alamat</th>
                      <th class="header">No. Telepon (WhatsApp)</th>
                      <th class="header">Email</th>
                      <th class="header">Status</th>
                      <th class="header">Option</th>
                    </tr>
                  </thead>

                  <tbody>

                  </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <footer class="main-footer">
    <div class="footer-left">
      <% include ../../../template-backoffice/copyright-left.ejs %>
    </div>
    <div class="footer-right">
      <% include ../../../template-backoffice/copyright-right.ejs %>
    </div>
  </footer>
<% include ../../../template-backoffice/footer.ejs %>

<!-- Modal -->
<div class="modal fade" id="modalVerif" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Verifikasi Akun Perizinan</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-12">
            <table class="table table-sm table-borderless mb-3">
              <tr><td style="width: 120px;">Username</td><td id="v_username"></td></tr>
              <tr><td>Nama</td><td id="v_fullname"></td></tr>
              <tr><td>Alamat</td><td id="v_alamat"></td></tr>
              <tr><td>No. Telepon</td><td id="v_telp"></td></tr>
              <tr><td>Email</td><td id="v_email"></td></tr>
            </table>

            <div class="form-group">
              <label for="status_verif">Status Verifikasi ?</label>
              <select id="status_verif" class="custom-select">
                <option value="">-- Pilih --</option>
                <option value="setujui">-- Disetujui --</option>
                <option value="tolak">-- Ditolak --</option>
              </select>
            </div>

            <div class="form-group" id="konten-tolak">
              <label for="keterangan_tolak">Keterangan Ditolak</label>
              <textarea id="keterangan_tolak" class="form-control" rows="4" style="height: auto;"></textarea>
            </div>
            <small class="form-text text-muted">Hasil verifikasi akan dikirim ke email pemohon.</small>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fas fa-times"></i>&nbsp;&nbsp;Tutup</button>
        <button type="button" class="btn btn-primary" id="button_submit" onclick="simpan()"><i class="fas fa-save"></i>&nbsp;&nbsp;Simpan</button>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
    var rooturl = ''
    var STATUS = {
      menunggu:  { label: 'Menunggu Verifikasi', badge: 'info' },
      disetujui: { label: 'Disetujui', badge: 'success' },
      ditolak:   { label: 'Ditolak', badge: 'danger' }
    };
    let akun_dipilih = null

    function esc(t) {
      return $('<div>').text(t == null || t === '' ? '-' : t).html();
    }

    $('#konten-tolak').hide();

    $('#status_verif').change(function(){
      $('#konten-tolak').toggle($(this).val() == 'tolak');
    });

    let data_table  =$('#list-data').DataTable({
      "language": {
          "sProcessing":   "Sedang memproses...",
          "sLengthMenu":   "_MENU_",
          "sZeroRecords":  "Tidak ditemukan data yang sesuai",
          "sInfo":         "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
          "sInfoEmpty":    "Menampilkan 0 sampai 0 dari 0 entri",
          "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
          "sInfoPostFix":  "",
          "sUrl":          "",
          "oPaginate": {
            "sFirst":    "Pertama",
            "sPrevious": "Sebelumnya",
            "sNext":     "Selanjutnya",
            "sLast":     "Terakhir"
          }
      },
      "processing": true,
      "ordering": false,
      "ajax": {
        url: `${rooturl}/manajemen_users/pendaftaran_akun/list`,
        data: function () { return { status: $('#filter_status').val() }; }
      },
      "columns": [
        { "data": null, "defaultContent": ''},
        { "data": "created_date", render: function (d) { return d && moment(d).isValid() ? moment(d).format('DD/MM/YYYY HH:mm') : '-'; }},
        { "data": "username", render: esc},
        { "data": "fullname", render: esc},
        { "data": "alamat", render: esc},
        { "data": "telp", render: esc},
        { "data": "email", render: esc},
        { "data": null, render: function (r) {
          var s = STATUS[r.status_verifikasi] || { label: r.status_verifikasi, badge: 'light' };
          var html = '<span class="badge badge-' + s.badge + '">' + s.label + '</span>';
          if (r.diverifikasiAt) html += '<br/><small>' + moment(r.diverifikasiAt).format('DD/MM/YYYY HH:mm') + (r.nama_verifikator ? ' oleh ' + esc(r.nama_verifikator) : '') + '</small>';
          if (r.keterangan_verifikasi) html += '<br/><small class="text-danger">' + esc(r.keterangan_verifikasi) + '</small>';
          return html;
        }},
        { "data": null, render: function(r, type, row, meta){
          if (r.status_verifikasi !== 'menunggu') return '<div class="text-center">-</div>';
          return `
              <div class="w-100-flex" style="justify-content:center;gap:10px;">
                <button class="btn btn-warning" title="Verifikasi" onclick="bukaVerifikasi(${meta.row})"><i class="fas fa-user-check"></i></button>
              </div>`
        }},
      ],
      "columnDefs": [
        { "width": "40px", "targets": 0},
        { "width": "50px", "targets": 8}
      ],
    });

    data_table.on( 'draw.dt', function () {
      let PageInfo = $('#list-data').DataTable().page.info();
      data_table.column(0, { page: 'current' }).nodes().each( function (cell, i) {
        cell.innerHTML = i + 1 + PageInfo.start;
      });
    });

    $('#filter_status').change(function () { data_table.ajax.reload(); });

    function bukaVerifikasi(idx) {
      akun_dipilih = data_table.row(idx).data();
      ['username', 'fullname', 'alamat', 'telp', 'email'].forEach(function (k) {
        $('#v_' + k).text(akun_dipilih[k] || '-');
      });
      $('#status_verif').val('').trigger('change');
      $('#keterangan_tolak').val('');
      $('#modalVerif').modal('show');
    }

    async function simpan() {
      var aksi = $('#status_verif').val();
      var keterangan = $.trim($('#keterangan_tolak').val());
      if (!aksi) return swal('Periksa kembali', 'Status verifikasi wajib dipilih', 'warning');
      if (aksi == 'tolak' && !keterangan) return swal('Periksa kembali', 'Keterangan penolakan wajib diisi', 'warning');

      const yakin = await swal({
        title: aksi == 'setujui' ? 'Setujui Akun' : 'Tolak Akun',
        text: 'Akun ' + akun_dipilih.username + (aksi == 'setujui' ? ' akan disetujui dan bisa dipakai login.' : ' akan ditolak.') + ' Pemohon akan menerima email pemberitahuan. Lanjutkan?',
        icon: 'warning',
        dangerMode: aksi == 'tolak',
        buttons: ['Tidak', 'Ya'],
      });
      if (!yakin) return;

      $('#button_submit').prop('disabled', true);
      $.ajax({
        url: rooturl + '/manajemen_users/pendaftaran_akun/verifikasi/' + akun_dipilih.id_user,
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ aksi: aksi, keterangan: keterangan })
      }).done(function (res) {
        $('#modalVerif').modal('hide');
        swal('Berhasil', 'Verifikasi akun tersimpan.' + (res.data.email_dikirim ? ' Email pemberitahuan dikirim ke pemohon.' : ' Pemohon tidak memiliki email.'), 'success');
        data_table.ajax.reload();
      }).fail(function (xhr) {
        swal('Gagal', (xhr.responseJSON && xhr.responseJSON.message) || 'Gagal menyimpan verifikasi', 'error');
      }).always(function () {
        $('#button_submit').prop('disabled', false);
      });
    }
</script>
