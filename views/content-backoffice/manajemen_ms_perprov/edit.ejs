<% include ../../template-backoffice/header.ejs %>
  <div class="main-content">
    <section class="section">
      <div class="w-100" style="padding: 0 30px;">
        <div class="section-header" style="border-radius: 0.25rem;">
          <h1>Edit Data Perusahaan & Provider</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="/backoffice">Dashboard</a></div>
            <div class="breadcrumb-item active"><a href="/manajemen_master/perusahaan_provider">Data</a></div>
            <div class="breadcrumb-item">Edit Data</div>
          </div>
        </div>
      </div>

      <% include ./komponen.ejs %>

    </section>
  </div>

  <footer class="main-footer">
    <div class="footer-left">
      <% include ../../template-backoffice/copyright-left.ejs %>
    </div>
    <div class="footer-right">
      <% include ../../template-backoffice/copyright-right.ejs %>
    </div>
  </footer>

<% include ../../template-backoffice/footer.ejs %>

<script type="text/javascript">
  var rooturl = ''
  let perusahaan_provider = {}

  window.onload = async function () {
    // Load dropdown dulu
    await load_perusahaan()
    await load_provider()

    // Ambil data yang akan diedit
    let data = await $.get('/perusahaan_provider/list?id=<%=id%>')
    perusahaan_provider = data.data[0]

    $('#perusahaan_id').val(perusahaan_provider.perusahaan_id).select2()
    $('#provider_id').val(perusahaan_provider.provider_id).select2()
  }

  async function submit() {
    const will_update = await swal({
      title: "Edit Data",
      text: "Apakah anda akan mengedit data ini?",
      icon: "warning",
      dangerMode: true,
      buttons: ["Tidak", "Ya"],
    });

    if (will_update) {
      $('#button_submit').empty()
      $('#button_submit').append('<button class="btn btn-primary btn-embossed" disabled>Simpan</button>')

      let formData = new FormData()
      formData.append('perusahaan_provider_id', perusahaan_provider.perusahaan_provider_id)
      formData.append('perusahaan_id', $('#perusahaan_id').val())
      formData.append('provider_id', $('#provider_id').val())

      $.ajax({
        type: 'POST',
        url: rooturl + '/perusahaan_provider/edit',
        data: formData,
        processData: false,
        contentType: false,
        success: function(data) {
          swal({title: text_edit.title, text: text_edit.text, icon: text_edit.icon, type: text_edit.type})
          window.location.href = rooturl + '/manajemen_master/perusahaan_provider';
        },
        error: function(data) {
          swal({title: text_error.title, text: text_error.text, icon: text_error.icon, type: text_error.type})
        }
      })
    }
  }
</script>