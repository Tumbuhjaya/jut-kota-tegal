<% include ../../template-backoffice/header.ejs %>
  <!-- Main Content -->
  <div class="main-content">
    <section class="section">
      <div class="w-100" style="padding: 0 30px;">
        <div class="section-header">
          <h1>Data Master Penandatangan</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="/backoffice">Dashboard</a></div>
            <div class="breadcrumb-item">Data</div>
          </div>
        </div>
      </div>

      <div class="section-body">
        <div class="row">
          <div class="col-lg-12 col-xl-12">
            <div class="card">
              <div class="card-header">
                <a href="/manajemen_master/penandatangan/insert" class="btn btn-primary custom-btn-card-header"><i class="fas fa-plus"></i> Tambah Data</a>
              </div>
              <div class="card-body">
                <div class="table-responsive">
                  <table class="table table-bordered" id="list-data">
                    <thead>
                      <tr>
                        <th class="text-center">No.</th>
                        <th>Nama</th>
                        <th>NIP</th>
                        <th>Jabatan</th>
                        <th>Golongan</th>
                        <th>Status</th>
                        <th>Option</th>
                      </tr>
                    </thead>
                    <tbody></tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <footer class="main-footer">
    <div class="footer-left">
      <% include ../../template-backoffice/copyright-left.ejs %>
    </div>
    <div class="footer-right">
      <% include ../../template-backoffice/copyright-right.ejs %>
    </div>
  </footer>
<% include ../../template-backoffice/footer.ejs %>

<script type="text/javascript">
    var rooturl = ''

    function esc(t) {
      return $('<div>').text(t == null || t === '' ? '-' : t).html();
    }

    let data_table  =$('#list-data').DataTable({
      "language": {
          "sProcessing":   "Sedang memproses...",
          "sLengthMenu":   "_MENU_",
          "sZeroRecords":  "Tidak ditemukan data yang sesuai",
          "sInfo":         "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
          "sInfoEmpty":    "Menampilkan 0 sampai 0 dari 0 entri",
          "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
          "sInfoPostFix":  "",
          "sUrl":          "",
          "oPaginate": {
            "sFirst":    "Pertama",
            "sPrevious": "Sebelumnya",
            "sNext":     "Selanjutnya",
            "sLast":     "Terakhir"
          }
      },
      "processing": true,
      "ajax":  `${rooturl}/penandatangan/list`,
      "columns": [
        { "data": null, "defaultContent": '', "className": 'text-center'},
        { "data": "nama", render: esc},
        { "data": "nip", render: esc},
        { "data": "jabatan", render: esc},
        { "data": "pangkat", render: esc},
        { "data": "aktif", "className": 'text-center', render: function (d) {
          return Number(d) ? '<span class="badge badge-success">Aktif</span>' : '<span class="badge badge-secondary">Tidak Aktif</span>';
        }},
        { "data": "penandatangan_id", render: function(id){
          return `
            <div class="w-100-flex" style="justify-content: center;">
              <ul class="list-inline mb-0">
                <li class="list-inline-item"><a href="${rooturl}/manajemen_master/penandatangan/edit/${id}" class="btn btn-warning"><i class="fas fa-edit"></i></a></li>
                <li class="list-inline-item"><button onclick="hapus(${id})" class="btn btn-danger"><i class="fas fa-trash"></i></button></li>
              </ul>
            </div>`
        }},
      ],
      "columnDefs": [
        { "width": "30px", "targets": 0},
        { "width": "100px", "targets": 6}
      ],
    });

    data_table.on( 'draw.dt', function () {
      let PageInfo = $('#list-data').DataTable().page.info();
      data_table.column(0, { page: 'current' }).nodes().each( function (cell, i) {
        cell.innerHTML = i + 1 + PageInfo.start;
      });
    });

    async function hapus(id) {
      const willDelete = await swal({
        title: "Hapus Data",
        text: "Apakah anda akan menghapus data ini? Dokumen yang sudah dicetak tidak berubah.",
        icon: "warning",
        dangerMode: true,
        buttons: ["Tidak", "Ya"],
      });

      if ( willDelete) {
        $.post(rooturl+"/penandatangan/hapus/"+id).then(function () {
          swal({title:text_delete.title,text:text_delete.text, icon: text_delete.icon, type:text_delete.type})
          data_table.ajax.reload();
        }, function (xhr) {
          swal('Gagal', (xhr.responseJSON && xhr.responseJSON.message) || text_error.text, 'error');
        })
      }
    }
</script>
