<script type="text/javascript">
  var rooturl = ''

  async function submit() {
    const will_insert = await swal({
      title: "Tambah Data",
      text: "Apakah anda akan menambahkan data ini?",
      icon: "warning",
      dangerMode: true,
      buttons: ["Tidak", "Ya"],
    });
    if (!will_insert) return;

    $('#button_submit button').prop('disabled', true);
    // nama kolom db
    let data = {};
    ['nama', 'nip', 'jabatan', 'pangkat', 'aktif'].forEach(function (k) { data[k] = $('#' + k).val(); });

    $.ajax({
      type: 'POST',
      url: rooturl + '/penandatangan/insert',
      contentType: 'application/json',
      data: JSON.stringify(data),
      success: function () {
        swal({title:text_insert.title,text:text_insert.text, icon: text_insert.icon, type:text_insert.type}).then(function () {
          window.location.href = rooturl + '/manajemen_master/penandatangan';
        });
      },
      error: function (xhr) {
        $('#button_submit button').prop('disabled', false);
        swal('Gagal', (xhr.responseJSON && xhr.responseJSON.message) || text_error.text, 'error');
      }
    });
  }
</script>
