<% var REKLAME = typeof jenis !== 'undefined' && jenis && jenis.kode === 'reklame'; var OBJEK = REKLAME ? 'Reklame' : 'Bangunan dan Jaringan Utilitas'; %><%
  // Data dari tahapan.getDataCetak(): permohonan, ruas, total, konfig, persetujuan, perjanjian_sewa
  var BULAN = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
  var HARI = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
  var SATUAN = ['', 'satu', 'dua', 'tiga', 'empat', 'lima', 'enam', 'tujuh', 'delapan', 'sembilan', 'sepuluh', 'sebelas'];
  function terbilang(n) {
    n = Math.floor(Math.abs(Number(n) || 0));
    if (n < 12) return SATUAN[n];
    if (n < 20) return terbilang(n - 10) + ' belas';
    if (n < 100) return terbilang(Math.floor(n / 10)) + ' puluh ' + terbilang(n % 10);
    if (n < 200) return 'seratus ' + terbilang(n - 100);
    if (n < 1000) return terbilang(Math.floor(n / 100)) + ' ratus ' + terbilang(n % 100);
    if (n < 2000) return 'seribu ' + terbilang(n - 1000);
    if (n < 1000000) return terbilang(Math.floor(n / 1000)) + ' ribu ' + terbilang(n % 1000);
    if (n < 1000000000) return terbilang(Math.floor(n / 1000000)) + ' juta ' + terbilang(n % 1000000);
    return terbilang(Math.floor(n / 1000000000)) + ' miliar ' + terbilang(n % 1000000000);
  }
  function rapi(t) { return String(t).replace(/\s+/g, ' ').trim(); }
  function kapital(t) { t = rapi(t); return t.charAt(0).toUpperCase() + t.slice(1); }
  function judulKata(t) { return rapi(t).toLowerCase().replace(/(^|\s)\S/g, function (c) { return c.toUpperCase(); }); }
  function dua(n) { return (n < 10 ? '0' : '') + n; }
  function angka(n, desimal) {
    var x = Number(n || 0).toFixed(desimal || 0).split('.');
    return x[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.') + (x[1] && Number(x[1]) ? ',' + x[1] : '');
  }
  function esc(t) {
    return String(t == null ? '' : t).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  var p = permohonan, k = konfig, ps = perjanjian_sewa;
  var titik = '..............................';
  // Nilai yang tidak tersedia di data permohonan (jaminan, polis, masa berlaku) diisi manual setelah dicetak
  var isian = '.........................';
  var perusahaan = p.perusahaan || {};
  var namaPerusahaan = perusahaan.nama_perusahaan || p.provider || (p.vendor ? (p.vendor.fullname || p.vendor.username) : '') || titik;
  var jabatanTtd = judulKata(k.jabatan_ttd || '');
  var tgl = ps.tanggal_perjanjian ? new Date(ps.tanggal_perjanjian) : null;
  // "Pada hari ini Kamis tanggal Sembilan bulan April tahun dua ribu dua puluh enam (09-04-2026)"
  var kalimatTanggal = tgl
    ? 'Pada hari ini ' + HARI[tgl.getDay()] + ' tanggal ' + kapital(terbilang(tgl.getDate())) + ' bulan ' + BULAN[tgl.getMonth()] +
      ' tahun ' + rapi(terbilang(tgl.getFullYear())) + ' (' + dua(tgl.getDate()) + '-' + dua(tgl.getMonth() + 1) + '-' + tgl.getFullYear() + ')'
    : 'Pada hari ini ' + titik + ' tanggal ' + titik + ' bulan ' + titik + ' tahun ' + titik;
  // Reklame tanpa retribusi terhitung: nilai sewa diisi manual setelah dicetak
  var totalRp = REKLAME ? 'Rp ' + isian : 'Rp ' + angka(total.retribusi) + ',-';
  var totalKata = REKLAME ? isian : kapital(judulKata(total.terbilang || ''));

  // No. ruas "33.76.758" -> 3 kolom seperti format perjanjian; selain itu digabung 1 sel
  function selNoRuas(no) {
    var b = String(no || '').split(/[^0-9A-Za-z]+/).filter(Boolean);
    if (b.length === 3) return b.map(function (x) { return '<td class="c">' + esc(x) + '</td>'; }).join('');
    return '<td class="c" colspan="3">' + esc(no || '-') + '</td>';
  }
  // Panjang ruas tersimpan dalam Km, perjanjian memakai meter
  function panjangMeter(r) { return r.panjang != null && r.panjang !== '' ? angka(Number(r.panjang) * 1000) : '-'; }

  // Isian CKEditor (Pasal 5 s.d. Pasal 10) boleh memakai penanda berikut, diganti dengan data permohonan
  var PENANDA = {
    '[NO_PERJANJIAN]': esc(ps.no_perjanjian || titik),
    '[TANGGAL_PERJANJIAN]': esc(tgl ? tgl.getDate() + ' ' + BULAN[tgl.getMonth()] + ' ' + tgl.getFullYear() : titik),
    '[TOTAL_RETRIBUSI]': esc(totalRp),
    '[TERBILANG_RETRIBUSI]': esc(totalKata),
    '[NAMA_PERUSAHAAN]': esc(namaPerusahaan),
    '[ALAMAT_PERUSAHAAN]': esc(perusahaan.alamat || titik),
    '[TELP_PERUSAHAAN]': esc(perusahaan.no_telepon || p.telp_pemohon || '-'),
    '[EMAIL_PERUSAHAAN]': esc(perusahaan.email || p.email_pemohon || '-'),
    '[NAMA_PEMOHON]': esc(p.nama_pemohon || titik),
    '[JABATAN_PEMOHON]': esc(p.jabatan_pemohon || titik),
    '[NAMA_PENANDATANGAN]': esc(k.nama_ttd),
    '[JABATAN_PENANDATANGAN]': esc(jabatanTtd),
    '[NIP_PENANDATANGAN]': esc(k.nip_ttd)
  };
  var isi = ps.isi || '';
  Object.keys(PENANDA).forEach(function (kunci) { isi = isi.split(kunci).join(PENANDA[kunci]); });
  var adaIsi = rapi(isi.replace(/<[^>]*>|&nbsp;/g, ' ')) !== '';
%>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Perjanjian Kerjasama <%= ps.no_perjanjian %></title>
  <style>
    @page {
      size: A4; margin: 15mm 20mm 20mm 25mm;
      @bottom-right { content: counter(page) " / " counter(pages); font-family: Arial, Helvetica, sans-serif; font-size: 9pt; font-weight: bold; }
    }
    * { box-sizing: border-box; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 11pt; color: #000; margin: 0; background: #e5e5e5; }
    .kertas { width: 210mm; min-height: 297mm; margin: 10mm auto; padding: 15mm 20mm 20mm 25mm; background: #fff; box-shadow: 0 0 6px rgba(0,0,0,.2); }

    .kop { display: flex; align-items: center; padding-bottom: 6px; border-bottom: 4px double #000; }
    .kop img { width: 80px; height: auto; margin-right: 10px; }
    .kop .teks { flex: 1; text-align: center; line-height: 1.3; }
    .kop .pemerintah { font-size: 15pt; }
    .kop .instansi { font-size: 16pt; font-weight: bold; }
    .kop .alamat { font-size: 11pt; }

    .tengah { text-align: center; line-height: 1.45; }
    .blok-judul { margin: 30px 0 22px; }
    .blok-antara { margin: 0 0 22px; }
    .blok-tentang { margin: 0 0 26px; }

    p { margin: 6px 0; text-align: justify; line-height: 1.5; }
    li { text-align: justify; line-height: 1.5; }

    /* Judul BAB / Bagian / Pasal */
    .bab { text-align: center; margin: 26px 0 14px; line-height: 1.45; page-break-after: avoid; }
    .bagian { text-align: center; margin: 18px 0 10px; line-height: 1.45; page-break-after: avoid; }
    .pasal { text-align: center; margin: 16px 0 8px; page-break-after: avoid; }

    /* Penomoran daftar: 1. | a. | (1). */
    ol.angka, ol.huruf, ol.ayat { list-style: none; margin: 4px 0; padding-left: 0; }
    ol.angka { counter-reset: n; } ol.huruf { counter-reset: h; } ol.ayat { counter-reset: a; }
    ol.angka > li, ol.huruf > li, ol.ayat > li { position: relative; padding-left: 34px; margin-bottom: 2px; }
    ol.angka > li { counter-increment: n; } ol.huruf > li { counter-increment: h; } ol.ayat > li { counter-increment: a; }
    ol.angka > li::before { content: counter(n) "."; position: absolute; left: 4px; }
    ol.huruf > li::before { content: counter(h, lower-alpha) "."; position: absolute; left: 4px; }
    ol.ayat > li::before { content: "(" counter(a) ")."; position: absolute; left: 0; }
    ol.pihak > li { margin-bottom: 14px; }

    table.ruas { width: 100%; border-collapse: collapse; margin: 8px 0 12px; }
    table.ruas th, table.ruas td { border: 1px solid #000; padding: 5px 6px; vertical-align: middle; }
    table.ruas th { text-align: center; font-weight: bold; }
    .c { text-align: center; }

    table.kontak { margin: 2px 0 6px 0; border-collapse: collapse; }
    table.kontak td { padding: 0 6px 0 0; vertical-align: top; line-height: 1.5; }
    table.kontak td:first-child { width: 80px; }

    /* Isian CKEditor: Pasal 5 s.d. Pasal 10 */
    .isi { line-height: 1.5; text-align: justify; }
    .isi p { margin: 6px 0; }
    .isi ol, .isi ul { margin: 4px 0; padding-left: 28px; }
    .isi table { border-collapse: collapse; }
    .catatan { border: 1px dashed #c00; color: #c00; padding: 8px 10px; margin: 12px 0; font-size: 10pt; }

    .ttd { display: flex; justify-content: space-between; margin-top: 28px; text-align: center; line-height: 1.4; page-break-inside: avoid; }
    .ttd > div { width: 46%; }
    .ttd .ruang { height: 90px; }
    .ttd .nama { text-decoration: underline; }
    .ttd .materai { display: inline-block; font-size: 8pt; color: #999; border: 1px dashed #bbb; padding: 14px 8px; margin: 6px 0; }

    .aksi { text-align: center; margin: 10px 0 0; }
    .aksi button { font-size: 12pt; padding: 8px 24px; cursor: pointer; }
    @media print {
      body { background: #fff; }
      .kertas { width: auto; min-height: 0; margin: 0; padding: 0; box-shadow: none; }
      .aksi, .catatan, .ttd .materai { display: none; }
      .ttd .ruang { height: 100px; }
    }
  </style>
</head>
<body>
  <div class="aksi">
    <button type="button" onclick="window.print()">Cetak / Simpan PDF</button>
  </div>

  <div class="kertas">
    <div class="kop">
      <img src="<%= k.logo %>" alt="" onerror="this.style.display='none'">
      <div class="teks">
        <div class="pemerintah"><%= k.pemerintah %></div>
        <div class="instansi"><%= k.instansi %></div>
        <div class="alamat"><%= k.alamat %></div>
        <div class="alamat"><%= k.kontak %></div>
      </div>
    </div>

    <div class="tengah blok-judul">
      <div>PERJANJIAN KERJASAMA</div>
      <div>PEMANFAATAN RUANG MILIK JALAN KOTA</div>
      <div>Nomor : <%= ps.no_perjanjian || titik %></div>
    </div>

    <div class="tengah blok-antara">
      <div style="margin-bottom: 22px;">ANTARA</div>
      <div><%= k.instansi %> KOTA TEGAL</div>
      <div>DENGAN</div>
      <div><%= String(namaPerusahaan).toUpperCase() %></div>
    </div>

    <div class="tengah blok-tentang">
      <div>TENTANG</div>
      <div>PEMANFAATAN RUANG MILIK JALAN KOTA</div>
      <div>DI KOTA TEGAL</div>
      <div>UNTUK PEMBANGUNAN/PENEMPATAN <%= OBJEK.toUpperCase() %></div>
    </div>

    <p><%= kalimatTanggal %>, kami yang bertandatangan di bawah ini :</p>

    <ol class="angka pihak">
      <li>
        <b><%= k.nama_ttd %></b> selaku <%= jabatanTtd %>, yang berkedudukan di Jalan Proklamasi No. 11 Tegal.<br>
        Untuk selanjutnya dalam Perjanjian ini disebut sebagai <b>Pihak Kesatu.</b>
      </li>
      <li>
        <b><%= p.nama_pemohon || titik %></b> selaku <%= p.jabatan_pemohon || titik %> <%= namaPerusahaan %>
        berkedudukan di <%= perusahaan.alamat || titik %><br>
        Untuk selanjutnya dalam Perjanjian ini disebut sebagai <b>Pihak Kedua</b>.
      </li>
    </ol>

    <p>Selanjutnya Pihak Kesatu dan Pihak Kedua secara bersama-sama disebut sebagai Para Pihak dan secara sendiri-sendiri disebut sebagai Pihak.</p>

    <p style="margin-top: 14px;">Para Pihak dalam kedudukan tersebut di atas terlebih dahulu menerangkan hal-hal yang menjadi dasar dibuatkannya Perjanjian ini sebagai berikut :</p>
    <ol class="angka">
      <li>Bahwa Pihak Kesatu merupakan Organisasi Perangkat Daerah dari Pemerintah Kota Tegal c.q. Dinas Pekerjaan Umum dan Penataan Ruang Kota Tegal yang memiliki wewenang untuk menatausahakan Barang Milik Daerah serta memberikan pertimbangan teknis Pemanfaatan Ruang Milik Jalan.</li>
      <li>Bahwa Pihak Kedua merupakan badan hukum yang bergerak di bidang infrastruktur dan jaringan telekomunikasi yang menyediakan layanan telekomunikasi bermaksud untuk memanfaatkan Ruang Milik Jalan Kota yang merupakan Barang Milik Daerah.</li>
      <li>Bahwa Pihak Kedua telah mengajukan permohonan Pemanfaatan Ruang Milik Jalan dimaksud kepada Pihak Kesatu, dan Pihak Kesatu telah memeriksa persyaratan administrasi dan teknis permohonan Pihak Kedua.</li>
      <li>Bahwa untuk mewujudkan maksudnya tersebut, Para Pihak sepakat untuk membuat perjanjian kerjasama Pemanfaatan Ruang Milik Jalan Kota</li>
    </ol>
    <p>Dengan memperhatikan peraturan perundang-undangan dan korespondensi sebagai berikut :</p>
    <ol class="huruf">
      <li>Undang – Undang Nomor 2 Tahun 2022 tentang Perubahan Kedua atas Undang – Undang Nomor 38 Tahun 2004 tentang Jalan;</li>
      <li>Peraturan Pemerintah Nomor 34 Tahun 2006 tentang Jalan;</li>
      <li>Peraturan Pemerintah Nomor 28 Tahun 2020 tentang Perubahan Atas Peraturan Pemerintah Nomor 27 Tahun 2014 tentang Pengelolaan Barang Milik Negara/Daerah;</li>
      <li>Peraturan Menteri Pekerjaan Umum Nomor 20/PRT/M/2010 tentang Pedoman Pemanfaatan dan Penggunaan Bagian-Bagian Jalan;</li>
      <li>Peraturan Daerah Kota Tegal No 4 Tahun 2025 tentang Perubahan atas Peraturan Daerah No 1 Tahun 2024 tentang Pajak Daerah dan Retribusi Daerah;</li>
      <li>Peraturan Wali Kota Tegal Nomor 11 Tahun 2024 tentang Tata Cara Pelaksanaan Pemungutan Retribusi Pemanfaatan Aset Daerah;</li>
      <li>Keputusan Walikota Tegal Nomor 600/055/2023 tentang Penetapan Ruas Jalan Menurut Statusnya Sebagai Jalan Kota di Kota Tegal;</li>
      <li>Jaminan Pelaksanaan sebesar Rp. <%= isian %> (<%= isian %>) yang berlaku mulai tanggal <%= isian %> sampai dengan <%= isian %>;</li>
      <li>Jaminan Pemeliharaan sebesar Rp. <%= isian %> (<%= isian %>) yang berlaku mulai tanggal <%= isian %> sampai dengan <%= isian %>;</li>
      <li>Asuransi kerugian pihak ketiga (Polis Asuransi <i>Public Liability</i>), dengan nilai pertanggungan sebesar Rp. <%= isian %> (<%= isian %>) per ruas jalan, yang berlaku mulai tanggal <%= isian %> sampai dengan <%= isian %>.</li>
    </ol>
    <p>Berdasarkan hal-hal yang telah diuraikan di atas, Para Pihak sepakat untuk mengikatkan diri dalam suatu Perjanjian Kerjasama Pemanfaatan Ruang Milik Jalan (selanjutnya disebut sebagai Perjanjian) dengan syarat-syarat dan ketentuan-ketentuan sebagai berikut :</p>

    <!-- ================= BAB I ================= -->
    <div class="bab">BAB I<br>KETENTUAN UMUM</div>
    <div class="bagian">Bagian Kesatu<br>Definisi</div>

    <div class="pasal">Pasal 1</div>
    <p>Dalam Perjanjian ini yang dimaksud dengan :</p>
    <ol class="angka">
      <li>Pihak Kesatu adalah instansi yang memiliki dan/atau menguasai objek perjanjian.</li>
      <li>Pihak Kedua adalah pihak yang memanfaatkan objek perjanjian untuk Pembangunan/Penempatan <%= OBJEK %>.</li>
      <li>Tanah adalah Barang Milik Daerah yang dimiliki, dikuasai dan dicatat sebagai aset Dinas Pekerjaan Umum dan Penataan Ruang yang berada dalam penatausahaan Pihak Kesatu serta menjadi objek Perjanjian.</li>
      <li>Wakil Pihak Kesatu adalah unsur dari Dinas Pekerjaan Umum dan Penataan Ruang Kota Tegal.</li>
      <li>Hari adalah hari kalender sesuai dengan kalender Gregorius, termasuk hari Sabtu dan Minggu serta hari libur nasional yang berawal dan berakhir pada tengah malam pukul 00.00 WIB.</li>
      <li>Jaminan Pelaksanaan adalah penanggungan resiko atau kerugian terhadap Pihak Kesatu berupa Bank Garansi untuk menjamin pelaksanaan kewajiban Pihak Kedua selama masa Pelaksanaan pekerjaan Pembangunan/Penempatan <%= OBJEK %>.</li>
      <li>Jaminan Pemeliharaan adalah penanggungan resiko atau kerugian terhadap Pihak Kesatu untuk menjamin pelaksanaan kewajiban Pihak Kedua selama masa berlakunya Perjanjian atas hasil pekerjaan Pembangunan/Penempatan <%= OBJEK %>.</li>
      <li>Asuransi Kerugian Pihak Ketiga adalah penanggungan resiko atau kerugian terhadap selain Para Pihak berupa Polis Asuransi selama masa berlakunya Perjanjian atas hasil pekerjaan Pembangunan/Penempatan <%= OBJEK %>.</li>
    </ol>

    <div class="bagian">Bagian Kedua<br>Maksud dan Tujuan</div>
    <div class="pasal">Pasal 2</div>
    <ol class="ayat">
      <li>Perjanjian ini dimaksudkan sebagai dasar hukum bagi Para Pihak pada kegiatan Pemanfaatan barang milik Daerah berupa Ruang Milik Jalan Kota dalam penatausahaan Pihak Kesatu.</li>
      <li>Perjanjian ini bertujuan untuk mengatur tugas dan tanggung jawab Para Pihak dalam kegiatan Pemanfaatan barang milik daerah berupa Ruang Milik Jalan Kota untuk Pembangunan/Penempatan <%= OBJEK %> Pihak Kedua.</li>
    </ol>

    <div class="bagian">Bagian Ketiga<br>Ruang Lingkup</div>
    <div class="pasal">Pasal 3</div>
    <p>Ruang lingkup Perjanjian ini adalah :</p>
    <ol class="angka">
      <li>Pemanfaatan barang milik daerah berupa Ruang Milik Jalan Kota dalam penatausahaan Pihak Kesatu untuk Pembangunan/Penempatan <%= OBJEK %> Pihak Kedua.</li>
      <li>Pelaksanaan dan pengawasan pekerjaan, pemeliharaan, serta pembongkaran <%= OBJEK %>, pembiayaan, biaya retribusi, jaminan dan asuransi.</li>
    </ol>

    <!-- ================= BAB II ================= -->
    <div class="bab">BAB II<br>PELAKSANAAN</div>
    <div class="bagian">Bagian Kesatu<br>Objek Perjanjian</div>
    <div class="pasal">Pasal 4</div>
    <p>Tanah yang menjadi objek dalam Perjanjian ini berupa Ruang Milik Jalan Kota pada ruas :</p>
    <table class="ruas">
      <thead>
        <tr>
          <th style="width: 40px;">No</th>
          <th>Nama Ruas Jalan</th>
          <th colspan="3">No. Ruas Jalan</th>
          <th style="width: 110px;">Panjang Jalan (meter)</th>
          <th style="width: 130px;">Keterangan</th>
        </tr>
      </thead>
      <tbody>
        <% ruas.forEach(function (r, i) { %>
        <tr>
          <td class="c"><%= i + 1 %></td>
          <td><%= r.label_ruas %></td>
          <%- selNoRuas(r.no) %>
          <td class="c"><%= panjangMeter(r) %></td>
          <td></td>
        </tr>
        <% }) %>
      </tbody>
    </table>

    <% /* Pasal 5 s.d. Pasal 10 = HTML CKEditor isian administrator (penanda sudah diganti data) */ %>
    <% if (adaIsi) { %>
    <div class="isi"><%- isi %></div>
    <% } else { %>
    <div class="catatan">Pasal 5 s.d. Pasal 10 belum diisi. Lengkapi melalui isian "Ketentuan Perjanjian Sewa" pada draft perjanjian sewa. (Catatan ini tidak ikut tercetak)</div>
    <% } %>

    <div class="pasal">Pasal 11</div>
    <ol class="ayat">
      <li>Pihak Kesatu dapat meminta kembali Tanah, apabila dibutuhkan untuk kepentingan dinas walaupun jangka waktu Perjanjian belum berakhir sebagaimana dimaksud dalam Pasal 19 Perjanjian ini.</li>
      <li>Pihak Kedua akan mengembalikan Tanah kepada Pihak Kesatu sebagaimana dimaksud pada ayat (1) dalam keadaan baik tanpa pengembalian sebagian atau seluruh biaya retribusi yang telah dibayarkan.</li>
      <li>Pihak Kedua menanggung seluruh biaya pembongkaran, pemindahan dan pengembalian kondisi Tanah dan saluran seperti semula.</li>
      <li>Pengembalian kondisi Tanah sebagaimana dimaksud pada ayat (3), dilaksanakan dengan memenuhi Surat Edaran Direktorat Jenderal Bina Marga Nomor 07/SE/Db/2025 tentang Spesifikasi Umum 2025 Untuk Pekerjaan Konstruksi Jalan dan Jembatan.</li>
    </ol>

    <div class="pasal">Pasal 12</div>
    <ol class="ayat">
      <li>Dalam hal Perjanjian ini telah berakhir atau diakhiri oleh Para Pihak, maka Pihak Kedua wajib membongkar <%= OBJEK %> miliknya serta mengembalikan kondisi Tanah ruang milik jalan kota seperti semula.</li>
      <li>Dalam hal Pihak Kedua tidak melakukan pembongkaran sebagaimana dimaksud pada ayat (1), Pihak Kesatu dapat melakukan pembongkaran dan pengembalian kondisi tanah seperti semula.</li>
      <li>Dalam hal pembongkaran dilakukan oleh Pihak Kesatu sebagaimana dimaksud pada ayat (2), Pihak Kesatu dapat menyimpan atau mengembalikan <%= OBJEK %> kepada Pihak Kedua.</li>
    </ol>

    <div class="bagian">Bagian Ketiga<br>Hak dan Kewajiban Para Pihak</div>
    <div class="pasal">Pasal 13</div>
    <p>Dalam Perjanjian ini, Pihak Kesatu memiliki Hak dan Kewajiban sebagai berikut :</p>
    <ol class="angka">
      <li>Memperbolehkan Pihak Kedua untuk memanfaatkan ruang milik jalan kota sebagaimana dimaksud pada Pasal 4 untuk Pembangunan/Penempatan <%= OBJEK %>.</li>
      <li>Melakukan pengawasan terhadap pelaksanaan pekerjaan, pemeliharaan, pembongkaran dan/atau pemindahan <%= OBJEK %> serta pengembalian kondisi Tanah seperti semula.</li>
      <li>Memberikan persetujuan atau arahan kepada Pihak Kedua terhadap pelaksanaan pekerjaan, pemeliharaan, pembongkaran dan/atau pemindahan <%= OBJEK %> serta pengembalian kondisi Tanah seperti semula.</li>
      <li>Menyampaikan perhitungan atau penetapan biaya retribusi atas tanah objek perjanjian serta melakukan penagihan kepada Pihak Kedua.</li>
    </ol>

    <div class="pasal">Pasal 14</div>
    <p>Dalam Perjanjian ini, Pihak Kedua memiliki Hak dan Kewajiban sebagai berikut :</p>
    <ol class="angka">
      <li>Memanfaatkan ruang milik jalan kota sebagaimana dimaksud dalam Pasal 6 untuk Pembangunan/Penempatan <%= OBJEK %> selama jangka waktu Perjanjian ini.</li>
      <li>Membayar biaya retribusi sebagaimana dimaksud dalam Pasal 21, di muka, secara penuh dan sekaligus ke kas daerah.</li>
      <li>Mengembalikan tanah dalam kondisi baik kepada Pihak Kesatu selambat-lambatnya 30 (tiga puluh) hari setelah berakhirnya atau diakhirinya Perjanjian ini.</li>
      <li>Dengan biaya sendiri membongkar, memindahkan, mengembalikan tanah dan memperbaiki fungsi ruang milik jalan kota sebagaimana dimaksud dalam Pasal 4 dalam kondisi baik setelah Perjanjian ini berakhir atau diakhiri oleh Para Pihak.</li>
      <li>Menjaga kondisi dan/atau memperbaiki kerusakan yang mungkin timbul akibat Pembangunan/Penempatan <%= OBJEK %> terhadap ruang milik jalan kota sebagaimana dimaksud dalam Pasal 4 selama jangka waktu Perjanjian ini.</li>
      <li>Tidak mengalihkan Pemanfaatan ruang milik jalan kota sebagaimana dimaksud dalam Pasal 4 kepada pihak lain baik untuk sebagian maupun seluruhnya.</li>
    </ol>

    <div class="pasal">Pasal 15</div>
    <p>Pengembalian dan/atau penyerahan tanah dari Pihak Kedua kepada Pihak Kesatu sebagaimana dimaksud dalam Pasal 11 dan Pasal 14, dilakukan dengan Berita Acara Serah Terima (BAST) yang ditandatangani oleh Para Pihak dan menjadi satu kesatuan yang tidak terpisahkan dari Perjanjian ini.</p>

    <div class="pasal">Pasal 16</div>
    <p>Para Pihak tetap akan memenuhi Hak dan Kewajibannya yang tercantum dalam Perjanjian ini, walaupun Perjanjian telah berakhir atau diakhiri sebelum jangka waktunya berakhir.</p>

    <div class="bagian">Bagian Keempat<br>Perubahan, Jangka Waktu dan Berakhirnya Perjanjian</div>
    <div class="pasal">Pasal 17</div>
    <p>Para Pihak dapat merubah, mengakhiri, atau menambah jangka waktu berlakunya Perjanjian ini berdasarkan persetujuan Para Pihak yang dituangkan dalam adendum.</p>

    <div class="pasal">Pasal 18</div>
    <ol class="ayat">
      <li>Perjanjian ini berlaku terhitung sejak ditandatangani oleh Para Pihak, sampai dengan tanggal <%= isian %>;</li>
      <li>Perjanjian ini dengan sendirinya tidak berlaku setelah jangka waktunya berakhir dan tidak diperpanjang masa berlakunya oleh Para Pihak.</li>
      <li>Jangka waktu berlakunya Perjanjian ini dapat diperpanjang berdasarkan persetujuan Para Pihak, dengan terlebih dahulu Pihak yang bermaksud memperpanjang mengajukan permohonan kepada Pihak lainnya paling lambat 45 (empat puluh lima) hari sebelum berakhir jangka waktunya.</li>
      <li>Perjanjian ini dapat diakhiri sebelum jangka waktunya berakhir sebagaimana dimaksud pada ayat (1) berdasarkan kesepakatan Para Pihak, sebagaimana dimaksud dalam Pasal 19.</li>
    </ol>

    <div class="pasal">Pasal 19</div>
    <ol class="ayat">
      <li>Perjanjian ini dapat diakhiri sebelum jangka waktunya berakhir berdasarkan persetujuan Para Pihak.</li>
      <li>Pihak yang hendak mengakhiri Perjanjian ini wajib memberitahukan maksudnya tersebut kepada Pihak lainnya selambat-lambatnya 45 (empat puluh lima) hari sebelum pengakhiran Perjanjian ini.</li>
      <li>Pengakhiran Perjanjian sebagaimana dimaksud pada ayat (1), dibuatkan dalam Berita Acara yang ditandatangani Para Pihak dan menjadi satu kesatuan yang tidak terpisahkan dari Perjanjian ini.</li>
    </ol>

    <div class="pasal">Pasal 20</div>
    <p>Perubahan atau hal-hal yang belum diatur dalam Perjanjian ini akan diatur kemudian oleh Para Pihak dalam suatu adendum yang merupakan bagian tidak terpisahkan dari Perjanjian ini.</p>

    <!-- ================= BAB III ================= -->
    <div class="bab">BAB III<br>PEMBIAYAAN</div>
    <div class="bagian">Bagian Kesatu<br>Biaya Retribusi Pemanfaatan Barang Milik Daerah</div>
    <div class="pasal">Pasal 21</div>
    <ol class="ayat">
      <li>Biaya retribusi yang ditetapkan atas tanah objek perjanjian sebagaimana dimaksud dalam Pasal 13 adalah sebesar <%= totalRp %> (<%= totalKata %>) yang harus dibayarkan setiap tahun selama berlakunya surat perjanjian ini.</li>
      <li>Biaya retribusi atas pemanfaatan objek dalam perjanjian sebagaimana dimaksud dalam Pasal 4 dikenakan dan dihitung oleh pihak kesatu berdasarkan Peraturan Daerah Kota Tegal No 4 Tahun 2025 tentang Perubahan atas Peraturan Daerah No 1 Tahun 2024 tentang Pajak Daerah dan Retribusi Daerah.</li>
      <li>Pihak Kedua wajib memenuhi dan membayar biaya retribusi Tanah yang ditetapkan sebagaimana dimaksud pada ayat (1).</li>
    </ol>

    <div class="pasal">Pasal 22</div>
    <ol class="ayat">
      <li>Cara pembayaran biaya retribusi menurut Perjanjian ini adalah melalui transaksi transfer/penyetoran ke Rekening Penampungan Pendapatan (RPP) Dinas Pekerjaan Umum dan Penataan Ruang Kota Tegal Bank Jateng No Rekening 1004 01 0431.</li>
      <li>Pembayaran dianggap sah setelah Pihak Kesatu menerima bukti pembayaran yang sah.</li>
    </ol>

    <div class="pasal">Pasal 23</div>
    <ol class="ayat">
      <li>Pembayaran biaya retribusi tanah yang telah ditetapkan dilakukan selambat-lambatnya 28 (dua puluh delapan) hari kerja setelah Pihak Kesatu menyampaikan perhitungan/penetapan dimaksud kepada Pihak Kedua.</li>
      <li>Tidak terpenuhinya pembayaran atas biaya retribusi yang telah ditetapkan sebagaimana dimaksud dalam Pasal 21 oleh Pihak Kedua, secara otomatis mengakibatkan Perjanjian ini batal demi hukum dengan mengesampingkan Pasal 1266 Kitab Undang-Undang Hukum Perdata.</li>
    </ol>

    <div class="bagian">Bagian Kedua<br>Biaya Pelaksanaan, Pemeliharaan, Pembongkaran, Pemindahan<br>dan Pengembalian Kondisi</div>
    <div class="pasal">Pasal 24</div>
    <p>Pihak Kedua menanggung biaya pelaksanaan pekerjaan, pemeliharaan dan perbaikan atas Pembangunan/Penempatan <%= OBJEK %> sebagaimana dimaksud dalam Pasal 8 dan Pasal 10.</p>

    <div class="pasal">Pasal 25</div>
    <p>Pihak Kedua menanggung biaya pembongkaran, pemindahan dan/atau Pembangunan/Penempatan <%= OBJEK %> dan biaya pengembalian kondisi Tanah sebagaimana dimaksud dalam Pasal 11 dan Pasal 14.</p>

    <div class="pasal">Pasal 26</div>
    <ol class="ayat">
      <li>Pihak Kedua menanggung biaya pembongkaran dan/atau penyimpanan <%= OBJEK %> yang dilakukan oleh Pihak Kesatu sebagaimana dimaksud dalam Pasal 12.</li>
      <li>Pihak Kesatu atau Wakil Pihak Kesatu dapat menagihkan biaya pembongkaran dan/atau penyimpanan <%= OBJEK %> sebagaimana dimaksud pada ayat (1) kepada Pihak Kedua.</li>
      <li>Pihak Kesatu dapat mencairkan Jaminan Pemeliharaan sebagaimana dimaksud dalam Pasal 28 sebagai pengganti biaya pembongkaran dan/atau penyimpanan <%= OBJEK %> sebagaimana dimaksud pada ayat (2).</li>
      <li>Selama tagihan biaya pembongkaran dan/atau penyimpanan <%= OBJEK %> belum dibayarkan atau pencairan Jaminan Pemeliharaan belum terlaksana, sebagaimana dimaksud pada ayat (2) dan (3) maka menjadi piutang kas Daerah kepada Pihak Kedua.</li>
    </ol>

    <div class="bagian">Bagian Ketiga<br>Risiko Kerugian</div>
    <div class="pasal">Pasal 27</div>
    <p>Pihak Kedua menanggung seluruh kerugian yang dialami oleh Pihak Kesatu dan/atau pengguna jalan yang diakibatkan oleh kelalaian Pihak Kedua atas Pembangunan/Penempatan <%= OBJEK %> milik Pihak Kedua selama Jangka Waktu Perjanjian.</p>

    <div class="pasal">Pasal 28</div>
    <ol class="ayat">
      <li>Pihak Kedua menyerahkan Jaminan Pelaksanaan kepada Pihak Kesatu berupa Bank Garansi yang diterbitkan oleh <%= isian %>, Nomor : <%= isian %>, tanggal <%= isian %> dengan nilai jaminan Rp <%= isian %> (<%= isian %>).</li>
      <li>Jaminan Pelaksanaan sebagaimana dimaksud pada ayat (1) berlaku sampai dengan tanggal <%= isian %>, dapat diperpanjang jika diperlukan berdasarkan pertimbangan Pihak Kesatu.</li>
    </ol>

    <div class="pasal">Pasal 29</div>
    <ol class="ayat">
      <li>Pihak Kesatu sebagai pihak terjamin, dapat mencairkan Jaminan Pelaksanaan sebagaimana dimaksud dalam Pasal 28, sebagai penggantian atas kerugian yang terjadi akibat Pelaksanaan Pembangunan/Penempatan <%= OBJEK %>.</li>
      <li>Pencairan Jaminan Pelaksanaan sebagaimana dimaksud pada ayat (1), dilakukan jika Pihak Kedua gagal menanggung kerugian yang terjadi setelah diberikan peringatan secara tertulis oleh Pihak Kesatu atau Wakil Pihak Kesatu.</li>
    </ol>

    <div class="pasal">Pasal 30</div>
    <ol class="ayat">
      <li>Pihak Kedua menyerahkan Jaminan Pemeliharaan kepada Pihak Kesatu yang diterbitkan oleh <%= isian %>, Nomor: <%= isian %>, tanggal <%= isian %> dengan nilai jaminan <%= isian %> (<%= isian %>).</li>
      <li>Jaminan Pemeliharaan sebagaimana dimaksud pada ayat (1) berlaku sampai dengan tanggal <%= isian %> dapat diperpanjang jika diperlukan berdasarkan pertimbangan Pihak Kesatu.</li>
    </ol>

    <div class="pasal">Pasal 31</div>
    <ol class="ayat">
      <li>Pihak Kesatu sebagai pihak terjamin, dapat mencairkan Jaminan Pemeliharaan sebagaimana dimaksud dalam Pasal 30, sebagai penggantian atas kerugian yang terjadi akibat Pembangunan/Penempatan <%= OBJEK %> selama jangka waktu Perjanjian.</li>
      <li>Pencairan Jaminan Pemeliharaan sebagaimana dimaksud pada ayat (1), dilakukan jika Pihak Kedua gagal menanggung kerugian yang terjadi setelah diberikan peringatan secara tertulis oleh Pihak Kesatu atau Wakil Pihak Kesatu.</li>
    </ol>

    <div class="pasal">Pasal 32</div>
    <ol class="ayat">
      <li>Pihak Kedua menyerahkan Asuransi Kerugian Pihak Ketiga (Polis Asuransi <i>Public Liability</i>) kepada Pihak Kesatu berupa Polis Asuransi yang diterbitkan oleh <%= isian %> Nomor Polis: <%= isian %> tanggal <%= isian %> dengan nilai pertanggungan Rp. <%= isian %> (<%= isian %>) Per Ruas Jalan.</li>
      <li>Asuransi Kerugian Pihak Ketiga sebagaimana dimaksud pada ayat (1) berlaku mulai tanggal <%= isian %> sampai dengan <%= isian %> dapat diperpanjang jika diperlukan berdasarkan pertimbangan pihak kesatu.</li>
    </ol>

    <div class="pasal">Pasal 33</div>
    <ol class="ayat">
      <li>Pihak Kesatu dapat mengajukan klaim Asuransi Kerugian Pihak Ketiga (Polis Asuransi <i>Public Liability</i>) sebagaimana dimaksud dalam Pasal 32, sebagai penggantian atas kerugian pihak ketiga yang terjadi akibat Pembangunan/Penempatan <%= OBJEK %> selama jangka waktu perjanjian.</li>
      <li>Klaim Asuransi Kerugian Pihak Ketiga (Polis Asuransi <i>Public Liability</i>) sebagaimana dimaksud pada ayat (1), dilakukan jika Pihak Kedua gagal menanggung kerugian pihak ketiga yang terjadi setelah diberikan peringatan oleh Pihak Kesatu atau Wakil Pihak Kesatu.</li>
    </ol>

    <div class="pasal">Pasal 34</div>
    <ol class="ayat">
      <li>Pihak Kedua wajib mempertahankan keberlakuan Jaminan Pelaksanaan, Jaminan Pemeliharaan dan Asuransi Kerugian Pihak Ketiga (Polis Asuransi <i>Public Liability</i>) sebagaimana dimaksud dalam Pasal 28, Pasal 30 dan Pasal 32 selama Jangka Waktu Perjanjian.</li>
      <li>Pihak Kesatu dapat melakukan pemutusan Perjanjian sebagaimana dimaksud dalam Pasal 36, jika Pihak Kedua gagal memenuhi ketentuan sebagaimana pada ayat (1).</li>
    </ol>

    <!-- ================= BAB IV ================= -->
    <% /* Penomoran BAB IV mengikuti contoh perjanjian (dimulai lagi dari Pasal 33) */ %>
    <div class="bab">BAB IV<br>KETENTUAN TAMBAHAN</div>
    <div class="bagian">Bagian Kesatu<br>Keadaan Kahar</div>
    <div class="pasal">Pasal 33</div>
    <p>Para Pihak dibebaskan dari segala kewajiban atau resiko dalam pelaksanaan Perjanjian ini akibat Keadaan Kahar (<i>Force Majeur</i>).</p>

    <div class="pasal">Pasal 34</div>
    <ol class="ayat">
      <li>Dalam Perjanjian ini, yang termasuk Keadaan Kahar adalah :
        <ol class="huruf">
          <li>Bencana alam termasuk akan tetapi tidak terbatas pada gempa bumi, tanah longsor, banjir, badai, dan kebakaran;</li>
          <li>Perang, huru-hara, pemogokan, dan pemberontakan yang berdampak secara langsung terhadap Para Pihak, sehingga berakibat pada tidak dapat terpenuhinya hak dan kewajiban salah satu Pihak.</li>
        </ol>
      </li>
      <li>Keadaan Kahar wajib dinyatakan dan diberitahukan oleh Para Pihak paling lambat 14 (empat belas) hari sejak terjadinya atau patut diketahui terjadinya Keadaan Kahar tersebut.</li>
    </ol>

    <div class="pasal">Pasal 35</div>
    <ol class="ayat">
      <li>Apabila Keadaan Kahar telah berlalu yang dinyatakan oleh Para Pihak, maka hak dan kewajiban Para Pihak berdasarkan Perjanjian ini akan dilaksanakan kembali.</li>
      <li>Apabila Keadaan Kahar terjadi secara menerus yang berakibat pada tidak mungkin terlaksananya hak dan kewajiban, maka Para Pihak berdasarkan kesepakatan dapat mengakhiri berlakunya Perjanjian ini sebagaimana dimaksud dalam Pasal 17.</li>
    </ol>

    <div class="bagian">Bagian Kedua<br>Pemutusan Perjanjian</div>
    <div class="pasal">Pasal 36</div>
    <p>Salah satu Pihak dapat melakukan pemutusan Perjanjian jika Pihak lainnya melakukan cedera janji/wanprestasi.</p>

    <div class="pasal">Pasal 37</div>
    <ol class="ayat">
      <li>Pemutusan Perjanjian dilakukan salah satu Pihak setelah terlebih dahulu memberikan peringatan kepada Pihak lainnya paling sedikit 1 (satu) kali.</li>
      <li>Pihak yang diberi peringatan sebagaimana dimaksud pada ayat (1) memiliki waktu paling lama 14 (empat belas) hari untuk memperbaiki cidera janjinya.</li>
    </ol>

    <div class="pasal">Pasal 38</div>
    <p>Pemutusan dan/atau pengakhiran sebagaimana dimaksud dalam Pasal 34, mengesampingkan keberlakukan Pasal 1266 Kitab Undang-Undang Hukum Perdata.</p>

    <div class="bagian">Bagian Ketiga<br>Penyelesaian Perselisihan</div>
    <div class="pasal">Pasal 39</div>
    <p>Perjanjian ini dibuat dan tunduk pada Hukum Negara Republik Indonesia. Segala interprestasi terhadap Perjanjian ini ditafsirkan menurut Hukum Negara Republik Indonesia.</p>

    <div class="pasal">Pasal 40</div>
    <ol class="ayat">
      <li>Segala perselisihan atau perbedaan pendapat yang timbul sebagai akibat dari pelaksanaan Perjanjian ini, akan diselesaikan secara musyawarah untuk mufakat oleh Para Pihak.</li>
      <li>Musyawarah untuk mufakat sebagaimana dimaksud pada ayat (1) diselesaikan paling lambat 14 (empat belas) hari sejak timbulnya perbedaan interprestasi atau perselisihan yang dinyatakan secara tertulis oleh salah satu Pihak.</li>
      <li>Musyawarah untuk mufakat sebagaimana dimaksud pada ayat (1) dapat dilaksanakan dengan melibatkan seorang Mediator yang ditunjuk oleh Para Pihak.</li>
      <li>Hasil musyawarah untuk mufakat sebagaimana dimaksud pada ayat (1) dituangkan dalam Berita Acara yang menjadi bagian tidak terpisahkan dari Perjanjian ini.</li>
    </ol>

    <div class="pasal">Pasal 41</div>
    <p>Dalam hal musyawarah untuk mufakat sebagaimana dimaksud dalam Pasal 40 tidak tercapai, Para Pihak sepakat untuk menyelesaikan perselisihan berdasarkan Hukum Negara Republik Indonesia di Pengadilan Negeri Kota Tegal.</p>

    <!-- ================= BAB V ================= -->
    <div class="bab">BAB V<br>PENUTUP</div>
    <div class="pasal">Pasal 42</div>
    <p>Setiap atau segala bentuk komunikasi dan korespondensi yang sah antara Para Pihak dilakukan dalam Bahasa Indonesia dalam bentuk tertulis atau tidak tertulis, cetak atau elektronik, ditujukan sebagai berikut :</p>
    <ol class="huruf">
      <li>Pihak Pertama<br>
        Ditujukan kepada Kepala Dinas Pekerjaan Umum dan Penataan Ruang Kota Tegal
        <table class="kontak">
          <tr><td>Alamat</td><td>:</td><td>Jalan Proklamasi No. 11 Tegal</td></tr>
          <tr><td>Telp</td><td>:</td><td>(0283) 356353</td></tr>
          <tr><td>Fax</td><td>:</td><td>(0283) 356353</td></tr>
          <tr><td>Email</td><td>:</td><td><i>dpukotategal@gmail.com</i></td></tr>
        </table>
      </li>
      <li>Pihak Kedua<br>
        Ditujukan kepada <%= p.jabatan_pemohon || titik %> <%= namaPerusahaan %>
        <table class="kontak">
          <tr><td>Alamat</td><td>:</td><td><%= perusahaan.alamat || titik %></td></tr>
          <tr><td>Telp</td><td>:</td><td><%= perusahaan.no_telepon || p.telp_pemohon || '-' %></td></tr>
          <tr><td>Fax</td><td>:</td><td>-</td></tr>
          <tr><td>Email</td><td>:</td><td><i><%= perusahaan.email || p.email_pemohon || '-' %></i></td></tr>
        </table>
      </li>
    </ol>

    <div class="pasal">Pasal 43</div>
    <p>Perjanjian ini tetap berlaku hingga jangka waktunya berakhir atau diakhiri sebagaimana dimaksud dalam Pasal 18 dan Pasal 19, walaupun salah satu Pihak dan/atau Wakil Pihak telah berakhir masa jabatannya, meninggal dunia, atau sebab-sebab lain yang diakibatkan adanya perubahan pada organisasi Para Pihak.</p>

    <div class="pasal">Pasal 44</div>
    <p>Pihak Kesatu melalui ketentuan Pasal ini memberikan kuasa kepada Kepala Bidang Bina Marga Dinas Pekerjaan Umum dan Penataan Ruang Kota Tegal sebagai wakil yang sah dari Pihak Kesatu, oleh karenanya berwenang bertindak untuk dan atas nama Pihak Kesatu khusus terhadap pelaksanaan Perjanjian ini.</p>

    <p style="margin-top: 14px;">Demikian Perjanjian Kerjasama ini dibuat dan ditandatangani pada hari, tanggal, bulan dan tahun sebagaimana tersebut pada bagian awal Perjanjian, dalam rangkap 2 (dua) asli masing-masing bermaterai cukup dan memiliki kekuatan hukum yang sama.</p>

    <div class="ttd">
      <div>
        <div>Pihak Kesatu</div>
        <div><%= jabatanTtd %></div>
        <div class="ruang"><span class="materai">Materai</span></div>
        <div class="nama"><%= k.nama_ttd %></div>
        <div>NIP <%= k.nip_ttd %></div>
      </div>
      <div>
        <div>Pihak Kedua</div>
        <div><%= namaPerusahaan %></div>
        <div class="ruang"><span class="materai">Materai</span></div>
        <div class="nama"><%= p.nama_pemohon || titik %></div>
        <div><%= p.jabatan_pemohon || '' %></div>
      </div>
    </div>
  </div>
</body>
</html>
