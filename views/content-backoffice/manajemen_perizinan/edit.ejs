<div class="modal fade" id="modalSyarat" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <form class="modal-content" id="form-syarat" enctype="multipart/form-data">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Syarat Administratif & Teknis</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                                <div class="row mt-3">
                                    <div class="col-12">
                                        <div class="w-100-flex"  style="justify-content: center;padding: 10px 15px;align-items: center;border-top-left-radius: 15px;border-top-right-radius: 15px;background-color: #f7ca18;">
                                            <h6 style="font-size: 20px;font-weight: 600;">Persyaratan Administrasi</h6>
                                            <hr>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-12">
                                        <div class="form-group">
                                            <label for="ktp">Foto copy Kartu Tanda Penduduk (KTP) Pemohon</label>
                                            <div class="custom-file">
                                                <input type="file" class="custom-file-input" id="ktp" name="ktp" accept=".pdf,.jpg,.jpeg,.png">
                                                <label class="custom-file-label" for="ktp">Pilih File</label>
                                            </div>
                                            <small class="form-text dok-info" data-jenis="ktp"></small>
                                        </div>

                                        <hr>

                                        <div class="form-group">
                                            <label for="akta_pendirian">Foto Copy akte pendirian Badan Usaha/Badan Hukum</label>
                                            <div class="custom-file">
                                                <input type="file" class="custom-file-input" id="akta_pendirian" name="akta_pendirian" accept=".pdf,.jpg,.jpeg,.png">
                                                <label class="custom-file-label" for="akta_pendirian">Pilih File</label>
                                            </div>
                                            <small class="form-text dok-info" data-jenis="akta_pendirian"></small>
                                        </div>

                                        <hr>

                                       <div class="form-group">
                                            <label for="surat_kuasa">Surat Kuasa Pengurusan permohonan izin pembangunan/penempatan bangunan dan jaringan utlitas</label>
                                            <div class="custom-file">
                                                <input type="file" class="custom-file-input" id="surat_kuasa" name="surat_kuasa" accept=".pdf,.jpg,.jpeg,.png">
                                                <label class="custom-file-label" for="surat_kuasa">Pilih File</label>
                                            </div>
                                            <small class="form-text text-muted"><i>Dalam hal surat permohonan tidak ditanda tangani oleh penanggungjawab perusahaan</i></small>
                                            <small class="form-text dok-info" data-jenis="surat_kuasa"></small>
                                        </div>

                                        <hr>

                                        <div class="form-group">
                                            <label for="pernyataan_kesanggupan">Surat Pernyataan kesanggupan memenuhi dan mematuhi semua persyaratan yang ditentukan dalam pembangunan/penempatan bangunan dan jaringan utilitas.</label>
                                            <div class="custom-file">
                                                <input type="file" class="custom-file-input" id="pernyataan_kesanggupan" name="pernyataan_kesanggupan" accept=".pdf,.jpg,.jpeg,.png">
                                                <label class="custom-file-label" for="pernyataan_kesanggupan">Pilih File</label>
                                            </div>
                                            <small class="form-text text-muted"><i>Di atas kertas bermaterai sesuai peraturan yang berlaku</i></small>
                                            <small class="form-text dok-info" data-jenis="pernyataan_kesanggupan"></small>
                                        </div>

                                        <hr>

                                        <div class="form-group">
                                            <label for="pernyataan_retribusi">Surat pernyataan kesanggupan pembayaran Retribusi</label>
                                            <div class="custom-file">
                                                <input type="file" class="custom-file-input" id="pernyataan_retribusi" name="pernyataan_retribusi" accept=".pdf,.jpg,.jpeg,.png">
                                                <label class="custom-file-label" for="pernyataan_retribusi">Pilih File</label>
                                            </div>
                                            <small class="form-text dok-info" data-jenis="pernyataan_retribusi"></small>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-12">
                                        <div class="w-100-flex"  style="justify-content: center;padding: 10px 15px;align-items: center;border-top-left-radius: 15px;border-top-right-radius: 15px;background-color: #f7ca18;">
                                            <h6 style="font-size: 20px;font-weight: 600;">Persyaratan Teknis</h6>
                                            <hr>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-12">
                                        <div class="form-group">
                                            <label for="gambar_lokasi">Gambar Lokasi Pembangunan/Penempatan Bangunan dan Jaringan Utilitas</label>
                                            <div class="custom-file">
                                                <input type="file" class="custom-file-input" id="gambar_lokasi" name="gambar_lokasi" accept=".pdf,.jpg,.jpeg,.png">
                                                <label class="custom-file-label" for="gambar_lokasi">Pilih File</label>
                                            </div>
                                            <small class="form-text dok-info" data-jenis="gambar_lokasi"></small>
                                        </div>

                                        <hr>

                                       <div class="form-group">
                                            <label for="rencana_teknis">Rencana Teknis</label>
                                            <div class="custom-file">
                                                <input type="file" class="custom-file-input" id="rencana_teknis" name="rencana_teknis" accept=".pdf,.jpg,.jpeg,.png">
                                                <label class="custom-file-label" for="rencana_teknis">Pilih File</label>
                                            </div>
                                            <small class="form-text text-muted"><i>Gambar Konstruksi dan bahan Konstruksi bangunan dan jaringan utilitas</i></small>
                                            <small class="form-text dok-info" data-jenis="rencana_teknis"></small>
                                        </div>

                                        <hr>

                                        <div class="form-group">
                                            <label for="jadwal_pelaksanaan">Jadwal Pelaksanaan Kegiatan</label>
                                            <div class="custom-file">
                                                <input type="file" class="custom-file-input" id="jadwal_pelaksanaan" name="jadwal_pelaksanaan" accept=".pdf,.jpg,.jpeg,.png">
                                                <label class="custom-file-label" for="jadwal_pelaksanaan">Pilih File</label>
                                            </div>
                                            <small class="form-text dok-info" data-jenis="jadwal_pelaksanaan"></small>
                                        </div>

                                        <hr>

                                        <div class="form-group">
                                            <label for="rencana_anggaran">Rencana Anggaran Biaya</label>
                                            <div class="custom-file">
                                                <input type="file" class="custom-file-input" id="rencana_anggaran" name="rencana_anggaran" accept=".pdf,.jpg,.jpeg,.png">
                                                <label class="custom-file-label" for="rencana_anggaran">Pilih File</label>
                                            </div>
                                            <small class="form-text dok-info" data-jenis="rencana_anggaran"></small>
                                        </div>
                                    </div>
                                </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <small class="text-muted mr-auto"><i>Format PDF / JPG / PNG, maks. 10 MB per file</i></small>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Tutup</button>\
                <button type="submit" class="btn btn-primary">Simpan</button>\
            </div>
            </form>
        </div>
    </div>
<script type="text/javascript">
  var rooturl = ''
  let data_basic = {}
  window.onload =async function (params) {
    await $.get('/api_basic/list?data_basic_id=').then(function (data) {
      data_basic = data.data[0]
      for (const i in data_basic) {
        if (Object.hasOwnProperty.call(data_basic, i)) {
          if (i.substring(0,4)=='foto') {
            if (data_basic[i]) {
              $('#lihat_'+i).append(`<div style="width: 30%;border:2px dashed #6777ef;padding: 5px;margin-top: 15px;border-radius: 0.25rem;"><img src="/foto/${data_basic[i]}" alt="" class="w-100" style="border-radius: 0.25rem;"></div>`)
            }
          }else if(i.substring(i.length-2,i.length)=='id'){
            $('#'+i).val(data_basic[i]).select2()
          }
          // else if (i.substring(0,3)=='ket'){        
          //   CKEDITOR.instances[i].setData(data_basic[i])
          // }
          else{
            $('#'+i).val(data_basic[i])
          }
        }
      }
    })
  }

  async function submit() {
    const will_update = await swal({
      title: "Edit Data",
      text: "Apakah anda akan mengedit data ini?",
      icon: "warning",
      dangerMode: true,
      buttons: ["Tidak", "Ya"],
    });        
    
    if ( will_update) {
      $('#button_submit').empty()
      $('#button_submit').append('<button class="btn btn-primary btn-embossed" disabled>Simpan</button>')
    
      let formData = new FormData();    
      // nama kolom db
      let arr = ['NamaKolomDb1', 'NamaKolomDb2', 'NamaKolomDb3']
    
      formData.append('data_basic_id', data_basic.data_basic_id);

      for (let i = 0; i < arr.length; i++) {
        if (arr[i].substring(0,4)=='foto') {
          if ( $(`#`+arr[i])[0].files[0]){
            formData.append(arr[i], $(`#`+arr[i])[0].files[0]);
          } 
        }
        // else if (arr[i].substring(0,3)=='ket'){        
        //   formData.append(arr[i] ,CKEDITOR.instances[arr[i]].getData())
        // }
        else{
          formData.append(arr[i],$('#'+arr[i]).val())
        }
      }

      $.ajax({
        type: 'POST',
        enctype: 'multipart/form-data',
        url: rooturl+'/api_basic/edit',
        data: formData,
        processData: false,
        contentType: false,
        success: function(data) {
          swal({title:text_edit.title,text:text_edit.text, icon: text_edit.icon, type:text_edit.type})
          window.location.href = rooturl+'/manajemen_basic';
        },error: function(data) {
          swal({title:text_error.title,text:text_error.text, icon: text_error.icon, type:text_error.type})
        }
      })      
    } 
  }
</script>