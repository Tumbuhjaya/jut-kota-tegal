<%
  var BULAN = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
  var HARI = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', "Jum'at", 'Sabtu'];
  function tanggal(t) {
    if (!t) return '-';
    var d = new Date(t);
    return d.getDate() + ' ' + BULAN[d.getMonth()] + ' ' + d.getFullYear();
  }
  function angka(n, desimal) {
    var x = Number(n || 0).toFixed(desimal || 0).split('.');
    return x[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.') + (x[1] && Number(x[1]) ? ',' + x[1] : '');
  }
  var p = permohonan, k = konfig, b = peninjauan;
  var tim = String(b.tim_teknis || '').split(/\r?\n/).map(function (t) { return t.trim(); }).filter(Boolean);
%>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>BA Peninjauan Lapangan <%= b.no_ba %></title>
  <style>
    @page { size: A4; margin: 15mm 15mm 20mm 20mm; }
    * { box-sizing: border-box; }
    body { font-family: "Times New Roman", Times, serif; font-size: 12pt; color: #000; margin: 0; background: #e5e5e5; }
    .kertas { width: 210mm; min-height: 297mm; margin: 10mm auto; padding: 15mm 15mm 20mm 20mm; background: #fff; box-shadow: 0 0 6px rgba(0,0,0,.2); }
    .kop { display: flex; align-items: center; border-bottom: 3px double #000; padding-bottom: 6px; }
    .kop img { width: 75px; height: auto; margin-right: 12px; }
    .kop .teks { flex: 1; text-align: center; line-height: 1.25; }
    .kop .pemerintah { font-size: 14pt; font-weight: bold; }
    .kop .instansi { font-size: 16pt; font-weight: bold; }
    .kop .alamat { font-size: 10pt; }
    .judul { text-align: center; margin: 18px 0 14px; line-height: 1.4; }
    .judul .utama { font-weight: bold; text-decoration: underline; font-size: 13pt; }
    p { margin: 6px 0; text-align: justify; line-height: 1.5; }
    table.data td { padding: 2px 4px; vertical-align: top; }
    table.data td:first-child { width: 190px; }
    table.ruas { width: 100%; border-collapse: collapse; font-size: 10pt; margin: 8px 0; }
    table.ruas th, table.ruas td { border: 1px solid #000; padding: 4px 5px; }
    table.ruas th { background: #f0f0f0; text-align: center; }
    .c { text-align: center; } .r { text-align: right; }
    .hasil { line-height: 1.5; text-align: justify; }
    .foto { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0; }
    .foto div { width: calc(50% - 4px); text-align: center; font-size: 10pt; page-break-inside: avoid; }
    .foto img { width: 100%; height: 200px; object-fit: cover; border: 1px solid #000; }
    .ttd { display: flex; justify-content: space-between; margin-top: 24px; page-break-inside: avoid; }
    .ttd > div { width: 48%; text-align: center; line-height: 1.4; }
    .ttd ol { text-align: left; margin: 6px 0 0 18px; padding: 0; }
    .ttd ol li { margin-bottom: 28px; }
    .ttd .nama { margin-top: 70px; font-weight: bold; text-decoration: underline; }
    .aksi { text-align: center; margin: 10px 0 0; }
    .aksi button { font-size: 12pt; padding: 8px 24px; cursor: pointer; }
    @media print {
      body { background: #fff; }
      .kertas { width: auto; min-height: 0; margin: 0; padding: 0; box-shadow: none; }
      .aksi { display: none; }
    }
  </style>
</head>
<body>
  <div class="aksi">
    <button type="button" onclick="window.print()">Cetak / Simpan PDF</button>
  </div>

  <div class="kertas">
    <div class="kop">
      <img src="<%= k.logo %>" alt="" onerror="this.style.display='none'">
      <div class="teks">
        <div class="pemerintah"><%= k.pemerintah %></div>
        <div class="instansi"><%= k.instansi %></div>
        <div class="alamat"><%= k.alamat %></div>
        <div class="alamat"><%= k.kontak %></div>
      </div>
    </div>

    <div class="judul">
      <div class="utama">BERITA ACARA PENINJAUAN LAPANGAN</div>
      <div><strong>PERMOHONAN IZIN PENEMPATAN JARINGAN UTILITAS</strong></div>
      <div>Nomor : <%= b.no_ba || '-' %></div>
    </div>

    <p>Pada hari ini <strong><%= b.tanggal_ba ? HARI[new Date(b.tanggal_ba).getDay()] : '..........' %></strong>
      tanggal <strong><%= tanggal(b.tanggal_ba) %></strong>, Tim Teknis telah melaksanakan
      peninjauan lapangan atas surat permohonan Nomor <strong><%= b.no_surat_permohonan || '..........' %></strong>
      tanggal <strong><%= tanggal(b.tanggal_surat_permohonan) %></strong> yang diajukan oleh:</p>
    <table class="data">
      <tr><td>Nama Pemohon</td><td>:</td><td><%= p.nama_pemohon || '-' %></td></tr>
      <tr><td>Jabatan</td><td>:</td><td><%= p.jabatan_pemohon || '-' %></td></tr>
      <tr><td>Vendor / Pelaksana</td><td>:</td><td><%= p.vendor ? (p.vendor.fullname || p.vendor.username) : '-' %></td></tr>
      <tr><td>Pemilik Jaringan (Provider)</td><td>:</td><td><%= p.provider || '-' %></td></tr>
    </table>

    <p>dengan lokasi rencana penempatan jaringan utilitas sebagai berikut:</p>
    <table class="ruas">
      <thead>
        <tr>
          <th>No.</th>
          <th>Ruas Jalan</th>
          <th>No. Ruas</th>
          <th>Tiang (Unit)</th>
          <th>Kabel (m)</th>
        </tr>
      </thead>
      <tbody>
        <% ruas.forEach(function (r, i) { %>
        <tr>
          <td class="c"><%= i + 1 %></td>
          <td><%= r.label_ruas %></td>
          <td class="c"><%= r.no || '-' %></td>
          <td class="c"><%= angka(r.jml_t_k30cm) %></td>
          <td class="c"><%= angka(r.panjang_kabel, 2) %></td>
        </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <th colspan="3" class="r">Total</th>
          <th><%= angka(total.tiang) %></th>
          <th><%= angka(total.kabel, 2) %></th>
        </tr>
      </tfoot>
    </table>

    <p><strong>Hasil peninjauan lapangan:</strong></p>
    <% /* hasil = HTML dari CKEditor yang diisi administrator */ %>
    <div class="hasil"><%- b.hasil || '<p>-</p>' %></div>

    <% if (b.foto && b.foto.length) { %>
    <p><strong>Dokumentasi:</strong></p>
    <div class="foto">
      <% b.foto.forEach(function (f) { %>
      <div>
        <img src="/manajemen_perizinan/peninjauan_lapangan/foto/<%= p.permohonan_id %>/<%= f.urutan %>?v=<%= f.permohonan_peninjauan_foto_id %>" alt="">
        Foto <%= f.urutan %>
      </div>
      <% }) %>
    </div>
    <% } %>

    <p>Demikian berita acara ini dibuat untuk dipergunakan sebagaimana mestinya.</p>

    <div class="ttd">
      <div>
        <div>Pemohon,</div>
        <div class="nama"><%= p.nama_pemohon || '.........................................' %></div>
        <div><%= p.jabatan_pemohon || '' %></div>
      </div>
      <div>
        <div><%= k.tempat %>, <%= tanggal(b.tanggal_ba) %></div>
        <div>Tim Teknis,</div>
        <ol>
          <% (tim.length ? tim : ['.........................................']).forEach(function (t) { %>
          <li><%= t %> &nbsp; ....................</li>
          <% }) %>
        </ol>
      </div>
    </div>
  </div>
</body>
</html>
