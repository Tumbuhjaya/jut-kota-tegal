                    <div class="form-group">
                        <label for="">Hasil Peninjauan Lapangan</label>
                        <textarea name="" id="editor1" class="form-control" rows="5"></textarea>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-lg-6 col-xl-6">
                    <div class="form-group">
                        <label for="">Upload Dokumentasi Peninjauan Lapangan</label>
                        <div class="custom-file">
