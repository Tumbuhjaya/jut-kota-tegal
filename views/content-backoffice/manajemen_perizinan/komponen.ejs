<div class="section-body">
  <div class="row">
    <div class="col-12 col-lg-12 col-xl-12">
      <div class="card">
        <div class="card-body">
          <div class="alert alert-primary" role="alert">
            <i class="fas fa-user-shield"></i>&nbsp; Anda mengisi sebagai <strong>admin</strong> atas nama vendor <strong><%= atas_nama %></strong>.
          </div>
          <% if (!bisa_ubah) { %>
          <div class="alert alert-info" role="alert">
            Permohonan berstatus <strong><%= permohonan.status %></strong> dan tidak bisa diubah.
            <% if (permohonan.no_sk) { %><br/>No. SK: <strong><%= permohonan.no_sk %></strong><% } %>
            <% if (permohonan.keterangan) { %><br/>Keterangan: <%= permohonan.keterangan %><% } %>
            <br/><small><i>Untuk mengubah data, proses permohonan menjadi <b>Perlu Revisi</b> terlebih dahulu di halaman detail.</i></small>
          </div>
          <% } else if (permohonan.status === 'revisi') { %>
          <div class="alert alert-warning" role="alert">
            <strong>Perlu revisi:</strong> <%= permohonan.keterangan %>
          </div>
          <% } else if (!bisa_ajukan) { %>
          <div class="alert alert-info" role="alert">
            Permohonan berstatus <strong><%= permohonan.status %></strong>. Perubahan yang disimpan tidak mengubah status permohonan.
          </div>
          <% } %>

          <div class="form-group row">
            <label class="col-sm-2 col-form-label" for="provider_id">Provider</label>
            <div class="col-sm-10">
              <select name="provider_id" id="provider_id" class="form-control" style="width: 100%;" <%= bisa_ubah ? '' : 'disabled' %>>
                <option value="">-- Pilih Provider --</option>
              </select>
            </div>
          </div>

          <hr>

          <div class="form-group row">
            <label class="col-sm-2 col-form-label">Persyaratan Teknis</label>
            <div class="col-sm-10">
              <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#modalSyarat">
                <i class="fas <%= bisa_ubah ? 'fa-plus' : 'fa-eye' %>"></i>&nbsp;<%= bisa_ubah ? 'Upload Dokumen' : 'Lihat Dokumen' %>
              </button>
              <span id="info_dokumen" class="ml-2"></span>
            </div>
          </div>

          <div class="row">
            <div class="col-12">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover table-primary table-sm">
                        <thead>
                            <tr>
                                <th rowspan="3" class="text-center">No.</th>
                                <th rowspan="3" style="min-width: 150px;" class="text-center">Option</th>
                                <th rowspan="3" style="min-width: 250px;" class="text-center">Ruas Jalan</th>
                                <th colspan="3" rowspan="3" class="text-center">Nomor Ruas</th>
                                <th rowspan="2" class="text-center">Panjang SK Jalan</th>
                                <% komponen.forEach(function (k) { %>
                                <th colspan="3" class="text-center"><%= k.label %></th>
                                <% }) %>
                                <th rowspan="3" class="text-center" style="min-width: 180px;">Jumlah Total Retribusi (Rp)</th>
                            </tr>
                            <tr>
                                <% komponen.forEach(function (k) { %>
                                <th class="text-center">Jumlah</th>
                                <th class="text-center">Nilai Retribusi</th>
                                <th class="text-center">Total</th>
                                <% }) %>
                            </tr>
                            <tr>
                                <th class="text-center">Km</th>
                                <% komponen.forEach(function (k) { %>
                                <th class="text-center" style="min-width: 110px;"><%= k.satuan %></th>
                                <th class="text-center" style="min-width: 120px;">Rp/<%= k.satuan %>/Tahun</th>
                                <th class="text-center" style="min-width: 130px;">Rp/Tahun</th>
                                <% }) %>
                            </tr>
                        </thead>
                        <tbody id="tbody_ruas"></tbody>
                        <tfoot>
                            <tr>
                                <th colspan="7" class="text-right">Total</th>
                                <% komponen.forEach(function (k) { %>
                                <th class="text-center" id="total_jml_<%= k.kode %>">0</th>
                                <th></th>
                                <th class="text-right" id="total_ret_<%= k.kode %>">Rp 0,-</th>
                                <% }) %>
                                <th class="text-right" id="total_ret">Rp 0,-</th>
                            </tr>
                        </tfoot>
                    </table>
                    <% if (bisa_ubah) { %>
                    <div class="w-100-flex" style="justify-content: flex-start;flex-wrap: wrap;align-items: flex-start;margin-bottom: 15px;">
                        <button type="button" class="btn btn-warning" onclick="tambahBaris()"><i class="fas fa-plus"></i> &nbsp;&nbsp;Tambah Baris Tabel</button>
                    </div>
                    <small class="text-muted"><i>Ruas jalan yang dikosongkan dianggap <b>di luar ruas</b>. Panjang kabel (Atas Tanah D &le; 15 cm) otomatis mengikuti hasil digitasi jika sudah didigitasi.</i></small>
                    <% } %>
                </div>
            </div>
          </div>

          <div class="row">
            <div class="col-12">
              <hr>
              <div class="w-100-flex" style="justify-content: center;flex-wrap: wrap;gap: 10px;">
                <a href="/manajemen_perizinan" class="btn btn-secondary"><i class="fas fa-arrow-left"></i>&nbsp;&nbsp;Kembali</a>
                <% if (bisa_ubah) { %>
                <button type="button" class="btn btn-primary" style="padding-left: 60px;padding-right: 60px;" onclick="simpan(true)"><i class="fas fa-save"></i>&nbsp;&nbsp;Simpan</button>
                <% } %>
                <% if (bisa_ajukan) { %>
                <button type="button" class="btn btn-warning" onclick="ajukan()"><i class="fas fa-paper-plane"></i>&nbsp;&nbsp;Ajukan Permohonan</button>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
