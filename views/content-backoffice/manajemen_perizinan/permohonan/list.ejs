<% include ../../../template-backoffice/header.ejs %>
  <!-- Main Content -->
  <div class="main-content">
    <section class="section">
      <div class="w-100" style="padding: 0 30px;">
        <div class="section-header">
          <h1>Data Permohonan Izin</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Dashboard</a></div>
            <div class="breadcrumb-item">Data</div>
          </div>
        </div>
      </div>

      <div class="section-body">
        <div class="row">
          <div class="col-lg-12 col-xl-12">
            <div class="card">
              <div class="card-header">
                <!-- <a href="/manajemen_basic/insert" class="btn btn-primary custom-btn-card-header"><i class="fas fa-plus"></i> Tambah Data</a> -->
              </div>
              <div class="card-body">
                <div class="table-responsive">
                  <table class="table table-bordered table-striped table-hover" id="list-data">
                    <thead>                                 
                      <tr>
                        <th class="text-center" rowspan="2">No.</th>
                        <th class="text-center" rowspan="2">Tanggal<br/>Permohonan</th>
                        <th class="text-center" rowspan="2">Pemohon</th>
                        <th class="text-center" rowspan="2">Provider</th>
                        <th class="text-center" colspan="4">Total</th>
                        <th class="text-center" rowspan="2">Status</th>
                        <th class="text-center" rowspan="2">Option</th>
                      </tr>

                      <tr>
                        <th class="text-center">Ruas<br/>Jalan</th>
                        <th class="text-center">Tiang</th>
                        <th class="text-center">Panjang<br/>Kabel (m)</th>
                        <th class="text-center" style="min-width: 130px;">Retribusi (Rp)</th>
                      </tr>
                    </thead>
                    <tbody></tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <footer class="main-footer">
    <div class="footer-left">
      <% include ../../../template-backoffice/copyright-left.ejs %>
    </div>
    <div class="footer-right">
      <% include ../../../template-backoffice/copyright-right.ejs %>
    </div>
  </footer>
<% include ../../../template-backoffice/footer.ejs %>


<script type="text/javascript">
    var rooturl = ''
    var STATUS = {
      diajukan: { label: 'Menunggu Verifikasi', badge: 'warning' },
      revisi:   { label: 'Perlu Revisi', badge: 'danger' }
    };

    function rupiah(n) {
      return 'Rp ' + Number(n || 0).toLocaleString('id-ID', { maximumFractionDigits: 0 }) + ',-';
    }
    function esc(t) {
      return $('<div>').text(t == null || t === '' ? '-' : t).html();
    }

    let data_table  =$('#list-data').DataTable({
      "language": {
          "sProcessing":   "Sedang memproses...",
          "sLengthMenu":   "_MENU_",
          "sZeroRecords":  "Tidak ditemukan data yang sesuai",
          "sInfo":         "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
          "sInfoEmpty":    "Menampilkan 0 sampai 0 dari 0 entri",
          "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
          "sInfoPostFix":  "",
          "sUrl":          "",
          "oPaginate": {
            "sFirst":    "Pertama",
            "sPrevious": "Sebelumnya",
            "sNext":     "Selanjutnya",
            "sLast":     "Terakhir"
          }
      },
      "processing": true,
      "ordering": false,
      "ajax": { url: `${rooturl}/manajemen_perizinan/permohonan/list`, type: 'POST' },
      "columns": [
        { "data": null, "defaultContent": '', "className": 'text-center' },
        { "data": 'diajukanAt', "render": function (d) { return d ? moment(d).format('DD/MM/YYYY HH:mm') : '-'; } },
        { "data": null, "render": function (r) { return esc(r.nama_pemohon)} },
        { "data": 'provider', "render": esc },
        { "data": 'jml_ruas', "className": 'text-center' },
        { "data": 'jml_tiang', "className": 'text-center' },
        { "data": 'jml_kabel', "className": 'text-center', "render": function (d) { return Math.round(Number(d)).toLocaleString('id-ID'); } },
        { "data": 'retribusi', "className": 'text-right', "render": rupiah },
        { "data": 'status', "render": function (d) {
            var s = STATUS[d] || { label: d, badge: 'light' };
            return '<div class="w-100-flex" style="justify-content: center;align-items: center;gap: 5px;"><span class="badge badge-' + s.badge + ' mb-0">' + s.label + '</span></div>';
        } },
        { "data": null, "render": function (r) {
            return '<div class="w-100-flex" style="justify-content: center;gap: 5px;">' +
              '<a href="' + rooturl + '/manajemen_perizinan/permohonan/verifikasi/' + r.permohonan_id + '" class="btn btn-warning" title="Verifikasi Permohonan"><i class="fas fa-tasks"></i></a>' +
              '<button type="button" class="btn btn-danger" title="Hapus" onclick="hapus(' + r.permohonan_id + ')"><i class="fas fa-trash"></i></button>' +
              '</div>';
        } }
      ],
      "columnDefs": [
        { "width": "30px", "targets": 0},
        { "width": "100px", "targets": 9}
      ],
    });

    data_table.on( 'draw.dt', function () {
      let PageInfo = $('#list-data').DataTable().page.info();
      data_table.column(0, { page: 'current' }).nodes().each( function (cell, i) {
        cell.innerHTML = i + 1 + PageInfo.start;
      });
    });

    async function hapus(id) {
      const willDelete = await swal({
        title: "Hapus Data",
        text: "Apakah anda akan menghapus permohonan ini?",
        icon: "warning",
        dangerMode: true,
        buttons: ["Tidak", "Ya"],
      });

      if ( willDelete) {
        $.post(rooturl + "/manajemen_perizinan/permohonan/hapus/" + id)
          .done(function () {
            swal({title:text_delete.title,text:text_delete.text, icon: text_delete.icon, type:text_delete.type})
            data_table.ajax.reload();
          })
          .fail(function (xhr) { swal('Gagal', (xhr.responseJSON && xhr.responseJSON.message) || 'Gagal menghapus data', 'error'); });
      }
    }
</script>
