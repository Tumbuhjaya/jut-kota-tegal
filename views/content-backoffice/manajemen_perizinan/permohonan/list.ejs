<% include ../../../template-backoffice/header.ejs %>
  <!-- Main Content -->
  <div class="main-content">
    <section class="section">
      <div class="w-100" style="padding: 0 30px;">
        <div class="section-header">
          <h1>Data Permohonan Izin</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Dashboard</a></div>
            <div class="breadcrumb-item">Data</div>
          </div>
        </div>
      </div>

      <div class="section-body">
        <div class="row">
          <div class="col-lg-12 col-xl-12">
            <div class="card">
              <div class="card-header">
                <!-- <a href="/manajemen_basic/insert" class="btn btn-primary custom-btn-card-header"><i class="fas fa-plus"></i> Tambah Data</a> -->
              </div>
              <div class="card-body">
                <div class="table-responsive">
                  <table class="table table-bordered table-striped table-hover" id="list-data">
                    <thead>                                 
                      <tr>
                        <th class="text-center" rowspan="2">No.</th>
                        <th class="text-center" rowspan="2">Tanggal Permohonan</th>
                        <th class="text-center" rowspan="2">Pemohon/Vendor</th>
                        <th class="text-center" rowspan="2">Provider</th>
                        <th class="text-center" colspan="4">Total</th>
                        <th class="text-center" rowspan="2">Status</th>
                        <th class="text-center" rowspan="2">Option</th>
                      </tr>

                      <tr>
                        <th class="text-center">Ruas</th>
                        <th class="text-center">Tiang</th>
                        <th class="text-center" style="min-width: 130px;">Panjang Kabel (m)</th>
                        <th class="text-center" style="min-width: 130px;">Retribusi (Rp)</th>
                      </tr>
                    </thead>
                    <tbody>                                 
                      <tr>
                        <td class="text-center">1.</td>
                        <td>00/00/000</td>
                        <td>value pemohon</td>
                        <td>value provider</td>
                        <td class="text-center">00</td>
                        <td class="text-center">00</td>
                        <td class="text-center">00</td>
                        <td class="text-right">Rp 0,-</td>
                        <td>
                            <div class="w-100-flex" style="justify-content: center;align-items: center;gap: 5px;">
                                <span class="badge badge-warning mb-0">Menunggu Verifikasi</span>
                            </div>
                        </td>
                        <td>
                          <div class="w-100-flex" style="justify-content: center;gap: 5px;">
                            <a href="/manajemen_perizinan/permohonan/verifikasi/1" class="btn btn-warning" title="Verifikasi Permohonan"><i class="fas fa-tasks"></i></a>
                             <button class="btn btn-danger"><i class="fas fa-trash"></i></button>
                            
                          </div>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <footer class="main-footer">
    <div class="footer-left">
      <% include ../../../template-backoffice/copyright-left.ejs %>
    </div>
    <div class="footer-right">
      <% include ../../../template-backoffice/copyright-right.ejs %>
    </div>
  </footer>
<% include ../../../template-backoffice/footer.ejs %>

