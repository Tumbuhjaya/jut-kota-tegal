<% var JENIS_CETAK = typeof jenis !== 'undefined' && jenis ? jenis : null; var REKLAME = !!JENIS_CETAK && JENIS_CETAK.kode === 'reklame'; var AKSES = !!JENIS_CETAK && JENIS_CETAK.kode === 'pembukaan_jalan'; var TANPA_PROVIDER = !!JENIS_CETAK && !JENIS_CETAK.pakai_provider; var OBJEK = JENIS_CETAK ? JENIS_CETAK.objek_cetak : 'Bangunan dan Jaringan Utilitas'; %><%
  var BULAN = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
  var KOSONG = '.....';
  function tanggal(t) {
    if (!t) return KOSONG;
    var d = new Date(t);
    return d.getDate() + ' ' + BULAN[d.getMonth()] + ' ' + d.getFullYear();
  }
  function isi(v) { return v == null || String(v).trim() === '' ? KOSONG : v; }

  var p = permohonan, k = konfig, pp = persetujuan, ba = peninjauan || {};
  var ps = p.perusahaan || {};
  // Alamat perusahaan boleh multi-baris
  var alamat = String(ps.alamat || '').split(/\r?\n/).map(function (t) { return t.trim(); }).filter(Boolean);
%>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Persetujuan Prinsip <%= pp.no_pp || '' %></title>
  <style>
    @page { size: A4 portrait; margin: 15mm 18mm 20mm 22mm; }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 11.5pt; color: #000; background: #e5e5e5;
           -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .kertas { width: 210mm; min-height: 297mm; margin: 10mm auto; padding: 15mm 18mm 20mm 22mm;
              background: #fff; box-shadow: 0 0 6px rgba(0,0,0,.25); }

    /* Kop surat: garis tebal + garis tipis */
    .kop { display: flex; align-items: center; padding-bottom: 5px; border-bottom: 3px solid #000; position: relative; }
    .kop::after { content: ''; position: absolute; left: 0; right: 0; bottom: -6px; border-bottom: 1px solid #000; }
    .kop img { width: 20mm; height: auto; }
    .kop .teks { flex: 1; text-align: center; line-height: 1.3; padding-right: 5mm; }
    .kop .pemerintah { font-size: 14pt; }
    .kop .instansi { font-size: 16pt; font-weight: bold; }
    .kop .alamat { font-size: 11pt; }

    .tempat-tgl { text-align: right; margin-top: 8mm; }

    /* Nomor / Sifat / Lampiran / Hal */
    table.surat { border-collapse: collapse; margin-top: 1mm; line-height: 1.4; }
    table.surat td { padding: 0; vertical-align: top; }
    table.surat td.lbl { width: 26mm; }
    table.surat td.sep { width: 5mm; }
    table.surat td.val { max-width: 125mm; }

    .tujuan { margin-top: 7mm; line-height: 1.4; display: flex; }
    .tujuan .yth { width: 10mm; }

    p { margin: 0; text-align: justify; line-height: 1.4; }
    .indent { text-indent: 12mm; }
    .pembuka { margin-top: 7mm; }

    /* Persyaratan (HTML CKEditor): 1, 2, 3 -> a, b, c */
    .persyaratan { line-height: 1.4; text-align: justify; }
    .persyaratan p { margin: 0; }
    .persyaratan ol, .persyaratan ul { margin: 0; padding-left: 7mm; }
    .persyaratan > ol { list-style-type: decimal; }
    .persyaratan ol ol { list-style-type: lower-alpha; }
    .persyaratan ol ol ol { list-style-type: lower-roman; }
    .persyaratan li { padding-left: 1mm; }

    .penutup { margin-top: 5mm; }
    .penutup p + p { margin-top: 1mm; }

    .ttd { width: 82mm; margin-left: auto; margin-top: 9mm; line-height: 1.35; page-break-inside: avoid; break-inside: avoid; }
    .ttd .ruang { height: 24mm; }
    .ttd .nama { text-decoration: underline; }

    .aksi { text-align: center; padding: 10px 0 0; }
    .aksi button { font-size: 12pt; padding: 8px 24px; cursor: pointer; }

    @media print {
      body { background: #fff; }
      .aksi { display: none; }
      .kertas { width: auto; min-height: 0; margin: 0; padding: 0; box-shadow: none; }
    }
  </style>
</head>
<body>
  <div class="aksi">
    <button type="button" onclick="window.print()">Cetak / Simpan PDF</button>
  </div>

  <div class="kertas">
    <div class="kop">
      <img src="<%= k.logo %>" alt="" onerror="this.style.visibility='hidden'">
      <div class="teks">
        <div class="pemerintah"><%= isi(k.pemerintah) %></div>
        <div class="instansi"><%= isi(k.instansi) %></div>
        <div class="alamat"><%= isi(k.alamat) %></div>
        <div class="alamat"><%= isi(k.kontak) %></div>
      </div>
    </div>

    <div class="tempat-tgl"><%= isi(k.tempat) %>, <%= tanggal(pp.tanggal_pp) %></div>

    <table class="surat">
      <tr><td class="lbl">Nomor</td><td class="sep">:</td><td class="val"><%= isi(pp.no_pp) %></td></tr>
      <tr><td class="lbl">Sifat</td><td class="sep">:</td><td class="val">Segera</td></tr>
      <tr><td class="lbl">Lampiran</td><td class="sep">:</td><td class="val">1 (satu) Bundel</td></tr>
      <tr><td class="lbl">Hal</td><td class="sep">:</td><td class="val">Persetujuan Prinsip Izin Pembangunan/Penempatan <%= OBJEK %></td></tr>
    </table>

    <div class="tujuan">
      <div class="yth">Yth.</div>
      <div>
        <div>Sdr. <%= isi(p.nama_pemohon) %></div>
        <div><%= isi(p.jabatan_pemohon) %></div>
        <div><%= isi(ps.nama_perusahaan || (TANPA_PROVIDER && p.vendor ? (p.vendor.fullname || p.vendor.username) : '')) %></div>
        <% (alamat.length ? alamat : [KOSONG]).forEach(function (a) { %>
        <div><%= a %></div>
        <% }) %>
        <div>di</div>
        <div><%= KOSONG %></div>
      </div>
    </div>

    <p class="indent pembuka">Sehubungan dengan permohonan saudara dengan surat Nomor : <%= isi(ba.no_surat_permohonan || p.no_surat_permohonan) %>
      tanggal : <%= tanggal(ba.tanggal_surat_permohonan) %> Perihal Permohonan Izin Pembangunan/Penempatan <%= OBJEK %>
      , setelah dilakukan evaluasi persyaratan administrasi dan persyaratan teknis serta hasil
      peninjauan lapangan, pada prinsipnya permohonan saudara dapat disetujui. Guna pemberian izin
      Pembangunan/Penempatan <%= OBJEK %> dimaksud, disampaikan kepada saudara untuk segera
      melengkapi persyaratan sebagai berikut:</p>

    <% /* persyaratan = HTML dari CKEditor yang diisi administrator (numbering 1,2,3; sub-poin a,b,c) */ %>
    <div class="persyaratan"><%- pp.persyaratan || '<p>' + KOSONG + '</p>' %></div>

    <div class="penutup">
      <p class="indent">Persetujuan Prinsip ini <strong>BUKAN IZIN</strong> dan pemohon dilarang melakukan kegiatan
        pembangunan apapun sebelum Izin Pemanfaatan Ruang Milik Jalan Kota diterbitkan.</p>
      <p class="indent">Demikian Persetujuan Prinsip ini kami berikan guna dilengkapi persyaratannya untuk dapat
        diproses lebih lanjut. Apabila pemohon tidak melengkapi persyaratan sebagaimana dimaksud diatas dalam jangka
        waktu paling lama 28 (dua puluh delapan) hari kerja sejak persetujuan prinsip ini diterbitkan, maka
        persetujuan prinsip ini dinyatakan tidak berlaku.</p>
    </div>

    <div class="ttd">
      <div><%= isi(k.jabatan_ttd) %></div>
      <div class="ruang"></div>
      <div class="nama"><%= isi(k.nama_ttd) %></div>
      <div><%= isi(k.pangkat_ttd) %></div>
      <div>NIP. <%= isi(k.nip_ttd) %></div>
    </div>
  </div>
</body>
</html>
