<% include ../../../template-backoffice/header.ejs %>
  <!-- Main Content -->
  <div class="main-content">
    <section class="section">
      <div class="w-100" style="padding: 0 30px;">
        <div class="section-header">
          <h1>Data Persetujuan Prinsip<%= jenis_izin.kode !== 'jaringan_utilitas' ? ' (' + jenis_izin.label + ')' : '' %></h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="/backoffice">Dashboard</a></div>
            <div class="breadcrumb-item">Data</div>
          </div>
        </div>
      </div>

      <div class="section-body">
        <div class="row">
          <div class="col-lg-12 col-xl-12">
            <div class="card">
              <div class="card-header">
              </div>
              <div class="card-body">
                <div class="table-responsive">
                  <table class="table table-bordered table-striped table-hover" id="list-data">
                    <thead>
                      <tr>
                        <th class="text-center" rowspan="2">No.</th>
                        <th class="text-center" rowspan="2">Tanggal Permohonan</th>
                        <th class="text-center" rowspan="2">Pemohon</th>
                        <% if (jenis_izin.kode === 'jaringan_utilitas') { %>
                        <th class="text-center" rowspan="2">Provider</th>
                        <% } %>
                        <th class="text-center" colspan="<%= jenis_izin.kode === 'jaringan_utilitas' ? 4 : (jenis_izin.pakai_retribusi ? 3 : 2) %>">Total</th>
                        <th class="text-center" rowspan="2" style="min-width: 100px;">Tim Teknis</th>
                        <th class="text-center" rowspan="2" style="min-width: 130px;">Status</th>
                        <th class="text-center" rowspan="2" style="min-width: 100px;">Option</th>
                      </tr>

                      <tr>
                        <th class="text-center">Ruas Jalan</th>
                        <% if (jenis_izin.kode === 'jaringan_utilitas') { %>
                        <th class="text-center">Tiang</th>
                        <th class="text-center" style="min-width: 100px;">Panjang<br/>Kabel (m)</th>
                        <th class="text-center" style="min-width: 130px;">Retribusi (Rp)</th>
                        <% } else { %>
                        <th class="text-center"><%= jenis_izin.label_titik %></th>
                        <% if (jenis_izin.pakai_retribusi) { %><th class="text-center" style="min-width: 130px;">Retribusi (Rp)</th><% } %>
                        <% } %>
                      </tr>
                    </thead>
                    <tbody></tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <footer class="main-footer">
    <div class="footer-left">
      <% include ../../../template-backoffice/copyright-left.ejs %>
    </div>
    <div class="footer-right">
      <% include ../../../template-backoffice/copyright-right.ejs %>
    </div>
  </footer>
<% include ../../../template-backoffice/footer.ejs %>

<!-- Modal -->
<div class="modal fade" id="modalDraft" tabindex="-1" aria-labelledby="judulDraft" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="judulDraft">Buat Draft Persetujuan Prinsip</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
            </button>
         </div>
        <div class="modal-body">
            <div class="row">
                <div class="col-12 col-lg-12 col-xl-12">
                    <div class="form-group">
                        <label for="tanggal_pp">Tanggal Persetujuan Prinsip</label>
                        <input type="date" class="form-control" id="tanggal_pp">
                    </div>

                    <div class="form-group">
                        <label for="no_pp">Nomor Persetujuan Prinsip</label>
                        <input type="text" class="form-control" id="no_pp">
                    </div>

                    <div class="form-group">
                        <label for="no_skrd">Nomor SKRD</label>
                        <input type="text" class="form-control" id="no_skrd" maxlength="100">
                    </div>
                </div>
            </div>
            <div class="row">
                 <div class="col-12">
                    <div class="form-group">
                        <label for="editor1">Persyaratan Persetujuan Prinsip</label>
                        <textarea id="editor1" class="form-control" rows="5"></textarea>
                    </div>
                </div>
            </div>
            <% jaminan.forEach(function (j, n) { %>
            <hr>
            <h6 class="mb-3"><%= n + 1 %>. <%= j.label %></h6>
            <div class="row">
                <div class="col-12 col-md-6">
                    <div class="form-group">
                        <label for="<%= j.kode %>_bank">Bank</label>
                        <input type="text" class="form-control in-jaminan" id="<%= j.kode %>_bank" maxlength="150">
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="form-group">
                        <label for="<%= j.kode %>_nomor">Nomor</label>
                        <input type="text" class="form-control in-jaminan" id="<%= j.kode %>_nomor" maxlength="100">
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="form-group">
                        <label for="<%= j.kode %>_nominal">Nominal (Rp)</label>
                        <input type="number" min="0" step="1" class="form-control in-jaminan" id="<%= j.kode %>_nominal">
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="form-group">
                        <label for="<%= j.kode %>_tgl_awal">Tanggal Awal</label>
                        <input type="date" class="form-control in-jaminan" id="<%= j.kode %>_tgl_awal">
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="form-group">
                        <label for="<%= j.kode %>_tgl_akhir">Tanggal Akhir</label>
                        <input type="date" class="form-control in-jaminan" id="<%= j.kode %>_tgl_akhir">
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fas fa-times"></i>&nbsp;&nbsp;Tutup</button>
        <button type="button" class="btn btn-primary" id="btn-simpan-draft" onclick="simpanDraft()"><i class="fas fa-check"></i>&nbsp;&nbsp;Simpan</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modalUpload" tabindex="-1" aria-labelledby="judulUpload" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="judulUpload">Upload Persetujuan Prinsip</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
            </button>
         </div>
        <div class="modal-body">
            <div class="row">
                <div class="col-12">
                    <div class="form-group">
                        <label for="file_ttd">Upload Persetujuan Prinsip yang sudah ditandatangani </label>
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" id="file_ttd" accept=".pdf,.jpg,.jpeg,.png">
                            <label class="custom-file-label" for="file_ttd">Pilih File</label>
                        </div>
                        <small class="text-muted">Setelah diupload, persetujuan prinsip dikirim ke email pemohon beserta link untuk mengirim kelengkapan persyaratan. Verifikasi persyaratan dapat dilakukan setelah pemohon mengirim persyaratannya.</small>
                    </div>
                </div>
            </div>
        </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fas fa-times"></i>&nbsp;&nbsp;Tutup</button>
        <button type="button" class="btn btn-primary" id="btn-simpan-upload" onclick="simpanUpload()"><i class="fas fa-check"></i>&nbsp;&nbsp;Simpan</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modalPersyaratan" tabindex="-1" aria-labelledby="judulPersyaratan" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="judulPersyaratan">Verifikasi Persyaratan Persetujuan Prinsip</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
            </button>
         </div>
        <div class="modal-body">
            <div class="form-group">
                <label>Persyaratan Persetujuan Prinsip <span id="info-pp" class="text-muted"></span></label>
                <div id="isi-persyaratan" class="border rounded p-3" style="background: #fafafa;"></div>
            </div>
            <div class="form-group">
                <label>Kelengkapan dari Pemohon</label>
                <div><a href="#" id="link-zip" class="btn btn-dark btn-sm"><i class="fas fa-file-archive"></i>&nbsp;&nbsp;<span></span></a></div>
            </div>
            <div class="form-group">
                <label for="lanjut_persyaratan">Hasil Verifikasi</label>
                <select id="lanjut_persyaratan" class="custom-select">
                    <option value="">-- Pilih --</option>
                    <option value="1">Persyaratan terpenuhi - lanjut ke Penerbitan Izin</option>
                    <option value="0">Persyaratan belum terpenuhi</option>
                </select>
            </div>
            <div class="form-group" id="wrap-keterangan-persyaratan" style="display: none;">
                <label for="keterangan_persyaratan">Persyaratan yang belum dipenuhi</label>
                <textarea id="keterangan_persyaratan" class="form-control" rows="4" style="height: auto;"></textarea>
                <small class="text-muted">Keterangan ini dikirim ke email pemohon.</small>
            </div>
        </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fas fa-times"></i>&nbsp;&nbsp;Tutup</button>
        <button type="button" class="btn btn-primary" id="btn-simpan-persyaratan" onclick="simpanPersyaratan()"><i class="fas fa-check"></i>&nbsp;&nbsp;Simpan</button>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
    var rooturl = ''
    var URL_TAHAP = rooturl + '<%= base %>/persetujuan_prinsip';
    var id_aktif = null;

    CKEDITOR.replace('editor1', {
        height: 300, // Mengatur tinggi editor (dalam piksel)
        versionCheck: false, // Menonaktifkan notifikasi peringatan versi LTS di layar
        toolbar: [
      { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent'] }
    ]
    });

    function rupiah(n) {
      return 'Rp ' + Number(n || 0).toLocaleString('id-ID', { maximumFractionDigits: 0 }) + ',-';
    }
    function esc(t) {
      return $('<div>').text(t == null || t === '' ? '-' : t).html();
    }
    function pesanGagal(xhr, def) {
      swal('Gagal', (xhr.responseJSON && xhr.responseJSON.message) || def, 'error');
    }

    let data_table  =$('#list-data').DataTable({
      "language": {
          "sProcessing":   "Sedang memproses...",
          "sLengthMenu":   "_MENU_",
          "sZeroRecords":  "Tidak ditemukan data yang sesuai",
          "sInfo":         "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
          "sInfoEmpty":    "Menampilkan 0 sampai 0 dari 0 entri",
          "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
          "sInfoPostFix":  "",
          "sUrl":          "",
          "oPaginate": {
            "sFirst":    "Pertama",
            "sPrevious": "Sebelumnya",
            "sNext":     "Selanjutnya",
            "sLast":     "Terakhir"
          }
      },
      "processing": true,
      "ordering": false,
      "ajax": { url: URL_TAHAP + '/list', type: 'POST' },
      "columns": [
        { "data": null, "defaultContent": '', "className": 'text-center' },
         { "data": 'diajukanAt', "render": function (d) { return d ? moment(d).format('DD/MM/YYYY HH:mm') : '-'; } },
        { "data": null, "render": function (r) { return esc(r.nama_pemohon) } },
        <% if (jenis_izin.kode === 'jaringan_utilitas') { %>
        { "data": 'provider', "render": esc },
        <% } %>
        { "data": 'jml_ruas', "className": 'text-center' },
        <% if (jenis_izin.kode === 'jaringan_utilitas') { %>
        { "data": 'jml_tiang', "className": 'text-center' },
        { "data": 'jml_kabel', "className": 'text-center', "render": function (d) { return Math.round(Number(d)).toLocaleString('id-ID'); } },
        { "data": 'retribusi', "className": 'text-right', "render": rupiah },
        <% } else { %>
        { "data": 'jml_titik', "className": 'text-center' },
        <% if (jenis_izin.pakai_retribusi) { %>{ "data": 'retribusi', "className": 'text-right', "render": rupiah },<% } %>
        <% } %>
        { "data": 'tim_teknis', "render": function (d) { return d ? esc(d).replace(/\n/g, '<br/>') : '-'; } },
        { "data": null, "className": 'text-center', "render": function (r) {
            if (r.tahap !== 'verifikasi_persyaratan') return '<span class="badge badge-info">Persetujuan Prinsip</span>';
            // uploadPersyaratanAt kosong = pemohon belum (kembali) mengirim ZIP persyaratan
            if (!r.uploadPersyaratanAt) {
              return '<span class="badge badge-secondary">Menunggu Persyaratan<br/>Persetujuan Prinsip Pemohon</span>' +
                (r.keterangan_persyaratan ? '<br/><small class="text-danger">belum terpenuhi, menunggu kiriman ulang</small>' : '');
            }
            return '<span class="badge badge-warning">Pemohon Telah Mengupload<br/>Persyaratan Persetujuan Prinsip</span>' +
              '<br/><small class="text-muted">dikirim ' + moment(r.uploadPersyaratanAt).format('DD/MM/YYYY HH:mm') + '</small>';
        } },
        { "data": null, "render": function (r) {
            var aksi = '<div class="w-100-flex" style="justify-content: center;gap: 5px;">' +
              '<a href="' + rooturl + '<%= base %>/persetujuan_prinsip/detail/' + r.permohonan_id + '" class="btn btn-light" title="Detail Permohonan"><i class="fas fa-eye"></i></a>' +
              (r.file_ba ? '<a href="' + rooturl + '<%= base %>/peninjauan_lapangan/file/' + r.permohonan_id + '" target="_blank" class="btn btn-secondary" title="Lihat BA Peninjauan Lapangan TTD"><i class="fas fa-file-alt"></i></a>' : '');
            // Persetujuan prinsip TTD sudah diupload -> menunggu ZIP persyaratan dari pemohon, lalu verifikasi
            if (r.tahap === 'verifikasi_persyaratan') {
              return aksi +
                '<a href="' + URL_TAHAP + '/file/' + r.permohonan_id + '" target="_blank" class="btn btn-success" title="Lihat Persetujuan Prinsip TTD"><i class="fas fa-file-signature"></i></a>' +
                (r.file_persyaratan ? '<a href="' + URL_TAHAP + '/persyaratan/' + r.permohonan_id + '" class="btn btn-dark" title="Download Persyaratan dari Pemohon (ZIP)"><i class="fas fa-file-archive"></i></a>' : '') +
                (r.uploadPersyaratanAt
                  ? '<button type="button" class="btn btn-primary" title="Verifikasi Persyaratan" onclick="bukaPersyaratan(' + r.permohonan_id + ')"><i class="fas fa-clipboard-check"></i></button>'
                  : '<button type="button" class="btn btn-primary" title="Menunggu pemohon mengirim persyaratan" disabled><i class="fas fa-clipboard-check"></i></button>') +
                '</div>';
            }
            var ada = Number(r.ada_pp);
            return aksi +
              '<button type="button" class="btn btn-warning" title="' + (ada ? 'Ubah' : 'Buat') + ' Draft Persetujuan Prinsip" onclick="bukaDraft(' + r.permohonan_id + ')"><i class="fas fa-pen-square"></i></button>' +
              (ada
                ? '<a href="' + URL_TAHAP + '/cetak/' + r.permohonan_id + '" target="_blank" class="btn btn-success" title="Cetak Draft Persetujuan Prinsip"><i class="fas fa-print"></i></a>' +
                  '<button type="button" class="btn btn-info" title="Upload Persetujuan Prinsip TTD" onclick="bukaUpload(' + r.permohonan_id + ')"><i class="fas fa-file-upload"></i></button>'
                : '<button type="button" class="btn btn-success" title="Buat draft persetujuan prinsip terlebih dahulu" disabled><i class="fas fa-print"></i></button>' +
                  '<button type="button" class="btn btn-info" title="Buat draft persetujuan prinsip terlebih dahulu" disabled><i class="fas fa-file-upload"></i></button>') +
              '</div>';
        } }
      ],
      "columnDefs": [
        { "width": "30px", "targets": 0},
      ],
    });

    data_table.on( 'draw.dt', function () {
      let PageInfo = $('#list-data').DataTable().page.info();
      data_table.column(0, { page: 'current' }).nodes().each( function (cell, i) {
        cell.innerHTML = i + 1 + PageInfo.start;
      });
    });

    // Nama file terpilih tampil di label custom-file
    $(document).on('change', '.custom-file-input', function () {
      $(this).next('.custom-file-label').text(this.files[0] ? this.files[0].name : 'Pilih File');
    });

    function bukaDraft(id) {
      id_aktif = id;
      $.get(URL_TAHAP + '/data/' + id).done(function (res) {
        var pp = res.data.persetujuan || {};
        $('#judulDraft').text((res.data.persetujuan ? 'Ubah' : 'Buat') + ' Draft Persetujuan Prinsip');
        $('#no_pp').val(pp.no_pp || '');
        $('#no_skrd').val(pp.no_skrd || '');
        $('#tanggal_pp').val(pp.tanggal_pp ? moment(pp.tanggal_pp).format('YYYY-MM-DD') : '');
        CKEDITOR.instances.editor1.setData(pp.persyaratan || '');
        $('.in-jaminan').each(function () {
          var v = pp[this.id];
          if (v == null) v = '';
          else if (this.type === 'date') v = moment(v).format('YYYY-MM-DD');
          else if (this.type === 'number') v = Number(v);
          $(this).val(v);
        });
        $('#modalDraft').modal('show');
      }).fail(function (xhr) { pesanGagal(xhr, 'Gagal memuat data'); });
    }

    function simpanDraft() {
      if (!$('#no_pp').val() || !$('#tanggal_pp').val()) return swal('Lengkapi data', 'Nomor & tanggal persetujuan prinsip wajib diisi', 'warning');
      var data = {
        no_pp: $('#no_pp').val(),
        tanggal_pp: $('#tanggal_pp').val(),
        no_skrd: $('#no_skrd').val(),
        persyaratan: CKEDITOR.instances.editor1.getData()
      };
      $('.in-jaminan').each(function () { data[this.id] = $(this).val(); });
      $('#btn-simpan-draft').prop('disabled', true);
      $.post(URL_TAHAP + '/simpan/' + id_aktif, data).done(function () {
        $('#modalDraft').modal('hide');
        swal({title:text_insert.title,text:text_insert.text, icon: text_insert.icon, type:text_insert.type})
        data_table.ajax.reload(null, false);
      }).fail(function (xhr) {
        pesanGagal(xhr, 'Gagal menyimpan draft persetujuan prinsip');
      }).always(function () {
        $('#btn-simpan-draft').prop('disabled', false);
      });
    }

    function bukaUpload(id) {
      id_aktif = id;
      $('#file_ttd').val('').next('.custom-file-label').text('Pilih File');
      $('#modalUpload').modal('show');
    }

    async function simpanUpload() {
      var f = $('#file_ttd')[0].files[0];
      if (!f) return swal('Pilih file', 'File persetujuan prinsip yang sudah ditandatangani wajib dipilih', 'warning');
      const yakin = await swal({
        title: 'Upload Persetujuan Prinsip', text: 'Persetujuan prinsip akan dikirim ke email pemohon beserta link untuk mengirim kelengkapan persyaratan. Lanjutkan?',
        icon: 'warning', buttons: ['Tidak', 'Ya']
      });
      if (!yakin) return;

      var formData = new FormData();
      formData.append('file', f);
      $('#btn-simpan-upload').prop('disabled', true);
      $.ajax({
        type: 'POST',
        url: URL_TAHAP + '/upload/' + id_aktif,
        data: formData,
        processData: false,
        contentType: false
      }).done(function () {
        $('#modalUpload').modal('hide');
        swal('Berhasil', 'Persetujuan prinsip berhasil diupload dan dikirim ke email pemohon. Menunggu pemohon mengirim persyaratan.', 'success');
        data_table.ajax.reload();
      }).fail(function (xhr) {
        pesanGagal(xhr, 'Gagal mengupload persetujuan prinsip');
      }).always(function () {
        $('#btn-simpan-upload').prop('disabled', false);
      });
    }

    // ---------------- verifikasi persyaratan ----------------
    $('#lanjut_persyaratan').on('change', function () {
      $('#wrap-keterangan-persyaratan').toggle($(this).val() === '0');
    });

    function bukaPersyaratan(id) {
      id_aktif = id;
      $.get(URL_TAHAP + '/data/' + id).done(function (res) {
        var pp = res.data.persetujuan || {};
        $('#info-pp').text(pp.no_pp ? '(No. ' + pp.no_pp + ')' : '');
        // persyaratan = HTML CKEditor isian administrator
        $('#isi-persyaratan').html(pp.persyaratan || '<i class="text-muted">Tidak ada persyaratan</i>');
        $('#link-zip').attr('href', URL_TAHAP + '/persyaratan/' + id).find('span').text(pp.nama_asli_persyaratan || 'Download ZIP');
        $('#lanjut_persyaratan').val('').trigger('change');
        $('#keterangan_persyaratan').val(pp.keterangan_persyaratan || '');
        $('#modalPersyaratan').modal('show');
      }).fail(function (xhr) { pesanGagal(xhr, 'Gagal memuat data'); });
    }

    async function simpanPersyaratan() {
      var lanjut = $('#lanjut_persyaratan').val();
      if (!lanjut) return swal('Pilih hasil', 'Hasil verifikasi persyaratan wajib dipilih', 'warning');
      if (lanjut === '0' && !$('#keterangan_persyaratan').val().trim()) {
        return swal('Lengkapi data', 'Persyaratan yang belum dipenuhi wajib diisi', 'warning');
      }
      const yakin = await swal({
        title: 'Verifikasi Persyaratan',
        text: lanjut === '1'
          ? 'Permohonan akan dilanjutkan ke tahap Penerbitan Izin (menu Izin Pemanfaatan Rumija). Lanjutkan?'
          : 'Keterangan persyaratan yang belum dipenuhi akan dikirim ke email pemohon. Lanjutkan?',
        icon: 'warning', buttons: ['Tidak', 'Ya']
      });
      if (!yakin) return;

      $('#btn-simpan-persyaratan').prop('disabled', true);
      $.post(URL_TAHAP + '/verifikasi_persyaratan/' + id_aktif, {
        lanjut: lanjut,
        keterangan: $('#keterangan_persyaratan').val()
      }).done(function () {
        $('#modalPersyaratan').modal('hide');
        swal('Berhasil', lanjut === '1'
          ? 'Persyaratan terpenuhi, permohonan lanjut ke tahap Penerbitan Izin'
          : 'Hasil verifikasi disimpan dan dikirim ke email pemohon', 'success');
        data_table.ajax.reload();
      }).fail(function (xhr) {
        pesanGagal(xhr, 'Gagal menyimpan verifikasi persyaratan');
      }).always(function () {
        $('#btn-simpan-persyaratan').prop('disabled', false);
      });
    }
</script>
