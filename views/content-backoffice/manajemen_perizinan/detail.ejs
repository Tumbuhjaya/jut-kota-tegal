<% include ../../template-backoffice/header.ejs %>
  <!-- Main Content -->
  <div class="main-content">
    <section class="section">
      <div class="w-100" style="padding: 0 30px;">
        <div class="section-header">
          <h1>Detail Permohonan Izin</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="/backoffice">Dashboard</a></div>
            <div class="breadcrumb-item"><a href="/manajemen_perizinan">Permohonan Izin</a></div>
            <div class="breadcrumb-item">Detail</div>
          </div>
        </div>
      </div>

      <div class="section-body">
        <div class="row">
          <div class="col-lg-6">
            <div class="card">
              <div class="card-header">
                <h4>Informasi Permohonan</h4>
                <div class="card-header-action">
                  <a href="#" id="btn_edit" class="btn btn-warning" style="display: none;"><i class="fas fa-edit"></i> Edit Data</a>
                  <a href="#" id="btn_cetak" target="_blank" class="btn btn-success" style="display: none;"><i class="fas fa-print"></i> Cetak SK</a>
                </div>
              </div>
              <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                  <tbody>
                    <tr><td style="width: 170px;">Status</td><td>:</td><td id="d_status"></td></tr>
                    <tr><td>Tanggal Diajukan</td><td>:</td><td id="d_diajukan"></td></tr>
                    <tr><td>Vendor</td><td>:</td><td id="d_vendor"></td></tr>
                    <tr><td>Provider</td><td>:</td><td id="d_provider"></td></tr>
                    <tr><td>Nama Pemohon</td><td>:</td><td id="d_nama"></td></tr>
                    <tr><td>Jabatan</td><td>:</td><td id="d_jabatan"></td></tr>
                    <tr><td>No. Telepon (WA)</td><td>:</td><td id="d_telp"></td></tr>
                    <tr><td>Email</td><td>:</td><td id="d_email"></td></tr>
                    <tr><td>No. SK</td><td>:</td><td id="d_sk"></td></tr>
                    <tr><td>Keterangan</td><td>:</td><td id="d_keterangan"></td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="card">
              <div class="card-header"><h4>Dokumen Persyaratan</h4></div>
              <div class="card-body">
                <ul class="list-group" id="d_dokumen"></ul>
              </div>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-12">
            <div class="card">
              <div class="card-header"><h4>Ruas Jalan & Retribusi</h4></div>
              <div class="card-body">
                <div class="table-responsive">
                  <table class="table table-bordered table-sm" id="tabel_ruas">
                    <thead>
                      <tr>
                        <th rowspan="2" class="text-center">No.</th>
                        <th rowspan="2" class="text-center" style="min-width: 200px;">Ruas Jalan</th>
                        <th rowspan="2" class="text-center">No. Ruas</th>
                        <th rowspan="2" class="text-center">Panjang SK (Km)</th>
                        <% komponen.forEach(function (k) { %>
                        <th colspan="3" class="text-center"><%= k.label %></th>
                        <% }) %>
                        <th rowspan="2" class="text-center">Total Retribusi</th>
                        <th rowspan="2" class="text-center">Peta</th>
                      </tr>
                      <tr>
                        <% komponen.forEach(function (k) { %>
                        <th class="text-center">Jumlah (<%= k.satuan %>)</th>
                        <th class="text-center">Nilai Retribusi (Rp)</th>
                        <th class="text-center">Total (Rp)</th>
                        <% }) %>
                      </tr>
                    </thead>
                    <tbody></tbody>
                    <tfoot></tfoot>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-12">
            <div class="card">
              <div class="card-header">
                <h4>Peta Digitasi</h4>
                <div class="card-header-action">
                  <span class="badge" style="background:#f7ca18;">Ruas</span>
                  <span class="badge badge-primary">Tiang</span>
                  <span class="badge badge-danger">Kabel</span>
                </div>
              </div>
              <div class="card-body">
                <div id="map" style="width: 100%; height: 500px;"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="row" id="wrap_sewa" style="display: none;">
          <div class="col-12">
            <div class="card">
              <div class="card-header">
                <h4>Perjanjian Sewa</h4>
                <div class="card-header-action">
                  <a href="#" id="btn_cetak_sewa" target="_blank" class="btn btn-success" style="display: none;"><i class="fas fa-print"></i> Cetak Draft</a>
                  <a href="#" id="btn_file_sewa" target="_blank" class="btn btn-secondary" style="display: none;"><i class="fas fa-file-signature"></i> Lihat Perjanjian TTD</a>
                </div>
              </div>
              <div class="card-body">
                <form id="form-sewa" autocomplete="off">
                  <div class="row">
                    <div class="col-md-4 form-group">
                      <label for="no_perjanjian">Nomor Perjanjian Sewa</label>
                      <input type="text" class="form-control" id="no_perjanjian">
                    </div>
                    <div class="col-md-4 form-group">
                      <label for="tanggal_perjanjian">Tanggal Perjanjian Sewa</label>
                      <input type="date" class="form-control" id="tanggal_perjanjian">
                    </div>
                  </div>
                  <div class="form-group">
                    <label for="isi_perjanjian">Ketentuan Perjanjian Sewa</label>
                    <textarea id="isi_perjanjian" class="form-control" rows="5"></textarea>
                  </div>
                  <div class="text-right mb-3">
                    <button type="button" class="btn btn-primary" id="btn_simpan_sewa" onclick="simpanSewa()"><i class="fas fa-save"></i> Simpan Draft Perjanjian Sewa</button>
                  </div>
                  <div class="form-group mb-0" id="wrap_upload_sewa" style="display: none;">
                    <label for="file_sewa">Upload Perjanjian Sewa yang sudah ditandatangani</label>
                    <div class="input-group">
                      <div class="custom-file">
                        <input type="file" class="custom-file-input" id="file_sewa" accept=".pdf,.jpg,.jpeg,.png">
                        <label class="custom-file-label" for="file_sewa">Pilih File</label>
                      </div>
                      <div class="input-group-append">
                        <button type="button" class="btn btn-info" id="btn_upload_sewa" onclick="uploadTtd('sewa')"><i class="fas fa-file-upload"></i> Upload</button>
                      </div>
                    </div>
                    <small class="text-muted" id="info_sewa"></small>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>

        <div class="row" id="wrap_tahap" style="display: none;">
          <div class="col-12">
            <div class="alert alert-info">
              Permohonan sedang di <b id="tahap_nama"></b>. Setujui / revisi / tolak dilakukan di halaman tahap tersebut.
              <a href="#" id="tahap_link" class="btn btn-light btn-sm ml-2">Buka Halaman Tahap</a>
            </div>
          </div>
        </div>

        <div class="row" id="wrap_proses" style="display: none;">
          <div class="col-12">
            <div class="card">
              <div class="card-header"><h4>Proses Permohonan</h4></div>
              <div class="card-body">
                <form id="form-proses" autocomplete="off">
                  <div class="row">
                    <div class="col-md-4 form-group">
                      <label for="no_sk">No. SK <small class="text-muted">(wajib jika disetujui)</small></label>
                      <input type="text" class="form-control" id="no_sk" name="no_sk">
                    </div>
                    <div class="col-md-4 form-group">
                      <label for="tanggal_sk">Tanggal SK</label>
                      <input type="text" class="form-control tgl1" id="tanggal_sk" name="tanggal_sk">
                    </div>
                  </div>
                  <div class="form-group">
                    <label for="keterangan">Keterangan <small class="text-muted">(wajib jika revisi / ditolak)</small></label>
                    <textarea class="form-control" id="keterangan" name="keterangan" rows="3" style="height: auto;"></textarea>
                  </div>
                  <div class="text-right">
                    <button type="button" class="btn btn-warning" onclick="proses('revisi')"><i class="fas fa-undo"></i> Kembalikan untuk Revisi</button>
                    <button type="button" class="btn btn-danger" onclick="proses('tolak')"><i class="fas fa-times"></i> Tolak</button>
                    <button type="button" class="btn btn-success" id="btn_setujui" onclick="proses('setujui')"><i class="fas fa-check"></i> Setujui &amp; Buat Draft Izin</button>
                  </div>
                  <div class="text-right"><small class="text-muted" id="info_setujui"></small></div>
                </form>
              </div>
            </div>
          </div>
        </div>

        <div class="row" id="wrap_izin" style="display: none;">
          <div class="col-12">
            <div class="card">
              <div class="card-header">
                <h4>Izin Pemanfaatan Ruang Milik Jalan</h4>
                <div class="card-header-action">
                  <a href="#" id="btn_file_izin" target="_blank" class="btn btn-secondary" style="display: none;"><i class="fas fa-file-signature"></i> Lihat Izin TTD</a>
                </div>
              </div>
              <div class="card-body">
                <div class="form-group mb-0">
                  <label for="file_izin">Upload Izin Pemanfaatan Ruang Milik Jalan yang sudah ditandatangani</label>
                  <div class="input-group">
                    <div class="custom-file">
                      <input type="file" class="custom-file-input" id="file_izin" accept=".pdf,.jpg,.jpeg,.png">
                      <label class="custom-file-label" for="file_izin">Pilih File</label>
                    </div>
                    <div class="input-group-append">
                      <button type="button" class="btn btn-info" id="btn_upload_izin" onclick="uploadTtd('izin')"><i class="fas fa-file-upload"></i> Upload</button>
                    </div>
                  </div>
                  <small class="text-muted" id="info_izin"></small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <footer class="main-footer">
    <div class="footer-left">
      <% include ../../template-backoffice/copyright-left.ejs %>
    </div>
    <div class="footer-right">
      <% include ../../template-backoffice/copyright-right.ejs %>
    </div>
  </footer>
<% include ../../template-backoffice/footer.ejs %>

<script type="text/javascript">
  var rooturl = ''
  var ID_PERMOHONAN = <%= permohonan_id %>;
  var KOMPONEN = <%- JSON.stringify(komponen) %>; // komponen retribusi per ruas (helpper/permohonan.js)
  var STATUS = {
    diajukan:  { label: 'Menunggu Verifikasi', badge: 'info' },
    revisi:    { label: 'Perlu Revisi', badge: 'warning' },
    disetujui: { label: 'Disetujui', badge: 'success' },
    ditolak:   { label: 'Ditolak', badge: 'danger' }
  };
  var TAHAP = { verifikasi: 'Verifikasi', peninjauan_lapangan: 'Peninjauan Lapangan', persetujuan_prinsip: 'Persetujuan Prinsip', verifikasi_persyaratan: 'Verifikasi Persyaratan', penerbitan_izin: 'Penerbitan Izin' };

  CKEDITOR.replace('isi_perjanjian', {
      height: 250,
      versionCheck: false, // Menonaktifkan notifikasi peringatan versi LTS di layar
      toolbar: []
  });

  // Data pertama bisa datang sebelum editor siap
  function isiEditorSewa(isi, readOnly) {
    var ed = CKEDITOR.instances.isi_perjanjian;
    function tulis() { ed.setData(isi); ed.setReadOnly(readOnly); }
    if (ed.status === 'ready') tulis(); else ed.once('instanceReady', tulis);
  }

  function rupiah(n) {
    return 'Rp ' + Number(n || 0).toLocaleString('id-ID', { maximumFractionDigits: 0 }) + ',-';
  }
  function angka(n) {
    return Number(n || 0).toLocaleString('id-ID', { maximumFractionDigits: 2 });
  }
  function esc(t) {
    return $('<div>').text(t == null || t === '' ? '-' : t).html();
  }

  // ---------------- peta ----------------
  var map = L.map('map', { center: [-6.8694, 109.1402], zoom: 13, maxZoom: 22 });
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 22, maxNativeZoom: 19 }).addTo(map);
  var ruasLayer = L.featureGroup().addTo(map);
  var digitasiLayer = L.featureGroup().addTo(map);
  var layerPerRuas = {}; // permohonan_ruas_id -> [layer]

  function petaDigitasi(digitasi) {
    digitasi.tiang.forEach(function (f) {
      var c = f.geojson.coordinates;
      var m = L.circleMarker([c[1], c[0]], { radius: 6, color: '#fff', weight: 2, fillColor: '#6777ef', fillOpacity: 1 })
        .bindPopup('<b>Tiang</b><br/>Ruas: ' + esc(f.nm_ruas || 'Di luar ruas') + '<br/>Jumlah: ' + f.jumlah + '<br/>Ket: ' + esc(f.keterangan))
        .addTo(digitasiLayer);
      (layerPerRuas[f.permohonan_ruas_id] = layerPerRuas[f.permohonan_ruas_id] || []).push(m);
    });
    digitasi.kabel.forEach(function (f) {
      var l = L.polyline(f.geojson.coordinates.map(function (p) { return [p[1], p[0]]; }), { color: '#fc544b', weight: 4 })
        .bindPopup('<b>Kabel</b><br/>Ruas: ' + esc(f.nm_ruas || 'Di luar ruas') + '<br/>Panjang: ' + angka(f.panjang) + ' m<br/>Jumlah: ' + f.jumlah + '<br/>Ket: ' + esc(f.keterangan))
        .addTo(digitasiLayer);
      (layerPerRuas[f.permohonan_ruas_id] = layerPerRuas[f.permohonan_ruas_id] || []).push(l);
    });
  }

  // Garis ruas jalan dari master_retribusi (topojson /peta/sk_jalan)
  function petaRuas(ruasIds) {
    if (!ruasIds.length) return $.Deferred().resolve();
    return $.getJSON(rooturl + '/peta/sk_jalan').then(function (topo) {
      Object.keys(topo.objects).forEach(function (k) {
        L.geoJSON(topojson.feature(topo, topo.objects[k]), {
          filter: function (f) { return ruasIds.indexOf(Number(f.properties.id)) !== -1; },
          style: { color: '#f7ca18', weight: 7, opacity: 0.9 },
          onEachFeature: function (f, layer) { layer.bindTooltip(f.properties.nm_ruas || ''); }
        }).eachLayer(function (l) { ruasLayer.addLayer(l); });
      });
      ruasLayer.bringToBack();
    });
  }

  function zoomRuas(id) {
    var g = L.featureGroup(layerPerRuas[id] || []);
    if (g.getLayers().length) map.fitBounds(g.getBounds(), { padding: [30, 30], maxZoom: 19 });
    $('html, body').animate({ scrollTop: $('#map').offset().top - 100 }, 300);
  }

  // Zoom ke hasil digitasi (tiang/kabel); garis ruas bisa sepanjang jalan, jadi hanya dipakai bila belum ada digitasi
  function zoomSemua() {
    var g = digitasiLayer.getLayers().length ? digitasiLayer : ruasLayer;
    map.invalidateSize();
    if (g.getLayers().length) map.fitBounds(g.getBounds(), { padding: [40, 40], maxZoom: 19 });
  }

  // ---------------- detail ----------------
  function tampil(data) {
    var p = data.permohonan;
    var s = STATUS[p.status] || { label: p.status, badge: 'light' };
    // Permohonan yang sedang berjalan: tampilkan tahapnya
    $('#d_status').html(p.status === 'diajukan' && TAHAP[p.tahap]
      ? '<span class="badge badge-info">Tahap ' + TAHAP[p.tahap] + '</span>'
      : '<span class="badge badge-' + s.badge + '">' + s.label + '</span>');
    $('#d_diajukan').text(p.diajukanAt ? moment(p.diajukanAt).format('DD/MM/YYYY HH:mm') : '-');
    $('#d_vendor').html(esc(p.vendor ? (p.vendor.fullname || p.vendor.username) : '-'));
    $('#d_provider').html(esc(p.provider));
    $('#d_nama').html(esc(p.nama_pemohon));
    $('#d_jabatan').html(esc(p.jabatan_pemohon));
    $('#d_telp').html(esc(p.telp_pemohon));
    $('#d_email').html(esc(p.email_pemohon));
    $('#d_sk').html(esc(p.no_sk ? p.no_sk + (p.tanggal_sk ? ' (' + moment(p.tanggal_sk).format('DD/MM/YYYY') + ')' : '') : ''));
    $('#d_keterangan').html(esc(p.keterangan));

    $('#d_dokumen').empty();
    if (!data.dokumen.length) $('#d_dokumen').append('<li class="list-group-item"><i>Belum ada dokumen</i></li>');
    data.dokumen.forEach(function (d) {
      $('#d_dokumen').append('<li class="list-group-item d-flex justify-content-between align-items-center">' + esc(d.label) +
        '<a class="btn btn-sm btn-primary" target="_blank" href="' + rooturl + '/manajemen_perizinan/dokumen/' + d.permohonan_dokumen_id + '"><i class="fas fa-download"></i></a></li>');
    });

    // Data fisik ruas tersimpan: titik awal-akhir, kelurahan/kecamatan, lebar perkerasan
    function infoRuas(r) {
      var b = [];
      if (r.tk_ruas_aw || r.tk_ruas_ak) b.push(esc(r.tk_ruas_aw || '?') + ' &rarr; ' + esc(r.tk_ruas_ak || '?'));
      if (r.kelurahan || r.kecamatan) b.push(esc([r.kelurahan, r.kecamatan].filter(Boolean).join(', ')));
      if (r.lbr_keras != null) b.push('lebar ' + angka(r.lbr_keras) + ' m');
      return b.length ? '<br/><small class="text-muted">' + b.join(' &middot; ') + '</small>' : '';
    }
    // Jumlah kabel yang berasal dari digitasi
    var keteranganDigitasi = { panjang_kabel: ['digitasi_kabel', 'garis'] };
    var t = { total: 0 };
    KOMPONEN.forEach(function (k) { t[k.kode] = { jumlah: 0, retribusi: 0 }; });
    var $tb = $('#tabel_ruas tbody').empty();
    data.ruas.forEach(function (r, i) {
      var selKomponen = KOMPONEN.map(function (k) {
        var d = keteranganDigitasi[k.jumlah];
        t[k.kode].jumlah += Number(r[k.jumlah] || 0);
        t[k.kode].retribusi += Number(r['retribusi_' + k.kode] || 0);
        return '<td class="text-center">' + angka(r[k.jumlah]) + (d ? ' <small class="text-muted">(' + r[d[0]] + ' ' + d[1] + ')</small>' : '') + '</td>' +
          '<td class="text-right">' + rupiah(r[k.tarif]) + '</td>' +
          '<td class="text-right">' + rupiah(r['retribusi_' + k.kode]) + '</td>';
      }).join('');
      t.total += Number(r.retribusi_total);
      $tb.append('<tr>' +
        '<td class="text-center">' + (i + 1) + '.</td>' +
        '<td>' + esc(r.label_ruas) + infoRuas(r) + '</td>' +
        '<td class="text-center">' + esc(r.no) + '</td>' +
        '<td class="text-center">' + (r.panjang != null ? angka(r.panjang) : '-') + '</td>' +
        selKomponen +
        '<td class="text-right">' + rupiah(r.retribusi_total) + '</td>' +
        '<td class="text-center"><button type="button" class="btn btn-sm btn-info" onclick="zoomRuas(' + r.permohonan_ruas_id + ')"><i class="fas fa-search-location"></i></button></td>' +
        '</tr>');
    });
    $('#tabel_ruas tfoot').html('<tr><th colspan="4" class="text-right">Total</th>' +
      KOMPONEN.map(function (k) {
        return '<th class="text-center">' + angka(t[k.kode].jumlah) + '</th><th></th><th class="text-right">' + rupiah(t[k.kode].retribusi) + '</th>';
      }).join('') +
      '<th class="text-right">' + rupiah(t.total) + '</th><th></th></tr>');

    $('#btn_cetak').attr('href', rooturl + '/manajemen_perizinan/cetak_sk/' + ID_PERMOHONAN).toggle(p.status === 'disetujui');
    $('#btn_edit').attr('href', rooturl + '/manajemen_perizinan/edit/' + ID_PERMOHONAN).toggle(['disetujui', 'ditolak'].indexOf(p.status) === -1);
    // Permohonan diajukan baru diproses (SK) setelah melewati tahap verifikasi persyaratan
    var penerbitan = p.status === 'diajukan' && p.tahap === 'penerbitan_izin';
    $('#wrap_proses').toggle(p.status === 'disetujui' || penerbitan);
    // Tahap sebelum penerbitan izin diproses di halaman masing-masing tahap
    var HALAMAN_TAHAP = {
      verifikasi: '/manajemen_perizinan/permohonan/verifikasi/' + ID_PERMOHONAN,
      peninjauan_lapangan: '/manajemen_perizinan/peninjauan_lapangan/detail/' + ID_PERMOHONAN,
      persetujuan_prinsip: '/manajemen_perizinan/persetujuan_prinsip/detail/' + ID_PERMOHONAN,
      verifikasi_persyaratan: '/manajemen_perizinan/persetujuan_prinsip/detail/' + ID_PERMOHONAN
    };
    var halamanTahap = p.status === 'diajukan' && HALAMAN_TAHAP[p.tahap];
    $('#wrap_tahap').toggle(!!halamanTahap);
    $('#tahap_nama').text('Tahap ' + (TAHAP[p.tahap] || p.tahap));
    $('#tahap_link').attr('href', halamanTahap ? rooturl + halamanTahap : '#');
    $('#no_sk').val(p.no_sk || '');
    $('#tanggal_sk').val(p.tanggal_sk ? moment(p.tanggal_sk).format('YYYY-MM-DD') : '');
    $('#keterangan').val(p.keterangan || '');

    // Perjanjian sewa: diisi di tahap penerbitan izin, SK baru bisa disetujui setelah perjanjian TTD diupload
    var sewa = data.perjanjian_sewa;
    $('#wrap_sewa').toggle(penerbitan || !!sewa);
    $('#no_perjanjian').val(sewa ? sewa.no_perjanjian || '' : '').prop('disabled', !penerbitan);
    $('#tanggal_perjanjian').val(sewa && sewa.tanggal_perjanjian ? moment(sewa.tanggal_perjanjian).format('YYYY-MM-DD') : '').prop('disabled', !penerbitan);
    isiEditorSewa(sewa ? sewa.isi || '' : '', !penerbitan);
    $('#btn_simpan_sewa').toggle(penerbitan);
    $('#wrap_upload_sewa').toggle(penerbitan && !!sewa);
    $('#btn_cetak_sewa').attr('href', rooturl + '/manajemen_perizinan/perjanjian_sewa/cetak/' + ID_PERMOHONAN).toggle(!!sewa);
    $('#btn_file_sewa').attr('href', rooturl + '/manajemen_perizinan/perjanjian_sewa/file/' + ID_PERMOHONAN).toggle(!!(sewa && sewa.file_ttd));
    $('#info_sewa').text(sewa && sewa.uploadTtdAt ? 'Diupload ' + moment(sewa.uploadTtdAt).format('DD/MM/YYYY HH:mm') + '. Upload ulang akan mengganti file.' : '');
    var sewaTtd = !!(sewa && sewa.file_ttd);
    $('#btn_setujui').prop('disabled', penerbitan && !sewaTtd);
    $('#info_setujui').text(penerbitan && !sewaTtd ? 'Upload perjanjian sewa yang sudah ditandatangani terlebih dahulu untuk menyetujui.' : '');

    // Izin TTD diupload setelah SK disetujui; upload mengirim email izin terbit ke pemohon
    $('#wrap_izin').toggle(p.status === 'disetujui');
    $('#btn_file_izin').attr('href', rooturl + '/manajemen_perizinan/izin/file/' + ID_PERMOHONAN).toggle(!!p.file_sk);
    $('#info_izin').text(p.uploadSkAt
      ? 'Diupload ' + moment(p.uploadSkAt).format('DD/MM/YYYY HH:mm') + ' dan sudah dikirim ke email pemohon. Upload ulang akan mengganti file dan mengirim email lagi.'
      : 'Setelah diupload, izin dikirim ke email pemohon sebagai pemberitahuan izin telah terbit.');
    $('.custom-file-input').val('').next('.custom-file-label').text('Pilih File');
  }

  // Nama file terpilih tampil di label custom-file
  $(document).on('change', '.custom-file-input', function () {
    $(this).next('.custom-file-label').text(this.files[0] ? this.files[0].name : 'Pilih File');
  });

  function simpanSewa() {
    if (!$('#no_perjanjian').val() || !$('#tanggal_perjanjian').val()) return swal('Lengkapi data', 'Nomor & tanggal perjanjian sewa wajib diisi', 'warning');
    $('#btn_simpan_sewa').prop('disabled', true);
    $.post(rooturl + '/manajemen_perizinan/perjanjian_sewa/simpan/' + ID_PERMOHONAN, {
      no_perjanjian: $('#no_perjanjian').val(),
      tanggal_perjanjian: $('#tanggal_perjanjian').val(),
      isi: CKEDITOR.instances.isi_perjanjian.getData()
    }).done(function () {
      swal({title:text_insert.title,text:text_insert.text, icon: text_insert.icon, type:text_insert.type});
      muat();
    }).fail(function (xhr) {
      swal('Gagal', (xhr.responseJSON && xhr.responseJSON.message) || 'Gagal menyimpan draft perjanjian sewa', 'error');
    }).always(function () {
      $('#btn_simpan_sewa').prop('disabled', false);
    });
  }

  // jenis: sewa (perjanjian sewa TTD) | izin (izin / SK TTD)
  var UPLOAD = {
    sewa: { input: '#file_sewa', tombol: '#btn_upload_sewa', url: '/manajemen_perizinan/perjanjian_sewa/upload/', nama: 'perjanjian sewa',
            konfirmasi: 'Upload perjanjian sewa yang sudah ditandatangani?' },
    izin: { input: '#file_izin', tombol: '#btn_upload_izin', url: '/manajemen_perizinan/izin/upload/', nama: 'izin',
            konfirmasi: 'Izin akan dikirim ke email pemohon sebagai pemberitahuan izin telah terbit. Lanjutkan?' }
  };
  async function uploadTtd(jenis) {
    var u = UPLOAD[jenis];
    var f = $(u.input)[0].files[0];
    if (!f) return swal('Pilih file', 'File ' + u.nama + ' yang sudah ditandatangani wajib dipilih', 'warning');
    var yakin = await swal({ title: 'Upload', text: u.konfirmasi, icon: 'warning', buttons: ['Tidak', 'Ya'] });
    if (!yakin) return;
    var formData = new FormData();
    formData.append('file', f);
    $(u.tombol).prop('disabled', true);
    $.ajax({ type: 'POST', url: rooturl + u.url + ID_PERMOHONAN, data: formData, processData: false, contentType: false })
      .done(function () {
        swal('Berhasil', 'File ' + u.nama + ' berhasil diupload', 'success');
        muat();
      }).fail(function (xhr) {
        swal('Gagal', (xhr.responseJSON && xhr.responseJSON.message) || 'Gagal mengupload ' + u.nama, 'error');
      }).always(function () {
        $(u.tombol).prop('disabled', false);
      });
  }

  function muat() {
    return $.get(rooturl + '/manajemen_perizinan/data/' + ID_PERMOHONAN).done(function (res) {
      tampil(res.data);
      ruasLayer.clearLayers(); digitasiLayer.clearLayers(); layerPerRuas = {};
      petaDigitasi(res.data.digitasi);
      var ruasIds = res.data.ruas.filter(function (r) { return r.ruas_id && !Number(r.luar_ruas); }).map(function (r) { return Number(r.ruas_id); });
      petaRuas(ruasIds).always(zoomSemua);
    }).fail(function () {
      swal('Gagal', 'Gagal memuat data permohonan', 'error');
    });
  }

  var LABEL_AKSI = { setujui: 'menyetujui', tolak: 'menolak', revisi: 'mengembalikan untuk revisi' };
  async function proses(aksi) {
    var yakin = await swal({
      title: 'Proses Permohonan',
      text: 'Anda akan ' + LABEL_AKSI[aksi] + ' permohonan ini.' +
        (aksi === 'setujui' ? ' Tiang & kabel hasil digitasi akan dimasukkan ke data utama.' : '') + ' Lanjutkan?',
      icon: aksi === 'setujui' ? 'info' : 'warning',
      dangerMode: aksi !== 'setujui',
      buttons: ['Batal', 'Ya']
    });
    if (!yakin) return;
    $.post(rooturl + '/manajemen_perizinan/proses/' + ID_PERMOHONAN, {
      aksi: aksi,
      no_sk: $('#no_sk').val(),
      tanggal_sk: $('#tanggal_sk').val(),
      keterangan: $('#keterangan').val()
    }).done(function (res) {
      var m = res.data && res.data.masuk_data_utama;
      swal('Berhasil', m
        ? 'Permohonan disetujui. ' + m.tiang + ' tiang dan ' + m.kabel + ' kabel masuk ke data utama.'
        : 'Permohonan berhasil diproses', 'success');
      muat();
    }).fail(function (xhr) {
      swal('Gagal', (xhr.responseJSON && xhr.responseJSON.message) || 'Gagal memproses permohonan', 'error');
    });
  }

  muat();
</script>
