<!-- komponen.ejs -->
<div class="section-body">
  <div class="row">
    <div class="col-12 col-lg-12 col-xl-12">
      <div class="card">
        <div class="card-body">

          <div class="form-group row mb-0">
            <label class="col-sm-2 col-form-label">Nama Perusahaan</label>
            <div class="col-sm-10">
              <input type="text" class="form-control" name="nama_perusahaan" id="nama_perusahaan" placeholder="Contoh: PT Jaya Abadi">
            </div>
          </div>

          <hr>

          <div class="form-group row mb-0">
            <label class="col-sm-2 col-form-label">Alamat</label>
            <div class="col-sm-10">
              <textarea class="form-control" name="alamat" id="alamat" rows="3"></textarea>
            </div>
          </div>

          <hr>

          <div class="form-group row mb-0">
            <label class="col-sm-2 col-form-label">No. Telepon</label>
            <div class="col-sm-10">
              <input type="text" class="form-control" name="no_telepon" id="no_telepon" placeholder="Contoh: 021-1234567">
            </div>
          </div>

          <hr>

          <div class="form-group row mb-0">
            <label class="col-sm-2 col-form-label">Email</label>
            <div class="col-sm-10">
              <input type="email" class="form-control" name="email" id="email" placeholder="Contoh: info@perusahaan.com">
            </div>
          </div>

          <hr>

          <div class="form-group row mb-0">
            <div class="col-sm-10 offset-sm-2" id="button_submit">
              <button class="btn btn-primary mb-0 btn-lg" onclick="submit()">Submit</button>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>