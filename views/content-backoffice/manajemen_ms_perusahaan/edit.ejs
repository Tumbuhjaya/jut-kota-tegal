<% include ../../template-backoffice/header.ejs %>
  <div class="main-content">
    <section class="section">
      <div class="w-100" style="padding: 0 30px;">
        <div class="section-header" style="border-radius: 0.25rem;">
          <h1>Edit Data Perusahaan</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="/backoffice">Dashboard</a></div>
            <div class="breadcrumb-item active"><a href="/manajemen_master/perusahaan">Data</a></div>
            <div class="breadcrumb-item">Edit Data</div>
          </div>
        </div>
      </div>

      <% include ./komponen.ejs %>

    </section>
  </div>

  <footer class="main-footer">
    <div class="footer-left">
      <% include ../../template-backoffice/copyright-left.ejs %>
    </div>
    <div class="footer-right">
      <% include ../../template-backoffice/copyright-right.ejs %>
    </div>
  </footer>

<% include ../../template-backoffice/footer.ejs %>

<script type="text/javascript">
  var rooturl = ''
  let perusahaan = {}

  window.onload = async function () {
    let data = await $.get('/perusahaan/list?id=<%=id%>')
    perusahaan = data.data[0]

    // isi form otomatis
    for (const i in perusahaan) {
      if (Object.hasOwnProperty.call(perusahaan, i)) {
        $('#' + i).val(perusahaan[i])
      }
    }
  }

  async function submit() {
    const will_update = await swal({
      title: "Edit Data",
      text: "Apakah anda akan mengedit data ini?",
      icon: "warning",
      dangerMode: true,
      buttons: ["Tidak", "Ya"],
    });

    if (will_update) {
      $('#button_submit').empty()
      $('#button_submit').append('<button class="btn btn-primary btn-embossed" disabled>Simpan</button>')

      let formData = new FormData();
      let arr = ['nama_perusahaan', 'alamat', 'no_telepon', 'email']

      formData.append('perusahaan_id', perusahaan.perusahaan_id)

      for (let i = 0; i < arr.length; i++) {
        formData.append(arr[i], $('#' + arr[i]).val())
      }

      $.ajax({
        type: 'POST',
        url: rooturl + '/perusahaan/edit',
        data: formData,
        processData: false,
        contentType: false,
        success: function(data) {
          swal({title: text_edit.title, text: text_edit.text, icon: text_edit.icon, type: text_edit.type})
          window.location.href = rooturl + '/manajemen_master/perusahaan/';
        },
        error: function(data) {
          swal({title: text_error.title, text: text_error.text, icon: text_error.icon, type: text_error.type})
        }
      })
    }
  }
</script>