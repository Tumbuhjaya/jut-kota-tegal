<% include ../../template-backoffice/header.ejs %>
  <!-- Main Content -->
  <div class="main-content">
    <section class="section">
      <div class="w-100" style="padding: 0 30px;">
        <div class="section-header">
          <h1>Laporan Berdasarkan Ruas Jalan</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Dashboard</a></div>
            <div class="breadcrumb-item">Data</div>
          </div>
        </div>
      </div>

      <div class="section-body">
        <div class="row">
          <div class="col-lg-12 col-xl-12">
            <div class="card">
              <div class="card-header" style="display: block;">
                <div class="alert alert-light" role="alert">
                  <div class="form-group mb-2">
                    <label for="">Silahkan pilih kecamatan terlebih dahulu</label>
                    <select class="form-control select2" name="id_kec" id="id_kec">
                      <option value="">-- Pilih --</option>
                    </select>
                  </div>
                  <button type="button" id="btn-cari" class="btn btn-primary" style="border-radius: 4px;">
                    <i class="fas fa-search"></i> Cari
                  </button>
                </div>
              </div>
              <div class="card-body">
                <div class="table-responsive">
                  <table class="table table-bordered" id="list-data">
                    <thead>
                      <tr>
                        <th class="text-center">No.</th>
                        <th>Kecamatan</th>
                        <th>Kelurahan</th>
                        <th>Ruas</th>
                        <th>Ruas Pangkal</th>
                        <th>Ruas Ujung</th>
                        <th>Panjang</th>
                        <th>Option</th>
                      </tr>
                    </thead>
                    <tbody></tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <footer class="main-footer">
    <div class="footer-left">
      <% include ../../template-backoffice/copyright-left.ejs %>
    </div>
    <div class="footer-right">
      <% include ../../template-backoffice/copyright-right.ejs %>
    </div>
  </footer>

<% include ../../template-backoffice/footer.ejs %>

<script type="text/javascript">
var rooturl = '';

$(document).ready(function () {

  // ==============================
  // 1. Load data kecamatan
  // ==============================
  $.get('/get_kec').done(function (data) {
    if (!data || !data.data) return;

    for (let i = 0; i < data.data.length; i++) {
      $('#id_kec').append(
        `<option value="${data.data[i].kec_id}">-- ${data.data[i].kecamatan} --</option>`
      );
    }

    // Re-init select2 setelah opsi ditambahkan
    if ($.fn.select2) {
      $('#id_kec').select2({
        width: '100%',
        placeholder: '-- Pilih Kecamatan --',
        allowClear: true
      });
    }
  }).fail(function (err) {
    console.error('Gagal load kecamatan:', err);
  });

  // ==============================
  // 2. Init DataTable
  // ==============================
  let data_table = $('#list-data').DataTable({
    "language": {
      "sProcessing":   "Sedang memproses...",
      "sLengthMenu":   "_MENU_",
      "sZeroRecords":  "Tidak ditemukan data yang sesuai",
      "sInfo":         "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
      "sInfoEmpty":    "Menampilkan 0 sampai 0 dari 0 entri",
      "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
      "sInfoPostFix":  "",
      "sUrl":          "",
      "oPaginate": {
        "sFirst":    "Pertama",
        "sPrevious": "Sebelumnya",
        "sNext":     "Selanjutnya",
        "sLast":     "Terakhir"
      }
    },
    "processing": true,
    "serverSide": false,
    "ajax": {
      "url": rooturl + "/api/list_ruas",
      "type": "POST",
      "data": function (d) {
        // kirim filter kecamatan sebagai 'kec' (sesuai backend)
        d.kec = $('#id_kec').val() || '';
      },
      "dataSrc": function (json) {
        if (json.status !== 200) {
          console.error('API Error:', json.data);
          return [];
        }
        return json.data;
      }
    },
    "columns": [
      { "data": null },
      { "data": "kecamatan",   defaultContent: '-' },
      { "data": "desa",        defaultContent: '-' },
      { "data": "nm_ruas",     defaultContent: '-' },
      { "data": "tk_ruas_aw",  defaultContent: '-' },
      { "data": "tk_ruas_ak",  defaultContent: '-' },
      {
        "data": "panjang",
        defaultContent: '-',
        "render": function (data) {
          if (data === null || data === undefined || data === '') return '-';
          return Math.ceil(Number(data));
        }
      },
      {
        "data": "id",
        "orderable": false,
        "render": function (data) {
          if (!data) return '';
          return `
            <div class="w-100-flex" style="justify-content: center;">
              <div class="dropdown">
                <a class="btn btn-warning dropdown-toggle" href="#" role="button"
                   id="dropdownMenuLink-${data}" data-toggle="dropdown"
                   aria-haspopup="true" aria-expanded="false">
                  <i class="fas fa-print"></i> Cetak
                </a>
                <div class="dropdown-menu" aria-labelledby="dropdownMenuLink-${data}">
                  <a class="dropdown-item" href="${rooturl}/manajemen_laporan/ruas_jalan/cetak/${data}" target="_blank">Cetak Utilitas</a>
                  <a class="dropdown-item" href="${rooturl}/manajemen_laporan/ruas_jalan/cetak_a3/${data}" target="_blank">Cetak Utilitas A3</a>
                  <a class="dropdown-item" href="${rooturl}/manajemen_laporan/ruas_jalan/cetak_tiang_provider/${data}" target="_blank">Cetak Tiang Provider</a>
                  <a class="dropdown-item" href="${rooturl}/manajemen_laporan/ruas_jalan/cetak_tiang_provider_a3/${data}" target="_blank">Cetak A3 Tiang Provider</a>
                </div>
              </div>
            </div>`;
        }
      }
    ],
    "columnDefs": [
      { "width": "30px",  "targets": 0 },
      { "width": "120px", "targets": 7 }
    ]
  });

  // Auto-number di kolom "No."
  data_table.on('draw.dt', function () {
    let PageInfo = data_table.page.info();
    data_table.column(0, { page: 'current' }).nodes().each(function (cell, i) {
      cell.innerHTML = i + 1 + PageInfo.start;
    });
  });

  // ==============================
  // 3. Tombol Cari → reload DataTable
  // ==============================
  $('#btn-cari').on('click', function (e) {
    e.preventDefault();
    data_table.ajax.reload();
  });

  // Reload juga saat ganti kecamatan (opsional, biar UX lebih enak)
  $('#id_kec').on('change', function () {
    data_table.ajax.reload();
  });

});

// ==============================
// Fungsi hapus (kalau nanti dipakai)
// ==============================
async function hapus(id) {
  const willDelete = await swal({
    title: "Hapus Data",
    text: "Apakah anda akan menghapus data ini?",
    icon: "warning",
    dangerMode: true,
    buttons: ["Tidak", "Ya"],
  });

  if (willDelete) {
    $.get(rooturl + "/manajemen_basic/hapus/" + id).then(function () {
      if (typeof text_delete !== 'undefined') {
        swal({ title: text_delete.title, text: text_delete.text, icon: text_delete.icon });
      }
      $('#list-data').DataTable().ajax.reload();
    });
  }
}
</script>