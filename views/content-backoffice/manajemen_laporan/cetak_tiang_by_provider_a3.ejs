<body>
    <div class="no-print actions">
        <button onclick="window.print()">Cetak Dokumen / Save PDF</button>
    </div>

    <table class="print-container">
        <tbody>
            <tr>
                <td class="bh-left bh-top bh-right bh-bottom">
                    <div class="page">
                        <div class="w-100">
                            <h5  style="text-align: center; font-weight: bold;">DAFTAR JARINGAN UTILITAS TELEKOMUNIKASI (TIANG) KOTA TEGAL</h5>
                            <h5 style="text-align: center; font-weight: bold;">
                               PROVIDER <span id="PROVIDER"></span>
                            </h5>
                            <!-- <h5  style="text-align: center; font-weight: bold;">PROVIDER <span id="nama_provider"></span></h5> -->
                            <!-- <h5 style="text-align: center; font-weight: normal;">
                                Kode Ruas : <span id="kode_ruas">-</span>
                                &nbsp;||&nbsp;
                                Nama Ruas : <span id="nama_ruas">-</span>
                            </h5> -->
                        </div>

                        <div class="w-100" style="margin-top: 2.5mm;">
                            <table border="1" cellpadding="5" cellspacing="0"
                                   style="border-collapse: collapse; width: 100%;">
                                <thead>
                                    <tr>
                                        <th>No.</th>
                                        <th style="width: 5mm;">Nama Ruas</th>
                                        <th style="width: 5mm;">GPS</th>
                                        <th style="width: 5mm;">Latitude</th>
                                        <th style="width: 5mm;">Longtitude</th>
                                        <th style="width: 30mm;">Foto 1</th>
                                        <th style="width: 5mm;">Jumlah</th>
                                        <th>Kondisi</th>
                                        <th>Keterangan</th>
                                    </tr>
                                </thead>
                                <tbody id="tbody-data">
                                    <tr><td colspan="12" style="text-align:center;">Memuat data…</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>

    <script>
        // ====== Ambil id dari URL (route sudah /ruas_jalan/cetak_tiang_provider/:id) ======
        var pathParts = window.location.pathname.split('/').filter(Boolean);
        var masterId  = pathParts[pathParts.length - 1];

        function escapeHtml(s) {
            if (s === null || s === undefined) return '';
            return String(s).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }

        function fotoUrl(name) {
            if (!name) return 'https://placehold.co/130x200?text=No+Foto';
            if (/^https?:\/\//i.test(name) || name.indexOf('/') === 0) return name;
            return 'https://storage.googleapis.com/jut-tegal/' + encodeURIComponent(name);
        }

        function val(v) {
            return (v === null || v === undefined || v === '') ? '-' : escapeHtml(v);
        }

        $(function () {
// ====== Ambil id dari URL (route sudah /ruas_jalan/cetak_tiang_provider/:id) ======
var pathParts = window.location.pathname.split('/').filter(Boolean);
var masterId  = pathParts[pathParts.length - 1];

// ✅ Ambil query string (id_kec) dari URL
var urlParams = new URLSearchParams(window.location.search);
var idKec     = urlParams.get('id_kec');
                          var ajaxUrl = '/manajemen_laporan/provider/tiang_provider_detail/' + masterId;
    if (idKec) {
        ajaxUrl += '?id_kec=' + encodeURIComponent(idKec);
    }
            $.getJSON(ajaxUrl)
                .done(function (res) {
                    $('#PROVIDER').html(res.groups[0].providers[0].nama.toUpperCase())
                    var m = res.master || {};
                    var kec = (m.kecamatan || '').toUpperCase();
                    var kel = (m.kelurahan || '').toUpperCase();

                    // $('#judul').text(
                    //     'DAFTAR PROVIDER TIANG DAN JALAN DI KECAMATAN ' + kec +
                    //     ' KELURAHAN ' + kel
                    // );
                    // $('#kode_ruas').text(m.no || '-');
                    // $('#nama_ruas').text(m.nm_ruas || '-');
                    // $('#nama_provider').text(m.providers || '-');

                    var html = '';
                    var groups = res.groups || [];

                    groups.forEach(function (g, gi) {
                        var provs    = g.providers || [];
                        var rowSpan  = provs.length || 1;
                        var noTxt    = (gi + 1) + '.';
                        var kodeGps  = val(g.kode_gps);
                        var lat      = (g.lat !== null && g.lat !== undefined) ? g.lat : '-';
                        var lng      = (g.lng !== null && g.lng !== undefined) ? g.lng : '-';
                        var f1 = fotoUrl(g.foto_1);

                        if (!provs.length) {
                            // Tidak ada provider, tampilkan baris kosong
                            html += '<tr>' +
                                '<td style="text-align:center;">' + noTxt + '</td>' +
                                '<td style="text-align:center;">' + g.nm_ruas  + '</td>' +
                                '<td style="text-align:center">' + kodeGps + '</td>' +
                                '<td>' + lat.toFixed(9) + '</td>' +
                                '<td>' + lng.toFixed(9) + '</td>' +
                                '<td style="vertical-align:middle"><img src="' + f1 + '" style="width:100%;display:block;"></td>' +
                                '<td colspan="5" style="text-align:center;color:#999;">-</td>' +
                            '</tr>';
                            return;
                        }

                        provs.forEach(function (p, pi) {
                            var abjad = String.fromCharCode(97 + pi) + '.'; // a., b., c., ...
                            html += '<tr>';

                            if (pi === 0) {
                                html += '<td rowspan="' + rowSpan + '" style="vertical-align:middle;text-align:center">' + noTxt + '</td>';
                                html += '<td rowspan="' + rowSpan + '" style="vertical-align:middle;text-align:center">' +  g.nm_ruas  + '</td>';
                                html += '<td rowspan="' + rowSpan + '" style="vertical-align:middle;text-align:center">' + kodeGps + '</td>';
                                html += '<td rowspan="' + rowSpan + '" style="vertical-align:middle;">' + lat.toFixed(9) + '</td>';
                                html += '<td rowspan="' + rowSpan + '" style="vertical-align:middle;">' + lng.toFixed(9) + '</td>';
                                html += '<td rowspan="' + rowSpan + '" style="vertical-align:middle;"><img src="' + f1 + '" style="width:100%;display:block;"></td>';
                            }

                            // html += '<td style="vertical-align:middle;text-align:center">' + abjad + '</td>';
                            // html += '<td style="vertical-align:middle;">' + val(p.nama) + '</td>';
                            html += '<td style="vertical-align:middle;text-align:center">' + val(p.jumlah) + '</td>';
                            html += '<td style="vertical-align:middle;">' + val(p.kondisi) + '</td>';
                            html += '<td style="vertical-align:middle;">' + val(p.keterangan) + '</td>';
                            html += '</tr>';
                        });
                    });

                    if (!html) {
                        html = '<tr><td colspan="12" style="text-align:center;">' +
                               'Tidak ada data tiang untuk ruas ini</td></tr>';
                    }
                    $('#tbody-data').html(html);
                })
                .fail(function (xhr) {
                    console.log(xhr);
                    $('#tbody-data').html(
                        '<tr><td colspan="12" style="text-align:center;color:red;">' +
                        'Gagal memuat data (' + xhr.status + ')</td></tr>'
                    );
                });
        });

        // Pastikan gambar selesai load dulu sebelum print
        window.addEventListener('beforeprint', function () {});
    </script>
</body>

