    <script type="text/javascript">
        /* =====================================================
         * MASTER_ID di-inject dari server (EJS)
         * ===================================================== */
        var MASTER_ID = "<%= id %>";

        /* Path dasar foto. Sesuaikan kalau bukan "/foto/" */
        var FOTO_BASE_URL = "https://storage.googleapis.com/jut-tegal/";
    </script>

    <script type="text/javascript">
        // Skala linear jumlah → ukuran
function scaleSize(value, minVal, maxVal, minOut, maxOut) {
    value = Number(value) || 0;
    if (maxVal <= minVal) return minOut;
    var t = (value - minVal) / (maxVal - minVal);
    t = Math.max(0, Math.min(1, t)); // clamp 0..1
    return minOut + t * (maxOut - minOut);
}
        /* =====================================================
         * MAP INIT
         * ===================================================== */
        var popupOptions = {
            maxWidth: '450',
            minWidth: '250',
            className: 'custom',
            closeOnClick: true
        };

        var map = L.map('map', {
            center: [-7.653612465060216, 111.32634662536874],
            zoom: 17,
            minZoom: 2,
            maxZoom: 22,
            fullscreenControl: true,
            fullscreenControlOptions: { position: 'topleft' }
        });

        var google_hybrid = L.gridLayer.googleMutant({ type: 'hybrid' });
        var google_satelit = L.gridLayer.googleMutant({ type: 'satellite' });
        var google_roadmap = L.gridLayer.googleMutant({ type: 'roadmap' });
        var osm = L.tileLayer('https://{s}.tile.osm.org/{z}/{x}/{y}.png', {});
        var Esri_WorldImagery = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}');

        map.addLayer(google_hybrid);

        L.control.scale({
            position: 'bottomright',
            metric: true,
            imperial: false
        }).addTo(map);

        var baseLayers = {
            "Google Roadmap": google_roadmap,
            "Google Hybrid": google_hybrid,
            "Google Satellite": google_satelit,
            "Open Street Map": osm,
            "ESRI World Imagery": Esri_WorldImagery
        };

        /* =====================================================
         * UTIL
         * ===================================================== */
        var colorPalette = {};

        function randomColor() {
            return '#' + Math.floor(Math.random() * 16777215).toString(16).padStart(6, '0');
        }

        function getColorByProvider(provider) {
            var providerColors = {
                "My Republik": '#e74c3c'
            };
            if (!providerColors[provider]) {
                if (!colorPalette[provider]) {
                    colorPalette[provider] = randomColor();
                }
                return colorPalette[provider];
            }
            return providerColors[provider];
        }

        function formatRp(v) {
            v = Number(v) || 0;
            return 'Rp ' + v.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ',-';
        }

        /* =====================================================
         * 3 LAYER UTILITAS (untuk 1 ID master retribusi)
         * ===================================================== */
        var masterJoinLayer = L.geoJSON(null, {
            style: function () {
                return { color: '#ff8800', weight: 3, opacity: 0.9, fillOpacity: 0.15 };
            },
            pointToLayer: function (f, latlng) {
                return L.circleMarker(latlng, {
                    radius: 6, color: '#ff8800', fillColor: '#ffcc66',
                    fillOpacity: 0.9, weight: 2
                });
            },
            onEachFeature: function (f, layer) {
                var p = f.properties || {};
                layer.bindPopup(
                    '<div style="font-size:12px;">' +
                    '<b>No Ruas:</b> ' + (p.no || '-') + '<br>' +
                    '<b>Nama Ruas:</b> ' + (p.nm_ruas || '-') + '<br>' +
                    '<b>Pangkal:</b> ' + (p.tk_ruas_aw || '-') + '<br>' +
                    '<b>Ujung:</b> ' + (p.tk_ruas_ak || '-') + '<br>' +
                    '<b>Panjang:</b> ' + (p.panjang || '-') + ' m' +
                    '</div>', popupOptions
                );
            }
        });
function scaleOpacity(value, minVal, maxVal, minOut, maxOut) {
    value = Number(value) || 0;
    if (maxVal <= minVal) return minOut;
    var t = (value - minVal) / (maxVal - minVal);
    t = Math.max(0, Math.min(1, t));
    return minOut + t * (maxOut - minOut);
}

// Kabel
var kabelJoinLayer = L.geoJSON(null, {
    style: function (f) {
        var jml = Number((f.properties || {}).jumlah) || 1;
        var op = scaleOpacity(jml, 1, 30, 0.3, 1.0); // 0.3 → 1.0
        var c = getColorByProvider((f.properties || {}).provider || 'unknown');
        return { color: c, weight: 4, opacity: op, fillOpacity: op * 0.4 };
    }
});
       var kabelJoinLayer = L.geoJSON(null, {
      style: function (f) {
        var jml = Number((f.properties || {}).jumlah) || 1;
        var op = scaleOpacity(jml, 1, 30, 0.3, 1.0); // 0.3 → 1.0
        var c = getColorByProvider((f.properties || {}).provider || 'unknown');
        return { color: c, weight: 4, opacity: op, fillOpacity: op * 0.4 };
    },
    pointToLayer: function (f, latlng) {
        var jml = Number((f.properties || {}).jumlah) || 1;
        var r = scaleSize(jml, 1, 30, 4, 12);
        var c = getColorByProvider((f.properties || {}).provider || 'unknown');
        return L.circleMarker(latlng, {
            radius: r, color: c, fillColor: c,
            fillOpacity: 0.9, weight: 2
        });
    }
});
  var tiangJoinLayer = L.geoJSON(null, {
    pointToLayer: function (f, latlng) {
        var p = f.properties || {};
        var jml = Number(p.jumlah_tia) || 1;

        // Ambil warna dari kolom rgb, contoh "(255, 252, 79)"
        var rgbColor = p.rgb ? 'rgb(' + p.rgb.replace(/[()]/g, '') + ')' : '#3388ff'; // fallback biru

        // Buat divIcon dengan background color dan icon tiang listrik (fa-bolt)
        var iconHtml = '<div style="background-color: ' + rgbColor + '; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 2px solid #333; box-shadow: 0 0 5px rgba(0,0,0,0.5);">' +
                       '<i class="fa fa-bolt" style="color: white; font-size: 16px;"></i></div>';
        var icon = L.divIcon({
            html: iconHtml,
            className: 'custom-tiang-icon',
            iconSize: [30, 30],
            iconAnchor: [15, 15],
            popupAnchor: [0, -15]
        });

        var marker = L.marker(latlng, {
            icon: icon,
            riseOnHover: true
        });

        marker._jumlahTiang = jml;
        return marker;
    },
    onEachFeature: function (f, layer) {
        var p = f.properties || {};

        // Foto dari kolom kd_foto_1 / kd_foto_2 / kd_foto_3 (opsional)
        var foto1 = p.kd_foto_1 ? FOTO_BASE_URL + p.kd_foto_1 : '';
        var foto2 = p.kd_foto_2 ? FOTO_BASE_URL + p.kd_foto_2 : '';
        var foto3 = p.kd_foto_3 ? FOTO_BASE_URL + p.kd_foto_3 : '';

        var fotoHtml = '';
        if (foto1) fotoHtml += '<img src="'+foto1+'" style="max-width:120px;max-height:90px;border-radius:4px;margin:2px;" onerror="this.style.display=\'none\'">';
        if (foto2) fotoHtml += '<img src="'+foto2+'" style="max-width:120px;max-height:90px;border-radius:4px;margin:2px;" onerror="this.style.display=\'none\'">';
        if (foto3) fotoHtml += '<img src="'+foto3+'" style="max-width:120px;max-height:90px;border-radius:4px;margin:2px;" onerror="this.style.display=\'none\'">';

        layer.bindPopup(
            '<div style="font-size:12px;max-width:280px;">' +
                '<b>Kode GPS:</b> ' + (p.kode_gps || '-') + '<br>' +
                '<b>Kode Ruas:</b> ' + (p.kode_ruas || '-') + '<br>' +
                '<b>Jumlah Tiang:</b> ' + (p.jumlah_tia || '-') + '<br>' +
                '<b>Provider:</b> ' + (p.provider || '-') + '<br>' +
                '<b>Kondisi:</b> ' + (p.kondisi || '-') + '<br>' +
                '<b>Ciri Tiang:</b> ' + (p.ciri_tiang || '-') + '<br>' +
                '<b>Retribusi:</b> ' + formatRp(p.t_k30cm || p.t_l30cm || 0) +
                (fotoHtml ? '<hr style="margin:6px 0;"><div>'+fotoHtml+'</div>' : '') +
            '</div>',
            popupOptions
        );

        // Tooltip nama provider saat hover
        layer.bindTooltip(
            (p.provider || '-') + ' • ' + (p.jumlah_tia || 0) + ' tiang',
            { direction: 'top', offset: [0, -12] }
        );
    }
});
/* =====================================================
 * LEGENDA TIANG (berdasarkan kolom rgb + provider)
 * ===================================================== */
var legendTiang = L.control({ position: 'bottomleft' });

legendTiang.onAdd = function (map) {
    this._div = L.DomUtil.create('div', 'info legend');
    this._div.innerHTML = '<h6>Legenda Tiang</h6><div id="legend-items"><i style="color:#888;">Memuat data...</i></div>';
    return this._div;
};

// Simpan referensi agar bisa di-update
var legendTiangControl = legendTiang.addTo(map);

/**
 * Update legenda berdasarkan data tiang (array row dari backend).
 * Setiap entri unik dikelompokkan berdasarkan pasangan provider + rgb.
 */
function updateLegendTiang(tiangRows) {
    var items = {};

    (tiangRows || []).forEach(function (t) {
        var provider = (t.provider || 'Tidak diketahui').toString().trim();
        var rgbRaw = t.rgb ? String(t.rgb).replace(/[()\s]/g, '') : null;

        // Skip jika rgb kosong → tetap tampilkan dengan warna abu-abu
        var key = provider + '||' + (rgbRaw || 'default');

        if (!items[key]) {
            items[key] = {
                provider: provider,
                color: rgbRaw ? 'rgb(' + rgbRaw + ')' : '#888888'
            };
        }
    });

    var html = '';
    var keys = Object.keys(items);

    if (keys.length === 0) {
        html = '<i style="color:#888;">Tidak ada data tiang</i>';
    } else {
        keys.forEach(function (k) {
            var it = items[k];
            html +=
                '<div class="legend-item">' +
                    '<span class="legend-color" style="background-color:' + it.color + ';"></span>' +
                    '<span class="legend-label">' + it.provider + '</span>' +
                '</div>';
        });
    }

    var container = document.getElementById('legend-items');
    if (container) container.innerHTML = html;
}
/* =====================================================
         * FOTO (dari table tiang)
         * ===================================================== */
        function isFilled(v) {
            return v !== null && v !== undefined && String(v).trim() !== '';
        }

        function setFoto(boxId, filename) {
            var $box = $('#' + boxId);
            $box.empty();
            console.log( FOTO_BASE_URL + filename);
            
            if (isFilled(filename)) {
                $('<img>')
                    .attr('src', FOTO_BASE_URL + filename)
                    .attr('alt', 'Foto')
                    .on('error', function () {
                        // Ganti ke placeholder kalau file tidak ada
                        $box.empty().append('<span class="empty-text">Foto tidak ditemukan</span>');
                    })
                    .appendTo($box);
            } else {
                $box.append('<span class="empty-text">Foto tidak tersedia</span>');
            }
        }

        function isiFotoTiang(tiangRows) {
            // Ambil tiang pertama yang punya minimal 1 foto
            var picked = [];
                        

            let kdrs = 0
            for (var i = 0; i < (tiangRows || []).length; i++) {
                var t = tiangRows[i];
                if (t.kode_ruas!=kdrs) {
                    picked.push(t)
                }
                if (kdrs.length==3) {
                    break;
                }
                // if (isFilled(t.kd_foto_1) || isFilled(t.kd_foto_2) || isFilled(t.kd_foto_3)) {
                //     picked = t;
                //     break;
                // }
            }
            // Kalau tidak ada yang punya foto, pakai baris pertama (biar tetap kosong)
            if (!picked && tiangRows && tiangRows.length > 0) {
                picked = tiangRows[tiangRows.length-Math.ceil(Math.random()*10)];
            }

            if (!picked) {
                setFoto('foto_box_1', null);
                setFoto('foto_box_2', null);
                setFoto('foto_box_3', null);
                return;
            }
            
            setFoto('foto_box_1', picked[0].kd_foto_1);
            setFoto('foto_box_2', picked[1].kd_foto_2);
            setFoto('foto_box_3', picked[2].kd_foto_3);
        }

        /* =====================================================
         * ISI TABEL INFO DARI RESPONSE BACKEND
         * ===================================================== */
        function isiTabelMaster(m, stats) {
            $('#val_kecamatan').text(m.kecamatan || '-');
            $('#val_kelurahan').text(m.kelurahan || '-');
            $('#val_kode_ruas').text(m.no || '-');
            $('#val_nama_ruas').text(m.nm_ruas || '-');

            $('#val_pangkal').text(m.tk_ruas_aw || '-');
            $('#val_ujung').text(m.tk_ruas_ak || '-');
            // $('#val_panjang').text((Math.ceil(m.panjang) || '-') + (Math.ceil(m.panjang) ? ' m' : ''));
            $('#val_panjang').text(m.panjang ? Math.ceil(m.panjang).toLocaleString('id-ID') + ' m' : '-');

            $('#val_jml_provider').text(stats.jumlah_provider);
            $('#val_jml_tiang').text(stats.jumlah_tiang);
            $('#val_jml_kabel').text(stats.jumlah_kabel);
            $('#val_ttl_p_kabel').text(Math.ceil(stats.total_panjang_kabel).toLocaleString('id-ID') +' m');


            
            $('#val_potensi_tiang').text(formatRp(Math.ceil(stats.potensi_retribusi_tiang)));
            $('#val_potensi_kabel').text(formatRp(Math.ceil(stats.potensi_retribusi_kabel)));
            $('#val_total_potensi').text(formatRp(Math.ceil(stats.total_potensi_retribusi)));
        }

        /* =====================================================
         * KONVERSI ARRAY ROW (WKT) → GeoJSON FeatureCollection
         * ===================================================== */
        function rowsToFC(arr) {
            var features = [];
            arr.forEach(function (row) {
                if (!row.geometry) return;
                var layer;
                try {
                    layer = omnivore.wkt.parse(row.geometry);
                } catch (e) {
                    console.warn('WKT invalid:', row.geometry, e);
                    return;
                }
                layer.eachLayer(function (l) {
                    if (l.feature) {
                        var props = {};
                        for (var k in row) {
                            if (k !== 'geometry') props[k] = row[k];
                        }
                        features.push({
                            type: 'Feature',
                            properties: props,
                            geometry: l.feature.geometry
                        });
                    }
                });
            });
            return { type: 'FeatureCollection', features: features };
        }

        /* =====================================================
         * LOAD DETAIL 1 ID
         * ===================================================== */
        function loadDetailById(id) {
            $.getJSON(root + 'manajemen_laporan/ruas_jalan_detail/' + encodeURIComponent(id), function (resp) {
                if (!resp || !resp.master) {
                    console.warn('Data master kosong untuk id=' + id);
                    return;
                }
console.log(resp);

                // 1) Isi tabel
                isiTabelMaster(resp.master, resp.stats);

                // 2) Isi foto dari tiang
                isiFotoTiang(resp.tiang || []);

                // 3) Layer Master
                masterJoinLayer.clearLayers();
                masterJoinLayer.addData(rowsToFC([resp.master]));
                masterJoinLayer.addTo(map);

                // 4) Layer Tiang
                tiangJoinLayer.clearLayers();
                tiangJoinLayer.addData(rowsToFC(resp.tiang || []));
                tiangJoinLayer.addTo(map);
updateLegendTiang(resp.tiang || []);

                // 5) Layer Kabel
                kabelJoinLayer.clearLayers();
                kabelJoinLayer.addData(rowsToFC(resp.kabel || []));
                kabelJoinLayer.addTo(map);

                // 6) Zoom ke semua layer
                var all = L.featureGroup([masterJoinLayer, tiangJoinLayer, kabelJoinLayer]);
                if (all.getLayers().length > 0) {
                    map.fitBounds(all.getBounds(), { padding: [30, 30], maxZoom: 17 });
                }
            }).fail(function (xhr) {
                console.warn('Gagal load detail id=' + id, xhr.status, xhr.responseText);
            });
        }

        /* =====================================================
         * LAYER CONTROL
         * ===================================================== */
        var groupedOverlays = {
            "Jaringan Utilitas": {
                "&nbsp;&nbsp;Master Retribusi": masterJoinLayer,
                "&nbsp;&nbsp;Tiang":            tiangJoinLayer,
                "&nbsp;&nbsp;Kabel":            kabelJoinLayer
            }
        };

        L.control.groupedLayers(baseLayers, groupedOverlays, {
            collapsed: true,
            groupCheckboxes: false
        }).addTo(map);

        /* =====================================================
         * RUN
         * ===================================================== */
        $(document).ready(function () {
            if (typeof MASTER_ID !== 'undefined' && MASTER_ID) {
                loadDetailById(MASTER_ID);
            } else {
                console.warn('MASTER_ID tidak terdefinisi');
            }
        });
    </script>
