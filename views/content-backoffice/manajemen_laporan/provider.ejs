<% include ../../template-backoffice/header.ejs %>
  <!-- Main Content -->
   <style>
  /* Pertebal garis luar tabel */
  #list-data {
    border: 2px solid #000 !important;
  }

  /* Pertebal garis header */
  #list-data thead th {
    border: 2px solid #000 !important;
    font-weight: 700;
  }

  /* Pertebal garis body */
  #list-data tbody td {
    border: 2px solid #000 !important;
  }

  /* Pertebal garis pembatas antar baris */
  #list-data tbody tr {
    border-bottom: 2px solid #000 !important;
  }

  /* Hover effect tetap halus */
  #list-data tbody tr:hover {
    background-color: #f5f5f5;
  }
</style>
  <div class="main-content">
    <section class="section">
      <div class="w-100" style="padding: 0 30px;">
        <div class="section-header">
          <h1>Laporan Berdasarkan Ruas Jalan</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Dashboard</a></div>
            <div class="breadcrumb-item">Data</div>
          </div>
        </div>
      </div>

      <div class="section-body">
        <div class="row">
          <div class="col-lg-12 col-xl-12">
            <div class="card">
              <div class="card-header" style="display: block;">
                <!-- <a href="/manajemen_basic/insert" class="btn btn-primary custom-btn-card-header"><i class="fas fa-plus"></i> Tambah Data</a> -->
                <div class="alert alert-light" role="alert">
                  <div class="form-group mb-2">
                    <label for="">Silahkan pilih kecamatan terlebih dahulu</label>
                    <select class="form-control select2" name="" id="id_kec">
                      <option value="">-- Pilih --</option>
                    </select>
                  </div>
<button type="button" id="btn-cari" class="btn btn-primary" style="border-radius: 4px;">
  <i class="fas fa-search"></i> Cari
</button>                  
                </div>
              </div>
              <div class="card-body">
                <div class="table-responsive">
                  <table class="table table-bordered" id="list-data">
                    <thead>                                 
                      <tr>
                        <th class="text-center">No.</th>
                        <th>Provider</th>
                                                <th>Option</th>

                      </tr>
                    </thead>
                    <tbody>                                 
                 
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <footer class="main-footer">
    <div class="footer-left">
      <% include ../../template-backoffice/copyright-left.ejs %>
    </div>
    <div class="footer-right">
      <% include ../../template-backoffice/copyright-right.ejs %>
    </div>
  </footer>
<% include ../../template-backoffice/footer.ejs %>

<script type="text/javascript">
    var rooturl = ''
    window.onload = async () => {
      let data = await $.get('/get_kec')
      console.log(data);
      
      for (let i = 0; i < data.data.length; i++) {
          $('#id_kec').append(`<option value="${data.data[i].kec_id} ">-- ${data.data[i].kecamatan} --</option>`)
      }
    }

   let data_table = $('#list-data').DataTable({
    "language": {
        "sProcessing":   "Sedang memproses...",
        "sLengthMenu":   "_MENU_",
        "sZeroRecords":  "Tidak ditemukan data yang sesuai",
        "sInfo":         "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
        "sInfoEmpty":    "Menampilkan 0 sampai 0 dari 0 entri",
        "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
        "sInfoPostFix":  "",
        "sUrl":          "",
        "oPaginate": {
            "sFirst":    "Pertama",
            "sPrevious": "Sebelumnya",
            "sNext":     "Selanjutnya",
            "sLast":     "Terakhir"
        }
    },
    "processing": true,
    "ajax": {
       url: `${rooturl}/provider/list`,
    type: 'POST',
    contentType: 'application/json',
    data: function (d) {
        d.id_kec = $('#id_kec').val(); // kirim id kecamatan
        return JSON.stringify(d);
    }
    },
    "columns": [
        { "data": null },
        { "data": 'provider' },
        { 
            "data": 'provider_id',
             "orderable": false,
      "render": function (data) {
    if (!data) return '';
    const idKec = $('#id_kec').val() || '';
    return `
      <div class="w-100-flex" style="justify-content: center;">
        <div class="dropdown">
          <a class="btn btn-warning dropdown-toggle" href="#" role="button" id="dropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="fas fa-print"></i> Cetak
          </a>

          <div class="dropdown-menu" aria-labelledby="dropdownMenuLink">
            <a class="dropdown-item" href="${rooturl}/manajemen_laporan/provider/cetak_tiang_provider/${data}?id_kec=${idKec}" target="_blank">Cetak Tiang Provider</a>
            <a class="dropdown-item" href="${rooturl}/manajemen_laporan/provider/cetak_tiang_provider_a3/${data}?id_kec=${idKec}" target="_blank">Cetak A3 Tiang Provider</a>
          </div>
        </div>
      </div>`;
}
        }
    ],
    "columnDefs": [
        { "width": "30px", "targets": 0 },
        { "width": "100px", "targets": 2 }
    ]
});

// Event untuk memberi nomor urut pada halaman
data_table.on('draw.dt', function () {
    let PageInfo = $('#list-data').DataTable().page.info();
    data_table.column(0, { page: 'current' }).nodes().each(function (cell, i) {
        cell.innerHTML = i + 1 + PageInfo.start;
    });
});
// Saat kecamatan diganti, reload DataTable
$('#id_kec').on('change', function () {
    data_table.ajax.reload();
});

// Saat tombol Cari diklik, reload DataTable
$('#btn-cari').on('click', function (e) {
    e.preventDefault();
    data_table.ajax.reload();
});

</script>