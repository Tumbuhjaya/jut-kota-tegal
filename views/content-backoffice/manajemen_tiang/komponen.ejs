<div class="section-body">
  <div class="row">
    <div class="col-12 col-lg-12 col-xl-12">
      <div class="card">
        <div class="card-body">
          <div class="form-group row mb-0">
            <div class="col-12">
              <h4>Digitasi Peta</h4>
              <hr>
            </div>
            
          </div>
          <div class="form-group row mb-0">
            <div class="col-12 col-lg-8">
              <div style="width: 100%;height: 440px;background-color: rgba(0,0,0,0.6);" id="map"></div>
            </div>

            <div class="col-12 col-lg-4">
              <div class="alert alert-secondary" role="alert">
                  <h6>Filter peta berdasarkan :</h6>
                  <hr>
                  <div class="form-group">
                    <label for="">Nama Ruas</label>
                    <select name="" id="" class="form-control select2">
                      <option value="">-- Pilih --</option>
                    </select>
                  </div>

                  <hr>

                  <div class="form-group">
                    <label for="">Koordinat Lokasi (Longtitude, Latitude)</label>
                    <input type="text" class="form-control" name="" id="" placeholder="110.xxxxxx">
                    <small id="emailHelp" class="form-text text-muted">Koordinat longtitude</small>
                    <input type="text" class="form-control mt-2" name="" id="" placeholder="-6.xxxxx">
                    <small id="" class="form-text text-muted mt-0 mb-3">Koordinat latitude</small>

                    <button class="btn btn-dark"><i class="fas fa-location-arrow"></i> Menuju lokasi</button>
                  </div>
              </div>
            </div>
          </div>
          

         <div class="form-group row mb-0">
            <div class="col-12">
              <h4>Informasi Tiang</h4>
              <hr>
            </div>
            
          </div>

          <div class="form-group row mb-0">
            <label class="col-sm-2 col-form-label">Kecamatan</label>
            <div class="col-sm-10">
              <select class="form-control select2" name="" id="kd_kec">
                <option value="">-- Pilih --</option>
              </select>
            </div>
          </div>
          <hr>

          <div class="form-group row mb-0">
            <label class="col-sm-2 col-form-label">Kelurahan</label>
            <div class="col-sm-10">
              <select class="form-control select2" name="" id="kd_kel">
                <option value="">-- Pilih --</option>
              </select>
            </div>
          </div>
          
          <hr>

          <div class="form-group row mb-0">
            <label class="col-sm-2 col-form-label">Provider</label>
            <div class="col-sm-10">
              <select class="form-control select2" name="" id="provider_id">
                <option value="">-- Pilih --</option>
              </select>
            </div>
          </div>
          <hr>

          <div class="form-group row mb-0">
            <label class="col-sm-2 col-form-label">Kategori Diameter Tiang</label>
            <div class="col-sm-10">
              <select class="form-control select2" name="" id="kategori_tiang">
                <option value="">-- Pilih --</option>
                <option value="t_k30cm"> <30 cm </option>
                <option value="t_l30cm"> >30 cm </option>
              </select>
            </div>
          </div>
          <hr>

          <div class="form-group row mb-0">
            <label class="col-sm-2 col-form-label">Kondisi Tiang</label>
            <div class="col-sm-10">
             <input type="text" class="form-control" name="" id="kondisi">
            </div>
          </div>
          <hr>
<div class="form-group row mb-0">
            <label class="col-sm-2 col-form-label">Jumlah Tiang</label>
            <div class="col-sm-10">
             <input type="text" class="form-control" name="" id="jumlah_tia">
            </div>
          </div>
          <hr>
          <div class="form-group row mb-0">
            <label class="col-sm-2 col-form-label">Ciri Tiang</label>
            <div class="col-sm-10">
             <input type="text" class="form-control" name="" id="ciri_tiang">
            </div>
          </div>
          <hr>

          

          <div class="form-group row mb-0">
            <label class="col-sm-2 col-form-label">Upload Foto Dokumentasi 1</label>
            <div class="col-sm-10">
              <input type="file" class="form-control" name="" id="kd_foto_1">
            </div>
          </div>
          <hr>

          <div class="form-group row mb-0">
            <label class="col-sm-2 col-form-label">Upload Foto Dokumentasi 2</label>
            <div class="col-sm-10">
              <input type="file" class="form-control" name="" id="kd_foto_2">
            </div>
          </div>
          <hr>

          <div class="form-group row mb-0">
            <label class="col-sm-2 col-form-label">Upload Foto Dokumentasi 3</label>
            <div class="col-sm-10">
              <input type="file" class="form-control" name="" id="kd_foto_3">
            </div>
          </div>
          <hr>

          <div class="form-group row mb-0">
            <div class="col-sm-10 offset-sm-2">
              <button class="btn btn-primary" onclick="submit()">Simpan</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>