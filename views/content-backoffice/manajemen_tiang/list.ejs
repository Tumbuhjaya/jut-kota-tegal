<% include ../../template-backoffice/header.ejs %>
  <!-- Main Content -->
  <div class="main-content">
    <section class="section">
      <div class="w-100" style="padding: 0 30px;">
        <div class="section-header">
          <h1>Data Tiang</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Dashboard</a></div>
            <div class="breadcrumb-item">Data</div>
          </div>
        </div>
      </div>

      <div class="section-body">
        <div class="row">
          <div class="col-lg-12 col-xl-12">
            <div class="card">
              <div class="card-header">
                <ul class="list-inline">
                  <li class="list-inline-item"><a href="/manajemen_tiang/insert" class="btn btn-primary custom-btn-card-header"><i class="fas fa-plus"></i> Tambah Data Lokasi Tiang</a></li>
                  <li class="list-inline-item"><a href="/manajemen_tiang/import_data" class="btn btn-info custom-btn-card-header"><i class="fas fa-plus"></i> Import Data By Spasial</a></li>
                </ul>
              </div>
              <div class="card-body">
                <div class="table-responsive">
                  <table class="table table-bordered" id="list-data">
                    <thead>                                 
                      <tr>
                        <th class="text-center" rowspan="2">No.</th>
                        <th rowspan="2">Ruas</th>
                        <th colspan="2">Lokasi Tiang</th>
                        <th rowspan="2">Provider</th>
                        <th rowspan="2">Kategori</th>
                        <th rowspan="2">Kondisi</th>
                        <th rowspan="2">Ciri Tiang</th>
                        <th rowspan="2" style="min-width: 100px;">Option</th>
                      </tr>
                      <tr>
                        <th>Kecamatan</th>
                        <th>Kelurahan</th>
                      </tr>
                    </thead>
                    <tbody>
                      <!-- Data akan diisi oleh DataTables -->
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <footer class="main-footer">
    <div class="footer-left">
      <% include ../../template-backoffice/copyright-left.ejs %>
    </div>
    <div class="footer-right">
      <% include ../../template-backoffice/copyright-right.ejs %>
    </div>
  </footer>
<% include ../../template-backoffice/footer.ejs %>

<script type="text/javascript">
    var rooturl =  '';

    let data_table = $('#list-data').DataTable({
      "language": {
          "sProcessing":   "Sedang memproses...",
          "sLengthMenu":   "_MENU_",
          "sZeroRecords":  "Tidak ditemukan data yang sesuai",
          "sInfo":         "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
          "sInfoEmpty":    "Menampilkan 0 sampai 0 dari 0 entri",
          "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
          "sInfoPostFix":  "",
          "sUrl":          "",
          "oPaginate": {
            "sFirst":    "Pertama",
            "sPrevious": "Sebelumnya",
            "sNext":     "Selanjutnya",
            "sLast":     "Terakhir"
          }
      },
      "processing": true,
      "serverSide": false,  // ambil semua data sekaligus
      "ajax": {
          "type": "POST",                     // <-- tambahkan ini
        "contentType": "application/json",
        "url": rooturl + "/api/list_tiang",
        "dataSrc": "data"   // karena response {status:200, data:[...]}
      },
      "columns": [
        { // No urut otomatis
          "data": null,
          "render": function (data, type, row, meta) {
            return meta.row + 1;
          }
        },
        { "data": "nm_ruas" },
        { "data": "kecamatan" },
        { "data": "desa" },
        { "data": "provider" },
        { // Kategori – contoh menggunakan target_fid, ubah sesuai kebutuhan
          "data": null,
          "render": function (row) {
            return row.t_k30cm ? `Tiang Listrik, Telekomunikasi Diameter <30 CM`: row.t_l30cm ?'Tiang Listrik, Telekomunikasi Diameter >30 CM':'' ;
          }
        },
        { "data": "kondisi" },
        { "data": "ciri_tiang" },
        { // Option
          "data": null,
          "render": function (row) {
            return `
              <ul class="list-inline mb-0">
                <li class="list-inline-item">
                  <a href="${rooturl}/manajemen_tiang/edit/${row.id}" class="btn btn-warning"><i class="fas fa-edit"></i></a>
                </li>
                <li class="list-inline-item">
                  <button onclick="hapus(${row.id})" class="btn btn-danger"><i class="fas fa-trash"></i></button>
                </li>
              </ul>
            `;
          }
        }
      ],
      "columnDefs": [
        { "width": "30px", "targets": 0 },
        { "width": "100px", "targets": 8 }
      ]
    });

    // Fungsi hapus (tidak berubah)
    async function hapus(id) {
      const willDelete = await swal({
        title: "Hapus Data",
        text: "Apakah anda akan menghapus data ini?",
        icon: "warning",
        dangerMode: true,
        buttons: ["Tidak", "Ya"],
      });
            
      if (willDelete) {
        $.get(rooturl + "/manajemen_tiang/hapus/" + id).then(function (hsl) {
          swal({title: "Berhasil", text: "Data berhasil dihapus", icon: "success", type: "success"});
          data_table.ajax.url(rooturl + "/manajemen_tiang/list").load(); // sesuaikan endpoint reload jika perlu
        });
      }
    }
</script>