    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="/images/template/shortcut_icon.ico">

    <link href="/stylesheets/template/css/bootstrap.css" rel="stylesheet">
    <link href="/stylesheets/template/css/style.css" rel="stylesheet">
    <link rel="stylesheet" href="/plugins/fontawesome-5/css/all.css">
    <link href="https://cdn.datatables.net/1.10.22/css/dataTables.bootstrap4.min.css" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="/javascripts/template/jquery.min.js"></script>

    <style type="text/css">
        :root {
            --navy: #0d4aa2;
            --royal: #0f44be;
            --blue: #1256d7;
            --bright: #1581ee;
            --cyan: #17c3ff;
            --gold: #f7ca18;
            --gradient-main: linear-gradient(135deg, #0d4aa2 0%, #0f44be 25%, #1256d7 50%, #1581ee 75%, #17c3ff 100%);
        }

        * { font-family: 'Plus Jakarta Sans', sans-serif; }

        body {
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
            background: var(--gradient-main);
            background-size: 200% 200%;
            animation: gradientShift 15s ease infinite;
            background-attachment: fixed;
            color: #1f2d3d;
        }

        @keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        body::before {
            content: '';
            position: fixed;
            top: 0; right: 0; bottom: 0; left: 0;
            z-index: 0;
            pointer-events: none;
            opacity: 0.25;
            background-image:
                repeating-linear-gradient(0deg, rgba(255,255,255,0.55) 0px, rgba(255,255,255,0.55) 1px, transparent 1px, transparent 60px),
                repeating-linear-gradient(90deg, rgba(255,255,255,0.45) 0px, rgba(255,255,255,0.45) 1px, transparent 1px, transparent 60px);
            -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
            mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
        }

        .dash-wrapper {
            position: relative;
            z-index: 2;
            max-width: 1200px;
            margin: 0 auto;
            padding: 24px 16px 40px;
        }

        /* ===== Topbar ===== */
        .dash-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            color: #fff;
            margin-bottom: 24px;
        }
        .dash-brand { line-height: 1.2; }
        .dash-brand small { color: var(--gold); font-weight: 700; letter-spacing: .04em; }
        .dash-brand h1 { font-size: 1.5rem; font-weight: 800; margin: 2px 0 0; color: #fff; }
        .dash-user { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .dash-user .nama { font-weight: 600; }
        .btn-glass {
            background: rgba(255,255,255,0.15);
            border: 1.5px solid rgba(255,255,255,0.4);
            color: #fff;
            border-radius: 10px;
            padding: 6px 14px;
            font-weight: 600;
        }
        .btn-glass:hover { background: rgba(255,255,255,0.28); color: #fff; text-decoration: none; }

        /* ===== Statistik ===== */
        .stat-card {
            display: flex;
            align-items: center;
            background: rgba(255,255,255,0.14);
            -webkit-backdrop-filter: blur(20px);
            backdrop-filter: blur(20px);
            border: 1.5px solid rgba(255,255,255,0.3);
            border-radius: 18px;
            padding: 18px 20px;
            color: #fff;
            height: 100%;
        }
        .stat-icon {
            width: 52px; height: 52px;
            border-radius: 14px;
            background: rgba(255,255,255,0.22);
            border: 1.5px solid rgba(255,255,255,0.4);
            display: flex; align-items: center; justify-content: center;
            margin-right: 16px;
            font-size: 22px;
            color: var(--gold);
            flex-shrink: 0;
        }
        .stat-label { font-size: .85rem; opacity: .9; }
        .stat-value { font-size: 1.8rem; font-weight: 800; line-height: 1.1; }

        /* ===== Panel putih ===== */
        .dash-panel {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 25px 45px -15px rgba(13, 74, 162, 0.6);
            padding: 22px;
        }
        .dash-panel-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 16px;
        }
        .dash-panel-title h2 { font-size: 1.15rem; font-weight: 800; margin: 0; color: var(--navy); }

        .btn-gradient {
            background: var(--gradient-main);
            border: 0;
            color: #fff;
            border-radius: 10px;
            font-weight: 700;
            padding: 8px 16px;
        }
        .btn-gradient:hover { color: #fff; opacity: .92; }

        .filter-pills .btn { border-radius: 999px; margin: 0 6px 6px 0; font-weight: 600; }
        .filter-pills .btn.active { background: var(--navy); border-color: var(--navy); color: #fff; }

        table.dataTable thead th { color: var(--navy); font-weight: 700; border-bottom-width: 1px; }
        .badge-jenis { border-radius: 999px; padding: 5px 10px; font-weight: 600; }

        /* Switch mitra */
        .switch { position: relative; display: inline-block; width: 44px; height: 24px; margin: 0; vertical-align: middle; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .switch .slider { position: absolute; cursor: pointer; inset: 0; background: #ced4da; border-radius: 24px; transition: .2s; }
        .switch .slider:before { content: ''; position: absolute; height: 18px; width: 18px; left: 3px; top: 3px; background: #fff; border-radius: 50%; transition: .2s; }
        .switch input:checked + .slider { background: #28a745; }
        .switch input:checked + .slider:before { transform: translateX(20px); }

        .modal-content { border-radius: 16px; border: 0; }
        .modal-header { border-bottom: 0; }
        .modal-footer { border-top: 0; }

        @media (max-width: 575.98px) {
            .dash-brand h1 { font-size: 1.2rem; }
            .dash-panel { padding: 16px; }
            .stat-value { font-size: 1.5rem; }
        }
    </style>
