<!DOCTYPE html>
<html lang="id">
<head>
    <title>Dashboard Vendor - Database Jaringan Utilitas Telekomunikasi Kota Tegal</title>
    <% include ../template/dashboard_head.ejs %>
    <style type="text/css">
        .shortcut-card {
            display: flex;
            align-items: center;
            height: 100%;
            background: rgba(255,255,255,0.12);
            -webkit-backdrop-filter: blur(20px);
            backdrop-filter: blur(20px);
            border: 1.5px solid rgba(255,255,255,0.3);
            border-radius: 18px;
            padding: 20px 22px;
            color: #fff;
            text-decoration: none;
            transition: all .3s;
            min-height: 96px;
        }
        .shortcut-card:hover { transform: translateY(-5px); background: rgba(255,255,255,0.22); color: #fff; text-decoration: none; }
        .shortcut-card .stat-icon { margin-right: 16px; }
        .shortcut-title { font-weight: 700; color: var(--gold); }
        .shortcut-desc { font-size: .85rem; opacity: .9; margin: 0; }
        .provider-chip {
            display: inline-flex;
            align-items: center;
            border: 1px solid #dee2e6;
            border-radius: 999px;
            padding: 6px 14px;
            margin: 0 8px 8px 0;
            font-weight: 600;
        }
        .provider-chip .dot { width: 10px; height: 10px; border-radius: 50%; margin-right: 8px; background: var(--bright); }
    </style>
</head>

<body>
    <div class="dash-wrapper">

        <div class="dash-topbar">
            <div class="dash-brand">
                <small>DASHBOARD VENDOR</small>
                <h1><%= mitra.nama_perusahaan %></h1>
            </div>
            <div class="dash-user">
                <span class="nama"><i class="far fa-user-circle"></i> <%= user.fullname || user.username %></span>
                <a href="/autentifikasi/logout" class="btn-glass"><i class="fas fa-sign-out-alt"></i> Keluar</a>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12 col-md-4 mb-3 mb-md-0">
                <a href="/tiang" class="shortcut-card">
                    <div class="stat-icon"><i class="fas fa-map-pin"></i></div>
                    <div><div class="shortcut-title">Utilitas Tiang</div><p class="shortcut-desc">Data tiang provider mitra</p></div>
                </a>
            </div>
            <div class="col-12 col-md-4 mb-3 mb-md-0">
                <a href="/kabel" class="shortcut-card">
                    <div class="stat-icon"><i class="fas fa-vector-square"></i></div>
                    <div><div class="shortcut-title">Utilitas Kabel</div><p class="shortcut-desc">Data kabel provider mitra</p></div>
                </a>
            </div>
            <div class="col-12 col-md-4">
                <a href="/tidak_teridentifikasi" class="shortcut-card">
                    <div class="stat-icon"><i class="fas fa-times"></i></div>
                    <div><div class="shortcut-title">Tidak Teridentifikasi</div><p class="shortcut-desc">Utilitas tanpa pemilik</p></div>
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-12 col-lg-5 mb-4 mb-lg-0">
                <div class="dash-panel h-100">
                    <div class="dash-panel-title"><h2>Perusahaan Mitra</h2></div>
                    <table class="table table-sm table-borderless mb-0">
                        <tr><td class="text-muted" style="width:110px">Nama</td><td class="font-weight-bold"><%= mitra.nama_perusahaan %></td></tr>
                        <tr><td class="text-muted">Alamat</td><td><%= mitra.alamat || '-' %></td></tr>
                        <tr><td class="text-muted">Telepon</td><td><%= mitra.no_telepon || '-' %></td></tr>
                        <tr><td class="text-muted">Email</td><td><%= mitra.email || '-' %></td></tr>
                        <tr><td class="text-muted">Status</td><td><span class="badge badge-success badge-jenis">Bermitra</span></td></tr>
                    </table>
                </div>
            </div>
            <div class="col-12 col-lg-7">
                <div class="dash-panel h-100">
                    <div class="dash-panel-title"><h2>Provider yang Ditangani</h2></div>
                    <div id="list-provider"><span class="text-muted">Memuat...</span></div>
                </div>
            </div>
        </div>
    </div>

    <% include ../template/dashboard_script.ejs %>
    <script type="text/javascript">
        $(function () {
            $.get('/dashboard_vendor/provider', function (res) {
                var data = (res && res.data) || [];
                if (!data.length) {
                    $('#list-provider').html('<span class="text-muted">Belum ada provider yang ditugaskan perusahaan.</span>');
                    return;
                }
                $('#list-provider').html(data.map(function (p) {
                    var warna = p.warna ? ` style="background:${esc(p.warna)}"` : '';
                    return `<span class="provider-chip"><span class="dot"${warna}></span>${esc(p.provider)}</span>`;
                }).join(''));
            }).fail(function (xhr) {
                if (xhr.status === 403) window.location.href = '/';
            });
        });
    </script>
</body>
</html>
