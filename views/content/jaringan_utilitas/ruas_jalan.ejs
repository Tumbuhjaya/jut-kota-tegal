        .shortcut-icon {
            width: 56px;
            height: 56px;
            background: rgba(255, 255, 255, 0.22);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            border: 1.5px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 8px 20px rgba(23, 195, 255, 0.4);
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            margin-right: 18px;
        }

        .shortcut-card:hover .shortcut-icon {
            transform: scale(1.12) rotate(-6deg);
            background: rgba(255, 255, 255, 0.38);
            box-shadow: 0 10px 26px rgba(23, 195, 255, 0.7);
        }

        .shortcut-content { flex: 1; min-width: 0; }

        .shortcut-title {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 4px;
            letter-spacing: -0.01em;
            color: #fff;
            line-height: 1.2;
        }

        .shortcut-desc {
            font-size: 0.85rem;
            opacity: 0.85;
            line-height: 1.4;
            margin-bottom: 0;
            color: #fff;
        }

        .shortcut-arrow {
            color: rgba(255, 255, 255, 0.7);
            flex-shrink: 0;
            margin-left: 10px;
            transition: all 0.3s;
        }

        .shortcut-card:hover .shortcut-arrow {
            color: #fff;
            transform: translateX(5px);
        }

        .select2-container--bootstrap4 .select2-results__option{
            color: #000;
        }

        .select2-container--bootstrap4 .select2-selection--single .select2-selection__rendered{
            font-weight: 500;
        }

        label {
            font-weight: 500;
        }

        /* Primary Button */
        .btn-gradient {
            /* width: 100%; */
            padding:8px 20px;
            background: var(--gradient-main);
            background-size: 200% 200%;
            color: #fff;
            border: none;
            border-radius: 6px;
            /* font-size: 0.95rem; */
            font-weight: 600;
            letter-spacing: 0.02em;
            cursor: pointer;
            transition: all 0.4s ease;
            box-shadow:
            0 10px 25px -6px rgba(21, 129, 238, 0.55),
            0 0 0 1px rgba(15, 68, 190, 0.25);
            position: relative;
            overflow: hidden;
        }

        .btn-gradient::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.45), transparent);
            transition: left 0.6s ease;
        }

        .btn-gradient:hover {
            color: #fff;
            transform: translateY(-2px);
            background-position: 100% 50%;
            box-shadow:
            0 15px 38px -6px rgba(15, 68, 190, 0.55),
            0 8px 24px -8px rgba(23, 195, 255, 0.6);
        }

        .btn-gradient:hover::before { left: 100%; }
        .btn-gradient:active, .btn-gradient:focus { transform: translateY(0); outline: none; color: #fff; }

        /* Primary Button - Yellow Gradient */
        .btn-gradient-yellow {
            /* width: 100%; */
            padding:8px 20px;
            /* Gradient dibuat dengan varian warna dari #f7ca18 */
            background: linear-gradient(135deg, #f7ca18 0%, #e6b800 50%, #f7ca18 100%);
            background-size: 200% 200%;
            color: #111; /* Teks gelap agar kontras dan mudah dibaca di atas warna kuning */
            border: none;
            border-radius: 6px;
            /* font-size: 0.95rem; */
            font-weight: 600;
            letter-spacing: 0.02em;
            cursor: pointer;
            transition: all 0.4s ease;
            
            /* Bayangan disesuaikan menggunakan warna dasar kuning (#f7ca18) */
            box-shadow:
                0 10px 25px -6px rgba(247, 202, 24, 0.55),
                0 0 0 1px rgba(200, 160, 0, 0.25);
            position: relative;
            overflow: hidden;
        }

        .btn-gradient-yellow::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            /* Efek kilau (shimmer) putih transparan */
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent);
            transition: left 0.6s ease;
        }

        .btn-gradient-yellow:hover {
            color: #111; /* Warna teks tetap gelap saat di-hover */
            transform: translateY(-2px);
            background-position: 100% 50%;
            
            /* Bayangan hover disesuaikan */
            box-shadow:
                0 15px 38px -6px rgba(247, 202, 24, 0.6),
                0 8px 24px -8px rgba(255, 223, 77, 0.7);
        }

        .btn-gradient-yellow:hover::before { 
            left: 100%; 
        }

        .btn-gradient-yellow:active, 
        .btn-gradient-yellow:focus { 
            transform: translateY(0); 
            outline: none; 
            color: #111; 
        }
        
        .fw-600{
            font-weight: 600;
