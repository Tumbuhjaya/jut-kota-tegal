    <style type="text/css">
        :root {
            --navy: #0d4aa2;
            --royal: #0f44be;
            --blue: #1256d7;
            --bright: #1581ee;
            --cyan: #17c3ff;
            --dark: #0c1e35;
            --gray: #64748b;

            /* ✅ GRADIENT BARU — Royal Blue → Cyan, 135deg */
            --gradient-main: linear-gradient(135deg,
            #0d4aa2 0.000%,
            #0f44be 25.000%,
            #1256d7 50.000%,
            #1581ee 75.000%,
            #17c3ff 100.000%);
        }

        * { font-family: "Blinker", sans-serif;font-weight: 600; }

        /* ================================================================
            BODY — Gradient + Perspective Grid Tech
            ================================================================ */
        body {
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
            /* padding: 20px 15px; */
            background: var(--gradient-main);
            background-size: 200% 200%;
            animation: gradientShift 15s ease infinite;
            background-attachment: fixed;
            font-size: 14px;
            color:#0c1e35
        }

        @keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        /* ============================================================
            LAYER 1: PERSPECTIVE GRID (Tron Style)
            ============================================================ */
        body::before {
            content: '';
            position: fixed;
            top: 0; right: 0; bottom: 0; left: 0;
            z-index: 0;
            pointer-events: none;
            opacity: 0.4;
            background-image:
            repeating-linear-gradient(
                0deg,
                rgba(255, 255, 255, 0.55) 0px,
                rgba(255, 255, 255, 0.55) 1px,
                transparent 1px,
                transparent 60px
            ),
            repeating-linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.45) 0px,
                rgba(255, 255, 255, 0.45) 1px,
                transparent 1px,
                transparent 60px
            );
            background-size: 60px 60px, 60px 60px;
            background-position: center center;
            transform: perspective(500px) rotateX(45deg);
            transform-origin: center 70%;
            animation: gridPerspective 20s linear infinite;
            -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
            mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
        }

        @keyframes gridPerspective {
            from { background-position: center 0, center center; }
            to { background-position: center 60px, center center; }
        }

        

        /* ============================================================
            LAYER 4: PULSE NETWORK ORBS
            ============================================================ */
        .pulse-node {
            position: fixed;
            border-radius: 50%;
            filter: blur(100px);
            pointer-events: none;
            z-index: 0;
        }

        .pulse-node-1 {
            width: 500px; height: 500px;
            background: radial-gradient(circle, #17c3ff 0%, transparent 70%);
            top: -180px; left: -180px;
            opacity: 0.5;
            animation: pulse 8s ease-in-out infinite;
        }

        .pulse-node-2 {
            width: 450px; height: 450px;
            background: radial-gradient(circle, #0d4aa2 0%, transparent 70%);
            bottom: -150px; right: -150px;
            opacity: 0.45;
            animation: pulse 8s ease-in-out infinite;
            animation-delay: 4s;
        }

        .pulse-node-3 {
            width: 320px; height: 320px;
            background: radial-gradient(circle, #1581ee 0%, transparent 70%);
            top: 40%; right: 15%;
            opacity: 0.3;
            animation: pulse 10s ease-in-out infinite;
            animation-delay: 2s;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.45; }
            50% { transform: scale(1.35); opacity: 0.7; }
        }
        /* ============================================================
            SHORTCUT CARD
            ============================================================ */
        .shortcut-card-menu {
            display: flex;
            align-items: center;
            height: fit-content;
            width: fit-content;
            background: rgba(255, 255, 255, 0.12);
            -webkit-backdrop-filter: blur(20px);
            backdrop-filter: blur(20px);
            border: 1.5px solid rgba(255, 255, 255, 0.3);
            border-radius: 10px;
            padding: 10px 15px;
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            text-decoration: none;
            color: #fff;
            box-shadow:
            0 10px 30px -10px rgba(13, 74, 162, 0.5),
            inset 0 0 0 1px rgba(255, 255, 255, 0.05);
            position: relative;
            overflow: hidden;
            /* min-height: 100px; */
        }

        .shortcut-card-menu::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
            transition: left 0.6s ease;
        }

        .shortcut-card-menu:hover::before { left: 100%; }

        .shortcut-card-menu:hover {
            transform: translateY(-6px);
            background: rgba(255, 255, 255, 0.22);
            border-color: rgba(255, 255, 255, 0.55);
            color: #fff;
            text-decoration: none;
            box-shadow:
            0 25px 45px -12px rgba(13, 74, 162, 0.7),
            0 0 40px -5px rgba(23, 195, 255, 0.7),
            inset 0 0 0 1px rgba(255, 255, 255, 0.15);
        }

        .shortcut-card-menu:focus {
            outline: none;
            color: #fff;
            text-decoration: none;
            box-shadow:
            0 0 0 4px rgba(23, 195, 255, 0.35),
            0 25px 45px -12px rgba(13, 74, 162, 0.7);
        }

        .shortcut-card-menu:hover{
            transform: scale(1.12) rotate(-6deg);
            background: rgba(255, 255, 255, 0.38);
            box-shadow: 0 10px 26px rgba(23, 195, 255, 0.7);
