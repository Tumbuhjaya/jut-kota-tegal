    <!-- Plugins This Page -->
    <script src="https://cdn.canvasjs.com/canvasjs.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/js/select2.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.22/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.22/js/dataTables.bootstrap4.min.js"></script>
    <script src="<%= rooturl %>/plugins/slick/slick.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js"></script>
    <!-- End Plugins This Page -->
    <script type="text/javascript">
        var rooturl = '';

        var ID_PERMOHONAN = <%= permohonan.permohonan_id %>;
        var BISA_UBAH = <%= bisa_ubah ? 'true' : 'false' %>;
        var API = rooturl + '/perizinan/jaringan_utilitas/api/';
        var URL_KEMBALI = '<%= url_kembali %>';
        var JUMLAH_DOKUMEN_WAJIB = 8; // semua kecuali surat kuasa
        var KODE_WILAYAH = <%- JSON.stringify(kode_wilayah) %>;
        var KOMPONEN = <%- JSON.stringify(komponen) %>; // komponen retribusi per ruas (helpper/permohonan.js)

        var masterRuas = {};      // id -> data master_retribusi
        var opsiRuas = '';        // <option> ruas, dibangun sekali
        var idRuasLain = '';      // id baris 'Jalan Lain' = pilihan di luar ruas
        var adaPerubahan = false; // ada isian tabel yang belum disimpan

        function rupiah(n) {
            return 'Rp ' + Number(n || 0).toLocaleString('id-ID', { maximumFractionDigits: 0 }) + ',-';
        }
        function angka(n) {
            return Number(n || 0).toLocaleString('id-ID', { maximumFractionDigits: 2 });
        }
        function esc(t) {
            return $('<div>').text(t == null ? '' : t).html();
        }
        function pesanGagal(xhr, def) {
            return (xhr && xhr.responseJSON && xhr.responseJSON.message) || def;
        }

        // ---------------- tabel ruas ----------------
        function tambahBaris(row) {
            row = row || {};
            var dis = BISA_UBAH ? '' : 'disabled';
            // Panjang kabel yang sudah didigitasi mengikuti hasil digitasi
            var digitasi = { panjang_kabel: [row.digitasi_kabel, 'garis'] };
            // Tiap komponen: jumlah (isian) | nilai retribusi (tarif) | total
            var selKomponen = KOMPONEN.map(function (k) {
                var d = digitasi[k.jumlah];
                var kunci = !BISA_UBAH || (d && d[0] > 0) ? 'readonly' : '';
                return '<td><input type="number" min="0" step="' + (k.satuan === 'Unit' ? '1' : '0.01') + '" class="form-control in-jml" data-kolom="' + k.jumlah + '" ' + kunci + '>' +
                        (d && d[0] > 0 ? '<small class="text-muted">digitasi: ' + d[0] + ' ' + d[1] + '</small>' : '') + '</td>' +
                    '<td class="text-right c-tarif" data-kode="' + k.kode + '"></td>' +
                    '<td class="text-right c-ret" data-kode="' + k.kode + '"></td>';
            }).join('');
            var $tr = $('<tr>' +
                '<td class="no"></td>' +
                '<td><div class="w-100-flex" style="justify-content: center;flex-wrap: wrap;align-items: center;gap: 5px;">' +
                    '<button type="button" class="btn btn-info btn-digitasi" data-jenis="tiang" title="Digitasi Tiang"><i class="fas fa-map-pin"></i></button>' +
                    '<button type="button" class="btn btn-dark btn-digitasi" data-jenis="kabel" title="Digitasi Kabel"><i class="fas fa-grip-lines"></i></button>' +
                    (BISA_UBAH ? '<button type="button" class="btn btn-danger btn-hapus" title="Hapus"><i class="fas fa-trash"></i></button>' : '') +
                '</div></td>' +
                '<td><select class="form-control pilih-ruas" ' + dis + '><option value="' + idRuasLain + '">-- Di luar ruas (Jalan Lain) --</option>' + opsiRuas + '</select></td>' +
                '<td class="text-center c-prov"></td>' +
                '<td class="text-center c-kab"></td>' +
                '<td class="text-center c-no"></td>' +
                '<td class="text-center c-panjang"></td>' +
                selKomponen +
                '<td class="text-right c-ret-total"></td>' +
                '</tr>');
            $tr.data('row', row);
            $tr.find('.pilih-ruas').val(row.ruas_id || idRuasLain);
            KOMPONEN.forEach(function (k) { $tr.find('.in-jml[data-kolom=' + k.jumlah + ']').val(row[k.jumlah] || 0); });
            $('#tbody_ruas').append($tr);
            $tr.find('.pilih-ruas').select2({ theme: 'bootstrap4', width: '100%' });
            if (!row.permohonan_ruas_id) adaPerubahan = true;
            hitungBaris($tr);
            hitungTotal();
        }

        // Data & tarif ruas yang sudah tersimpan dipakai selama ruasnya tidak diganti, selain itu dari master.
        // Hasil: { no, panjang, total, komponen: { kode: { jumlah, tarif, retribusi } } }
        function hitungRuas($tr) {
            var row = $tr.data('row') || {};
            var ruas_id = $tr.find('.pilih-ruas').val();
            var tersimpan = row.permohonan_ruas_id && String(row.ruas_id || '') === String(ruas_id);
            var d = tersimpan ? row : (masterRuas[ruas_id] || {});
            var hasil = { no: d.no, panjang: d.panjang, total: 0, komponen: {} };
            KOMPONEN.forEach(function (k) {
                var tarif = Number((tersimpan ? d[k.tarif] : d[k.kode]) || 0);
                var jumlah = Number($tr.find('.in-jml[data-kolom=' + k.jumlah + ']').val() || 0);
                hasil.komponen[k.kode] = { jumlah: jumlah, tarif: tarif, retribusi: jumlah * tarif };
                hasil.total += jumlah * tarif;
            });
            return hasil;
        }

        function hitungBaris($tr) {
            var h = hitungRuas($tr);
            // Nomor ruas SK SD: kode provinsi | kode kab/kota | no ruas (di luar ruas tidak punya nomor)
            $tr.find('.c-prov').text(h.no ? KODE_WILAYAH.prov : '-');
            $tr.find('.c-kab').text(h.no ? KODE_WILAYAH.kab : '-');
            $tr.find('.c-no').text(h.no || '-');
            $tr.find('.c-panjang').text(h.panjang != null ? angka(h.panjang) : '-');
            KOMPONEN.forEach(function (k) {
                $tr.find('.c-tarif[data-kode=' + k.kode + ']').text(rupiah(h.komponen[k.kode].tarif));
                $tr.find('.c-ret[data-kode=' + k.kode + ']').text(rupiah(h.komponen[k.kode].retribusi));
            });
            $tr.find('.c-ret-total').text(rupiah(h.total));
        }

        function hitungTotal() {
            var t = { total: 0 };
            KOMPONEN.forEach(function (k) { t[k.kode] = { jumlah: 0, retribusi: 0 }; });
            $('#tbody_ruas tr').each(function (i) {
                var h = hitungRuas($(this));
                $(this).find('.no').text((i + 1) + '.');
                KOMPONEN.forEach(function (k) {
                    t[k.kode].jumlah += h.komponen[k.kode].jumlah;
                    t[k.kode].retribusi += h.komponen[k.kode].retribusi;
                });
                t.total += h.total;
            });
            KOMPONEN.forEach(function (k) {
                $('#total_jml_' + k.kode).text(angka(t[k.kode].jumlah) + (k.satuan === 'Meter' ? ' m' : ''));
                $('#total_ret_' + k.kode).text(rupiah(t[k.kode].retribusi));
            });
            $('#total_ret').text(rupiah(t.total));
        }

        function isiTabel(rows) {
            $('#tbody_ruas').empty();
            rows.forEach(function (r) { tambahBaris(r); });
            if (!rows.length && BISA_UBAH) tambahBaris();
            adaPerubahan = !rows.length && BISA_UBAH;
            hitungTotal();
        }

        $('#tbody_ruas').on('change input', '.pilih-ruas, .in-jml', function () {
            adaPerubahan = true;
            hitungBaris($(this).closest('tr'));
            hitungTotal();
        });

        $('#provider_id').on('change', function () { adaPerubahan = true; });

        $('#tbody_ruas').on('click', '.btn-hapus', async function () {
            var $tr = $(this).closest('tr');
            var row = $tr.data('row') || {};
            if (!row.permohonan_ruas_id) { $tr.remove(); hitungTotal(); return; }
            var yakin = await swal({
                title: 'Hapus Ruas',
                text: 'Ruas beserta digitasi tiang & kabelnya akan dihapus. Lanjutkan?',
                icon: 'warning', dangerMode: true, buttons: ['Tidak', 'Ya']
            });
            if (!yakin) return;
            $.get(API + 'ruas/hapus/' + ID_PERMOHONAN + '/' + row.permohonan_ruas_id)
                .done(function () { $tr.remove(); hitungTotal(); swal('Berhasil', 'Ruas dihapus', 'success'); })
                .fail(function (xhr) { swal('Gagal', pesanGagal(xhr, 'Gagal menghapus ruas'), 'error'); });
        });

        // Tombol tiang / kabel: simpan dulu jika ada perubahan, lalu buka peta ruas tsb.
        $('#tbody_ruas').on('click', '.btn-digitasi', async function () {
            var $tr = $(this).closest('tr');
            var jenis = $(this).data('jenis');
            var index = $('#tbody_ruas tr').index($tr);
            var rows = null;
            if (BISA_UBAH && adaPerubahan) {
                rows = await simpan(false);
                if (!rows) return;
            }
            var row = rows ? rows[index] : $tr.data('row');
            if (!row || !row.permohonan_ruas_id) return;
            if (jenis === 'kabel' && !(row.digitasi_tiang > 0) && !(row.digitasi_kabel > 0)) {
                return swal('Tiang belum ada', 'Digitasi tiang pada ruas ini terlebih dahulu, baru kemudian kabel.', 'warning');
            }
            window.location.href = rooturl + '/perizinan/jaringan_utilitas/ruas_jalan/' + jenis + '/' + ID_PERMOHONAN + '/' + row.permohonan_ruas_id;
        });

        // Mengembalikan daftar ruas tersimpan, atau null jika gagal
        async function simpan(tampilkanPesan) {
            var ruas = [];
            $('#tbody_ruas tr').each(function () {
                var $tr = $(this);
                var baris = {
                    permohonan_ruas_id: ($tr.data('row') || {}).permohonan_ruas_id || null,
                    ruas_id: $tr.find('.pilih-ruas').val() || null
                };
                $tr.find('.in-jml').each(function () { baris[$(this).data('kolom')] = this.value; });
                ruas.push(baris);
            });
            try {
                var res = await $.ajax({
                    url: API + 'simpan/' + ID_PERMOHONAN,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ provider_id: $('#provider_id').val() || null, ruas: ruas })
                });
                isiTabel(res.data);
                adaPerubahan = false;
                if (tampilkanPesan) swal('Berhasil', 'Data berhasil disimpan', 'success');
                return res.data;
            } catch (xhr) {
                swal('Gagal', pesanGagal(xhr, 'Gagal menyimpan data'), 'error');
                return null;
            }
        }

        async function ajukan() {
            var yakin = await swal({
                title: 'Ajukan Permohonan',
                text: 'Setelah diajukan, data tidak bisa diubah sampai diproses admin. Lanjutkan?',
                icon: 'info', buttons: ['Batal', 'Ajukan']
            });
            if (!yakin) return;
            if (!(await simpan(false))) return;
            $.post(API + 'ajukan/' + ID_PERMOHONAN)
                .done(function () {
                    swal('Berhasil', 'Permohonan berhasil diajukan', 'success').then(function () {
                        window.location.href = URL_KEMBALI;
                    });
                })
                .fail(function (xhr) { swal('Belum lengkap', pesanGagal(xhr, 'Gagal mengajukan permohonan'), 'warning'); });
        }

        // ---------------- dokumen persyaratan ----------------
        function tampilDokumen(dokumen) {
            $('.dok-info').html('<span class="text-danger"><i>Belum diupload</i></span>');
            var wajib = 0;
            dokumen.forEach(function (d) {
                if (d.jenis_dokumen !== 'surat_kuasa') wajib++;
                $('.dok-info[data-jenis=' + d.jenis_dokumen + ']').html(
                    'File saat ini: <a href="' + rooturl + '/perizinan/jaringan_utilitas/dokumen/' + ID_PERMOHONAN + '/' +
                    d.permohonan_dokumen_id + '" target="_blank">' + esc(d.nama_asli) + '</a>');
            });
            $('#info_dokumen').html(wajib + '/' + JUMLAH_DOKUMEN_WAJIB + ' dokumen wajib terupload');
        }

        $('#form-syarat').on('change', '.custom-file-input', function () {
            $(this).next('.custom-file-label').text(this.files[0] ? this.files[0].name : 'Pilih File');
        });

        $('#form-syarat').on('submit', function (e) {
            e.preventDefault();
            var $btn = $(this).find('[type=submit]').prop('disabled', true);
            $.ajax({
                url: API + 'syarat/' + ID_PERMOHONAN,
                type: 'POST',
                data: new FormData(this),
                processData: false,
                contentType: false
            }).done(function (res) {
                tampilDokumen(res.data);
                $('#form-syarat .custom-file-input').val('').next('.custom-file-label').text('Pilih File');
                $('#modalSyarat').modal('hide');
                swal('Berhasil', 'Persyaratan berhasil disimpan', 'success');
            }).fail(function (xhr) {
                swal('Gagal', pesanGagal(xhr, 'Gagal menyimpan persyaratan'), 'error');
            }).always(function () { $btn.prop('disabled', false); });
        });

        // ---------------- muat data awal ----------------
        $(document).ready(async function () {
            try {
                var [prov, master, detail] = await Promise.all([
                    $.get(API + 'provider'),
                    $.get(API + 'master_ruas'),
                    $.get(API + 'detail/' + ID_PERMOHONAN)
                ]);
                prov.data.forEach(function (p) {
                    $('#provider_id').append($('<option>').val(p.provider_id).text(p.provider));
                });
                $('#provider_id').val(detail.data.permohonan.provider_id || '').select2({ theme: 'bootstrap4' });

                master.data.forEach(function (m) {
                    masterRuas[m.id] = m;
                    if (m.luar_ruas) { idRuasLain = m.id; return; }
                    opsiRuas += '<option value="' + m.id + '">' + esc((m.no ? m.no + ' - ' : '') + m.nm_ruas) + '</option>';
                });
                isiTabel(detail.data.ruas);
                tampilDokumen(detail.data.dokumen);
            } catch (xhr) {
                swal('Gagal', pesanGagal(xhr, 'Gagal memuat data'), 'error');
            }
        });

        window.addEventListener('beforeunload', function (e) {
            if (BISA_UBAH && adaPerubahan) { e.preventDefault(); e.returnValue = ''; }
        });

    </script>
</body>
</html>