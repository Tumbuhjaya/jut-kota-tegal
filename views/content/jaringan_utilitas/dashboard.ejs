            line-height: 1.4;
            margin-bottom: 0;
            color: #fff;
        }

        .shortcut-arrow {
            color: rgba(255, 255, 255, 0.7);
            flex-shrink: 0;
            margin-left: 10px;
            transition: all 0.3s;
        }

        .shortcut-card:hover .shortcut-arrow {
            color: #fff;
            transform: translateX(5px);
        }

