        /* Primary Button */
        .btn-gradient {
            /* width: 100%; */
            padding: 0.85rem;
            background: var(--gradient-main);
            background-size: 200% 200%;
            color: #fff;
            border: none;
            border-radius: 12px;
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            cursor: pointer;
            transition: all 0.4s ease;
            box-shadow:
            0 10px 25px -6px rgba(21, 129, 238, 0.55),
            0 0 0 1px rgba(15, 68, 190, 0.25);
            position: relative;
            overflow: hidden;
        }

        .btn-gradient::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.45), transparent);
            transition: left 0.6s ease;
        }

        .btn-gradient:hover {
            color: #fff;
            transform: translateY(-2px);
            background-position: 100% 50%;
            box-shadow:
            0 15px 38px -6px rgba(15, 68, 190, 0.55),
            0 8px 24px -8px rgba(23, 195, 255, 0.6);
        }

        .btn-gradient:hover::before { left: 100%; }
        .btn-gradient:active, .btn-gradient:focus { transform: translateY(0); outline: none; color: #fff; }

        /* Primary Button - Yellow Gradient */
        .btn-gradient-yellow {
            /* width: 100%; */
            padding: 0.85rem;
            /* Gradient dibuat dengan varian warna dari #f7ca18 */
            background: linear-gradient(135deg, #f7ca18 0%, #e6b800 50%, #f7ca18 100%);
            background-size: 200% 200%;
            color: #111; /* Teks gelap agar kontras dan mudah dibaca di atas warna kuning */
            border: none;
            border-radius: 12px;
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            cursor: pointer;
            transition: all 0.4s ease;
            
            /* Bayangan disesuaikan menggunakan warna dasar kuning (#f7ca18) */
            box-shadow:
                0 10px 25px -6px rgba(247, 202, 24, 0.55),
                0 0 0 1px rgba(200, 160, 0, 0.25);
            position: relative;
            overflow: hidden;
        }

        .btn-gradient-yellow::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            /* Efek kilau (shimmer) putih transparan */
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent);
            transition: left 0.6s ease;
        }

        .btn-gradient-yellow:hover {
            color: #111; /* Warna teks tetap gelap saat di-hover */
            transform: translateY(-2px);
            background-position: 100% 50%;
            
            /* Bayangan hover disesuaikan */
            box-shadow:
                0 15px 38px -6px rgba(247, 202, 24, 0.6),
                0 8px 24px -8px rgba(255, 223, 77, 0.7);
        }

        .btn-gradient-yellow:hover::before { 
            left: 100%; 
        }

        .btn-gradient-yellow:active, 
        .btn-gradient-yellow:focus { 
            transform: translateY(0); 
            outline: none; 
            color: #111; 
        }
        
