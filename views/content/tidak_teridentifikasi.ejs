    <!-- ============================================================ -->
    <!-- MODAL EDIT PENGAKU (Tiang & Kabel)                          -->
    <!-- ============================================================ -->
    <div class="modal fade" id="modalPengaku" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" style="color:#000;">
                        <i class="fas fa-edit"></i> Verifikasi Pemilik Utilitas
                        <small id="pengaku-label-type" class="text-muted"></small>
                    </h5>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="pengaku-id">
                    <input type="hidden" id="pengaku-type">
                    <input type="hidden" id="pengaku-no">
                    <div class="form-group">
                        <label style="color:#000;">Provider</label>
                        <select id="pengaku-value" class="form-control">
                            <option value="">-- Pilih Provider --</option>
                            <% (providers || []).forEach(function(p) { %>
                                <option value="<%= p.provider_id %>"><%= p.provider %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Batal</button>
                    <button type="button" class="btn btn-primary" id="btn-save-pengaku">
                        <i class="fas fa-save"></i> Simpan
                    </button>
                </div>
            </div>
        </div>
    </div>

    <% include ../template/footer.ejs %>
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <script src="<%= rooturl %>/javascripts/template/bootstrap.bundle.js"></script>
    <script src="https://cdn.canvasjs.com/canvasjs.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/js/select2.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.22/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.22/js/dataTables.bootstrap4.min.js"></script>
    <script src="<%= rooturl %>/plugins/slick/slick.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js"></script>

    <script type="text/javascript">
    var rooturl = '';

    // Deklarasi global — supaya bisa diakses dari dalam maupun luar ready
    var data_table = null;
    var data_table_kabel = null;

    $(document).ready(function () {
        $('.autocomplete').select2({ theme: 'bootstrap4' });

        /* =========================================================
           LOADER FILTER
           ========================================================= */
        loadKecamatan();
        loadKondisi();

        $('#filter-kecamatan').on('change', function () {
            loadKelurahan($(this).val());
        });

        $('#btn-filter').on('click', function (e) {
            e.preventDefault();
            if (data_table)       data_table.ajax.reload(null, true);
            if (data_table_kabel) data_table_kabel.ajax.reload(null, true);
        });

        $('#btn-reset').on('click', function (e) {
            e.preventDefault();
            $('#filter-kecamatan').val('').trigger('change');
            $('#filter-kondisi').val('').trigger('change');
            $('#filter-search').val('');
            $('#filter-kelurahan').html('<option value="">-- Pilih --</option>').trigger('change.select2');
            if (data_table)       data_table.ajax.reload(null, true);
            if (data_table_kabel) data_table_kabel.ajax.reload(null, true);
        });

        /* =========================================================
           DATATABLE — TIANG
           ========================================================= */
        data_table = $('#list-data').DataTable({
            "processing": true,
            "language": {
                "sProcessing": "Sedang memproses...",
                "sLengthMenu": "_MENU_",
                "sZeroRecords": "Tidak ditemukan data yang sesuai",
                "sInfo": "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
                "sInfoEmpty": "Menampilkan 0 sampai 0 dari 0 entri",
                "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
                "oPaginate": { "sFirst": "Pertama", "sPrevious": "Sebelumnya", "sNext": "Selanjutnya", "sLast": "Terakhir" }
            },
            "ajax": {
                "url": "/api/list_tiang",
                "type": "POST",
                "data": function (d) {
                    d.kd_kec  = $('#filter-kecamatan').val() || '';
                    d.kd_kel  = $('#filter-kelurahan').val() || '';
                    d.kondisi = $('#filter-kondisi').val()   || '';
                    d.search  = $('#filter-search').val()    || '';
                    d.only_unidentified = 1;
                    d.shape   = 1;
                },
                "dataSrc": function (json) { return (json && json.data) ? json.data : []; }
            },
            "columns": [
                { "data": null, "orderable": false, "className": "text-center" },
                { "data": "nm_ruas",    "defaultContent": "-" },
                { "data": "kecamatan",  "defaultContent": "-" },
                { "data": "desa",       "defaultContent": "-" },
                { "data": "provider",   "defaultContent": "-" },
                { "data": "jumlah_tia", "defaultContent": "0" },
                { "data": "kondisi",    "defaultContent": "-" },
                { "data": "ciri_tiang", "defaultContent": "-" },
                { "data": "kd_foto_1",  "orderable": false, "render": renderFoto },
                { "data": "kd_foto_2",  "orderable": false, "render": renderFoto },
                { "data": "kd_foto_3",  "orderable": false, "render": renderFoto },
                {
                    "data": null, "orderable": false, "className": "text-center",
                    "render": function (data, type, row) {
                        var url = googleMapsUrl(row);
                        var mapsBtn = url
                            ? '<a href="' + url + '" target="_blank" rel="noopener" class="btn btn-primary btn-sm" title="Buka di Google Maps"><i class="fas fa-location-arrow"></i></a>'
                            : '<button class="btn btn-secondary btn-sm" disabled title="Koordinat tidak tersedia"><i class="fas fa-location-arrow"></i></button>';

                        var editBtn = '';
                        if (row.provider === 'Tidak Teridentifikasi') {
                            editBtn = '<button class="btn btn-warning btn-sm ml-1 btn-edit-pengaku"'
                                    + ' data-id="' + row.id + '"'
                                    + ' data-pengaku="' + (row.pengaku != null ? row.pengaku : '') + '"'
                                    + ' data-no="' + (row.no != null ? row.no : '') + '"'
                                    + ' data-type="tiang"'
                                    + ' title="Edit Pengaku (Assign Provider)">'
                                    + '<i class="fas fa-edit"></i></button>';
                        }
                        return '<div style="width:100%;display:flex;justify-content:center;">' + mapsBtn + editBtn + '</div>';
                    }
                }
            ],
            "columnDefs": [ { "width": "40px", "targets": 0 } ],
            "drawCallback": function () {
                var api = this.api();
                var info = api.page.info();
                api.column(0, { page: 'current' }).nodes().each(function (cell, i) {
                    cell.innerHTML = (i + 1 + info.start) + '.';
                });
                if (window.Fancybox && Fancybox.bind) {
                    Fancybox.bind("[data-fancybox]", {});
                }
            }
        });

        /* =========================================================
           DATATABLE — KABEL
           ========================================================= */
        data_table_kabel = $('#list-data-kabel').DataTable({
            "processing": true,
            "language": {
                "sProcessing": "Sedang memproses...",
                "sLengthMenu": "_MENU_",
                "sZeroRecords": "Tidak ditemukan data yang sesuai",
                "sInfo": "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
                "sInfoEmpty": "Menampilkan 0 sampai 0 dari 0 entri",
                "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
                "oPaginate": { "sFirst": "Pertama", "sPrevious": "Sebelumnya", "sNext": "Selanjutnya", "sLast": "Terakhir" }
            },
            "ajax": {
                "url": "/api/list_kabel",
                "type": "POST",
                "data": function (d) {
                    d.kd_kec = $('#filter-kecamatan').val() || '';
                    d.kd_kel = $('#filter-kelurahan').val() || '';
                    d.search = $('#filter-search').val()    || '';
                    d.only_unidentified = 1;
                    d.shape  = 1;
                },
                "dataSrc": function (json) { return (json && json.data) ? json.data : []; }
            },
            "columns": [
                { "data": null, "orderable": false, "className": "text-center" },
                { "data": "nm_ruas",   "defaultContent": "-" },
                { "data": "kecamatan", "defaultContent": "-" },
                { "data": "desa",      "defaultContent": "-" },
                { "data": "jumlah",    "defaultContent": "0" },
                { "data": "panjang",   "defaultContent": "0" },
                { "data": "kode_foto",   "orderable": false, "render": renderFoto },
                { "data": "kode_fot_1", "orderable": false, "render": renderFoto },
                {
                    "data": null, "orderable": false, "className": "text-center",
                    "render": function (data, type, row) {
                        var url = googleMapsUrl(row);
                        var mapsBtn = url
                            ? '<a href="' + url + '" target="_blank" rel="noopener" class="btn btn-primary btn-sm" title="Buka di Google Maps"><i class="fas fa-location-arrow"></i></a>'
                            : '<button class="btn btn-secondary btn-sm" disabled title="Koordinat tidak tersedia"><i class="fas fa-location-arrow"></i></button>';

                        var editBtn = '';
                        if (row.provider === 'Tidak Teridentifikasi') {
                            editBtn = '<button class="btn btn-warning btn-sm ml-1 btn-edit-pengaku"'
                                    + ' data-id="' + row.id + '"'
                                    + ' data-pengaku="' + (row.pengaku != null ? row.pengaku : '') + '"'
                                    + ' data-no="' + (row.no != null ? row.no : '') + '"'
                                    + ' data-type="kabel"'
                                    + ' title="Edit Pemilik Utilitas (Assign Provider)">'
                                    + '<i class="fas fa-edit"></i></button>';
                        }
                        return '<div style="width:100%;display:flex;justify-content:center;">' + mapsBtn + editBtn + '</div>';
                    }
                }
            ],
            "columnDefs": [ { "width": "40px", "targets": 0 } ],
            "drawCallback": function () {
                var api = this.api();
                var info = api.page.info();
                api.column(0, { page: 'current' }).nodes().each(function (cell, i) {
                    cell.innerHTML = (i + 1 + info.start) + '.';
                });
                if (window.Fancybox && Fancybox.bind) {
                    Fancybox.bind("[data-fancybox]", {});
                }
            }
        });

        /* =========================================================
           MODAL EDIT PENGAKU — Tiang & Kabel
           ========================================================= */
        $(document).on('click', '.btn-edit-pengaku', function () {
            var id      = $(this).data('id');
            var pengaku = $(this).data('pengaku');
            var no      = $(this).data('no');
            var type    = $(this).data('type') || 'tiang';

            $('#pengaku-id').val(id);
            $('#pengaku-no').val(no);
            $('#pengaku-type').val(type);
            $('#pengaku-value').val(pengaku != null && pengaku !== '' ? String(pengaku) : '');
            $('#pengaku-label-type').text(type === 'kabel' ? '(Kabel)' : '(Tiang)');

            $('#modalPengaku').modal('show');
        });

        $('#btn-save-pengaku').on('click', function () {
            var id      = $('#pengaku-id').val();
            var pengaku = $('#pengaku-value').val();
            var type    = $('#pengaku-type').val() || 'tiang';
            if (!id) return;

            var $btn = $(this);
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');
console.log({ id: id, pengaku: pengaku, type: type });

            $.ajax({
                url: '/api/update_pengaku',
                type: 'POST',
                dataType: 'json',
                data: { id: id, pengaku: pengaku, type: type },
                success: function (res) {
                    // Toleran terhadap status string maupun number
                    if (res && (Number(res.status) === 200 || res.success === true)) {
                        swal('Berhasil', 'Pengaku berhasil diperbarui', 'success');
                        $('#modalPengaku').modal('hide');

                        // *** Reset paging ke halaman 1 supaya tabel tidak kosong ***
                        if (type === 'kabel') {
                            if (data_table_kabel) data_table_kabel.ajax.reload(null, true);
                        } else {
                            if (data_table) data_table.ajax.reload(null, true);
                        }
                    } else {
                        swal('Gagal', (res && res.message) ? res.message : 'Terjadi kesalahan', 'error');
                    }
                },
                error: function (xhr) {
                    console.error('Update pengaku error:', xhr && xhr.responseText);
                    swal('Gagal', 'Tidak dapat menghubungi server', 'error');
                },
                complete: function () {
                    $btn.prop('disabled', false).html('<i class="fas fa-save"></i> Simpan');
                }
            });
        });
    });

    /* =========================================================
       HELPER FUNCTIONS
       ========================================================= */
    function loadKecamatan() {
        $.get('/get_kec', function (res) {
            var opts = '<option value="">-- Pilih --</option>';
            (res.data || []).forEach(function (k) {
                opts += '<option value="' + k.id_kec + '" data-kecid="' + k.kec_id + '">' + k.kecamatan + '</option>';
            });
            $('#filter-kecamatan').html(opts).trigger('change.select2');
        });
    }

    function loadKelurahan(kecId) {
        var opts = '<option value="">-- Pilih --</option>';
        if (!kecId) {
            $('#filter-kelurahan').html(opts).trigger('change.select2');
            return;
        }
        $.get('/get_kel/' + kecId, function (res) {
            (res.data || []).forEach(function (k) {
                opts += '<option value="' + k.id + '">' + k.desa + '</option>';
            });
            $('#filter-kelurahan').html(opts).trigger('change.select2');
        });
    }

    function loadKondisi() {
        $.get('/dis/kondisi/tiang', function (res) {
            var opts = '<option value="">-- Pilih --</option>';
            (res.data || []).forEach(function (d) {
                var v = d.kondisi;
                if (v) opts += '<option value="' + v + '">' + v + '</option>';
            });
            $('#filter-kondisi').html(opts).trigger('change.select2');
        });
    }

    function renderFoto(kode, type, row) {
        if (!kode) return '-';
        var url = 'https://storage.googleapis.com/jut-tegal/' + kode;
        return '<a href="' + url + '" data-fancybox="galeri-' + row.id + '">'
             +   '<img src="' + url + '" alt="foto" style="width:150px;height:200px;object-fit:cover;">'
             + '</a>';
    }

    function googleMapsUrl(row) {
        if (row.lat && row.lng) return 'https://www.google.com/maps?q=' + row.lat + ',' + row.lng;
        var q = [row.nm_ruas, row.desa, row.kecamatan, 'Tegal'].filter(Boolean).join(', ');
        if (q) return 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(q);
        return null;
    }
    </script>
</body>
</html>