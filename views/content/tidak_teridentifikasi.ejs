                                                                    <th rowspan="2">Option</th>
                                                                </tr>
                                                                <tr>
                                                                    <th>Foto 1</th>
                                                                    <th>Foto 2</th>
                                                                    <th>Foto 3</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody id="tbody-tiang"></tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
