    </header>

    <section class="mt-5 mb-5">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="shortcut-card">
                        <div class="shortcut-content">
                            <div class="row">
                                <div class="col-12">
                                    <h6 style="font-size:24px"><strong>Data <span style="color:#f7ca18;">Utilitas Tidak Teridentifikasi</span></strong></h6>
                                    <hr>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12">
                                    <div style="background:rgba(255,255,255,.12);padding:15px;border-radius:10px;">
                                        <div class="row">
                                            <div class="col-lg-4">
                                                <div class="form-group">
                                                    <label>Kecamatan</label>
                                                    <select id="filter-kecamatan" class="form-control autocomplete"><option value="">-- Pilih --</option></select>
                                                </div>
                                            </div>
                                            <div class="col-lg-4">
                                                <div class="form-group">
                                                    <label>Kelurahan</label>
                                                    <select id="filter-kelurahan" class="form-control autocomplete"><option value="">-- Pilih --</option></select>
                                                </div>
                                            </div>
                                            <div class="col-lg-4">
                                                <div class="form-group">
                                                    <label>Kondisi</label>
                                                    <select id="filter-kondisi" class="form-control autocomplete"><option value="">-- Pilih --</option></select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-12">
                                                <div class="form-group mb-0">
                                                    <label for="filter-search">Pencarian</label>
                                                    <div class="input-group">
                                                        <div class="input-group-prepend"><span class="input-group-text"><i class="fas fa-search"></i></span></div>
                                                        <input type="text" id="filter-search" class="form-control" placeholder="Cari ruas / kecamatan / kelurahan ...">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12">
                                                <button class="btn btn-warning" id="btn-filter"><i class="fas fa-filter"></i> Filter Data</button>
                                                <button class="btn btn-secondary" id="btn-reset"><i class="fas fa-sync"></i> Reset</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-3">
                                <div class="col-12">
                                    <ul class="nav nav-tabs justify-content-center" id="myTab" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <a class="nav-link active" id="home-tab" data-toggle="tab" href="#home" role="tab" aria-controls="home" aria-selected="true" style="color:#f7ca18;font-weight:bold;">Tiang</a>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <a class="nav-link" id="profile-tab" data-toggle="tab" href="#profile" role="tab" aria-controls="profile" aria-selected="false">Kabel</a>
                                        </li>
                                    </ul>
                                    <div class="tab-content" id="myTabContent">
                                        <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">
                                            <div class="row">
                                                <div class="col-12">
                                                    <div class="table-responsive">
                                                        <table class="table table-bordered table-striped table-hover table-primary" id="list-data">
                                                            <thead>
                                                                <tr>
                                                                    <th rowspan="2">No.</th>
                                                                    <th rowspan="2">Ruas Jalan</th>
                                                                    <th rowspan="2">Kecamatan</th>
                                                                    <th rowspan="2">Kelurahan</th>
                                                                    <th rowspan="2">Provider</th>
                                                                    <th rowspan="2">Jumlah</th>
                                                                    <th rowspan="2">Kondisi</th>
                                                                    <th rowspan="2">Keterangan</th>
