                                                <div class="col-12">
                                                    <div class="table-responsive">
                                                        <table class="table table-bordered table-striped table-hover table-primary" id="list-data-kabel">
                                                            <thead>
                                                                <tr>
                                                                    <th>No.</th>
                                                                    <th>Ruas Jalan</th>
                                                                    <th>Kecamatan</th>
                                                                    <th>Kelurahan</th>
                                                                    <th>Jumlah</th>
                                                                    <th>Panjang</th>
                                                                    <th>Foto Dokumentasi</th>
                                                                    <th>Foto Dokumentasi</th>
                                                                    <th>Option</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody id="tbody-kabel"></tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
