    <style type="text/css">
        :root {
            --navy: #0d4aa2;
            --royal: #0f44be;
            --blue: #1256d7;
            --bright: #1581ee;
            --cyan: #17c3ff;

            --gradient-main: linear-gradient(135deg,
            #0d4aa2 0.000%,
            #0f44be 25.000%,
            #1256d7 50.000%,
            #1581ee 75.000%,
            #17c3ff 100.000%);
        }

        * { font-family: 'Plus Jakarta Sans', sans-serif; }

        /* ================================================================
            BODY
            ================================================================ */
        html, body { height: 100%; }

        body {
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
            padding: 20px 15px;
            background: var(--gradient-main);
            background-size: 200% 200%;
            animation: gradientShift 15s ease infinite;
            background-attachment: fixed;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        @keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        /* ============================================================
            PERSPECTIVE GRID
            ============================================================ */
        body::before {
            content: '';
            position: fixed;
            top: 0; right: 0; bottom: 0; left: 0;
            z-index: 0;
            pointer-events: none;
            opacity: 0.4;
            background-image:
            repeating-linear-gradient(0deg, rgba(255,255,255,0.55) 0px, rgba(255,255,255,0.55) 1px, transparent 1px, transparent 60px),
            repeating-linear-gradient(90deg, rgba(255,255,255,0.45) 0px, rgba(255,255,255,0.45) 1px, transparent 1px, transparent 60px);
            background-size: 60px 60px, 60px 60px;
            background-position: center center;
            transform: perspective(500px) rotateX(45deg);
            transform-origin: center 70%;
            animation: gridPerspective 20s linear infinite;
            -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
            mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
        }

        @keyframes gridPerspective {
            from { background-position: center 0, center center; }
            to { background-position: center 60px, center center; }
        }

        /* ============================================================
            GLOWING NODES
            ============================================================ */
        body::after {
            content: '';
            position: fixed;
            top: 0; right: 0; bottom: 0; left: 0;
            z-index: 0;
            pointer-events: none;
            opacity: 0.55;
            background-image:
            radial-gradient(circle, #17c3ff 1.8px, transparent 1.8px),
            radial-gradient(circle, rgba(255, 255, 255, 0.9) 1.2px, transparent 1.2px);
            background-size: 60px 60px, 60px 60px;
            background-position: 0 0, 30px 30px;
            transform: perspective(500px) rotateX(45deg);
            transform-origin: center 70%;
            animation: gridPerspective 20s linear infinite, dotPulse 2.5s ease-in-out infinite;
            -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
            mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
        }

        @keyframes dotPulse {
            0%, 100% { opacity: 0.5; }
            50% { opacity: 0.9; }
        }

        /* Fiber optic glow */
        .fiber-glow {
            position: fixed;
            top: 0; right: 0; bottom: 0; left: 0;
            z-index: 0;
            pointer-events: none;
            opacity: 0.35;
            background:
            linear-gradient(115deg, transparent 0%, transparent 40%, rgba(23, 195, 255, 0.4) 45%, rgba(23, 195, 255, 0.6) 48%, rgba(255, 255, 255, 0.7) 50%, rgba(13, 74, 162, 0.6) 52%, rgba(13, 74, 162, 0.4) 55%, transparent 60%, transparent 100%),
            linear-gradient(115deg, transparent 0%, transparent 30%, rgba(13, 74, 162, 0.3) 35%, rgba(255, 255, 255, 0.5) 38%, rgba(23, 195, 255, 0.3) 42%, transparent 50%);
            background-size: 300% 300%, 300% 300%;
            background-position: 0% 0%, 100% 100%;
            animation: fiberSweep 12s ease-in-out infinite;
        }

        @keyframes fiberSweep {
            0%, 100% { background-position: 0% 0%, 100% 100%; }
            50% { background-position: 100% 100%, 0% 0%; }
        }

        /* Pulse orbs */
        .pulse-node {
            position: fixed;
            border-radius: 50%;
            filter: blur(100px);
            pointer-events: none;
            z-index: 0;
        }
        .pulse-node-1 {
            width: 500px; height: 500px;
            background: radial-gradient(circle, #17c3ff 0%, transparent 70%);
            top: -180px; left: -180px;
            opacity: 0.5;
            animation: pulse 8s ease-in-out infinite;
        }
        .pulse-node-2 {
            width: 450px; height: 450px;
            background: radial-gradient(circle, #0d4aa2 0%, transparent 70%);
            bottom: -150px; right: -150px;
            opacity: 0.45;
            animation: pulse 8s ease-in-out infinite;
            animation-delay: 4s;
        }
        .pulse-node-3 {
            width: 320px; height: 320px;
            background: radial-gradient(circle, #1581ee 0%, transparent 70%);
            top: 40%; right: 15%;
            opacity: 0.3;
            animation: pulse 10s ease-in-out infinite;
            animation-delay: 2s;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.45; }
            50% { transform: scale(1.35); opacity: 0.7; }
        }

        /* ============================================================
            MENU WRAPPER
            ============================================================ */
        .menu-wrapper {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 1000px;
            padding: 0 15px;
        }

        /* Header (logo + judul) */
        .menu-header {
            text-align: center;
            margin-bottom: 40px;
            color: #fff;
        }

        .menu-brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .brand-logo {
            width: 52px;
            height: 52px;
            background: rgba(255, 255, 255, 0.22);
            -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
            border-radius: 14px;
            border: 1.5px solid rgba(255, 255, 255, 0.45);
            box-shadow: 0 8px 22px rgba(23, 195, 255, 0.5), inset 0 0 20px rgba(255, 255, 255, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .brand-logo::before {
            content: '';
            position: absolute;
            top: 8px; right: 8px;
            width: 8px; height: 8px;
            background: #17c3ff;
            border-radius: 50%;
            box-shadow: 0 0 10px #17c3ff;
            animation: ping 2s ease-in-out infinite;
        }

        @keyframes ping {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(1.4); }
        }

        .brand-name {
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            text-shadow: 0 2px 20px rgba(13, 74, 162, 0.5);
        }

        .menu-title {
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            margin-bottom: 8px;
            text-shadow: 0 2px 24px rgba(13, 74, 162, 0.5);
        }

        .menu-subtitle {
            font-size: 0.95rem;
            opacity: 0.9;
            margin-bottom: 0;
        }

        /* ============================================================
            SHORTCUT CARD
            ============================================================ */
        .shortcut-card {
            display: flex;
            align-items: center;
            height: 100%;
            width: 100%;
            background: rgba(255, 255, 255, 0.12);
            -webkit-backdrop-filter: blur(20px);
            backdrop-filter: blur(20px);
            border: 1.5px solid rgba(255, 255, 255, 0.3);
            border-radius: 18px;
            padding: 20px 22px;
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            text-decoration: none;
            color: #fff;
            box-shadow:
            0 10px 30px -10px rgba(13, 74, 162, 0.5),
            inset 0 0 0 1px rgba(255, 255, 255, 0.05);
            position: relative;
            overflow: hidden;
            min-height: 100px;
        }

        .shortcut-card::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
            transition: left 0.6s ease;
        }

        .shortcut-card:hover::before { left: 100%; }

        .shortcut-card:hover {
            transform: translateY(-6px);
            background: rgba(255, 255, 255, 0.22);
            border-color: rgba(255, 255, 255, 0.55);
            color: #fff;
            text-decoration: none;
            box-shadow:
            0 25px 45px -12px rgba(13, 74, 162, 0.7),
            0 0 40px -5px rgba(23, 195, 255, 0.7),
            inset 0 0 0 1px rgba(255, 255, 255, 0.15);
        }

        .shortcut-card:focus {
            outline: none;
            color: #fff;
            text-decoration: none;
            box-shadow:
            0 0 0 4px rgba(23, 195, 255, 0.35),
            0 25px 45px -12px rgba(13, 74, 162, 0.7);
        }

        .shortcut-icon {
            width: 56px;
            height: 56px;
            background: rgba(255, 255, 255, 0.22);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            border: 1.5px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 8px 20px rgba(23, 195, 255, 0.4);
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            margin-right: 18px;
        }

        .shortcut-card:hover .shortcut-icon {
            transform: scale(1.12) rotate(-6deg);
            background: rgba(255, 255, 255, 0.38);
            box-shadow: 0 10px 26px rgba(23, 195, 255, 0.7);
        }

        .shortcut-content { flex: 1; min-width: 0; }

        .shortcut-title {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 4px;
            letter-spacing: -0.01em;
            color: #fff;
            line-height: 1.2;
        }

        .shortcut-desc {
            font-size: 0.85rem;
            opacity: 0.85;
            line-height: 1.4;
            margin-bottom: 0;
            color: #fff;
        }

        .shortcut-arrow {
            color: rgba(255, 255, 255, 0.7);
            flex-shrink: 0;
            margin-left: 10px;
            transition: all 0.3s;
        }

        .shortcut-card:hover .shortcut-arrow {
            color: #fff;
            transform: translateX(5px);
        }

        /* Footer */
        .menu-footer {
            text-align: center;
            margin-top: 40px;
            font-size: 0.8rem;
            color: rgba(255, 255, 255, 0.8);
        }

        /* RESPONSIVE */
        @media (max-width: 575.98px) {
            body { padding: 25px 10px; }
            .menu-wrapper { padding: 0 5px; }
            .menu-title { font-size: 1.7rem; }
            .brand-name { font-size: 1.35rem; }
            .brand-logo { width: 46px; height: 46px; }
            .menu-header { margin-bottom: 28px; }
            .menu-footer { margin-top: 28px; }
            .shortcut-card { padding: 16px 18px; min-height: 90px; }
            .shortcut-icon { width: 48px; height: 48px; margin-right: 14px; }
            .shortcut-title { font-size: 1rem; }
            .shortcut-desc { font-size: 0.78rem; }
        }
    </style>
</head>

