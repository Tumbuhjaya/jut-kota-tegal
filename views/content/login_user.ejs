                                <%-captcha.data%>
                            </div> 
                            <input type="text" class="form-control" id="captcha" name="captcha" placeholder="Isi dengan hasil penjumlahan captcha" required style="border-top-left-radius: 0;border-top-right-radius: 0;">
                            <div class="invalid-feedback">
                                Silahkan isi captcha
                            </div>
                        </div>
                                <!-- <button type="submit" class="btn btn-gradient mb-4">Sign In</button> -->
                                 <!-- <a href="/shortcut" class="btn btn-gradient mb-4">Sign In</a> -->
                            <button type="submit" class="btn btn-gradient mb-4">
                                Sign In
                            </button>

                                <!-- <p class="text-center small text-muted mb-0">
                                Belum punya akun? <a href="#" class="signup-link">Daftar sekarang</a>
                                </p> -->

                            </form>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
    <% include ../template/footer.ejs %>
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <script src="<%= rooturl %>/javascripts/template/bootstrap.bundle.js"></script>
    <!-- Plugins This Page -->
    <script src="https://cdn.canvasjs.com/canvasjs.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/js/select2.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.22/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.22/js/dataTables.bootstrap4.min.js"></script>
    <script src="<%= rooturl %>/plugins/slick/slick.min.js"></script>
    <!-- End Plugins This Page -->
    <script type="text/javascript">
        var rooturl = ''
        var perusahaanTermuat = false

        // Perusahaan: username + password. Vendor: username + perusahaan + password.
        function pilihLogin(jenis) {
            $('.login-tab button').removeClass('active')
            $('.login-tab button[data-login=' + jenis + ']').addClass('active')
            $('#login_sebagai').val(jenis)
            var vendor = jenis === 'vendor'
            $('#wrap_perusahaan').toggle(vendor)
            $('#perusahaan_id').prop('required', vendor)
            try { localStorage.setItem('login_sebagai', jenis) } catch (e) {}
            if (vendor && !perusahaanTermuat) {
                $.get(rooturl + '/autentifikasi/list_perusahaan', function (res) {
                    perusahaanTermuat = true
                    ;(res.data || []).forEach(function (p) {
                        $('#perusahaan_id').append($('<option>').val(p.perusahaan_id).text(p.nama_perusahaan))
                    })
                })
            }
        }
        try { if (localStorage.getItem('login_sebagai') === 'vendor') pilihLogin('vendor') } catch (e) {}

         function togglePassword() {
            var input = document.getElementById('password');
            var icon = document.getElementById('eye-icon');
            if (input.type === 'password') {
            input.type = 'text';
            icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
            } else {
            input.type = 'password';
            icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
            }
        }
        
        let data_table  =$('#list-data').DataTable({
            "language": {
                "sProcessing":   "Sedang memproses...",
                "sLengthMenu":   "_MENU_",
                "sZeroRecords":  "Tidak ditemukan data yang sesuai",
                "sInfo":         "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
                "sInfoEmpty":    "Menampilkan 0 sampai 0 dari 0 entri",
                "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
                "sInfoPostFix":  "",
                "sUrl":          "",
                "oPaginate": {
                    "sFirst":    "Pertama",
                    "sPrevious": "Sebelumnya",
                    "sNext":     "Selanjutnya",
                    "sLast":     "Terakhir"
                }
            },
            // "processing": true,
            // "ajax":  `${rooturl}`,
            // "columns": [
            //     { "data": null},
            // ],
            // "columnDefs": [
            //     { "width": "40px", "targets": 0},
            // ],
        });

        data_table.on( 'draw.dt', function () {
            let PageInfo = $('#list-data').DataTable().page.info();
            data_table.column(0, { page: 'current' }).nodes().each( function (cell, i) {
                cell.innerHTML = i + 1 + PageInfo.start;
            });
        });
    </script>
</body>
</html>