                        <div class="col-lg-6">
                            <div class="form-side">
                            <div class="mb-4">
                                <h2 class="form-title">Sign In</h2>
                                <p class="text-muted small mb-0">Masukkan username dan password yang Anda miliki</p>
                            </div>

                    <form method="POST" action="<%= rooturl %>/autentifikasi/login" class="needs-validation" novalidate="">

                                <% if (typeof pesan !== 'undefined' && pesan && pesan.length) { %>
                                <div class="alert alert-danger small" role="alert"><%= pesan %></div>
                                <% } %>

                                <div class="login-tab mb-4" role="tablist">
                                    <button type="button" class="active" data-login="perusahaan" onclick="pilihLogin('perusahaan')">Perusahaan</button>
                                    <button type="button" data-login="vendor" onclick="pilihLogin('vendor')">Vendor</button>
                                </div>
                                <input type="hidden" name="login_sebagai" id="login_sebagai" value="perusahaan"/>

                                <div class="form-group mb-3">
                                <label for="email" class="form-label-custom">Username</label>
                                <div class="input-icon-wrapper">
                                    <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="4" width="20" height="16" rx="2"/>
                                    <path d="M2 7l10 6 10-6"/>
                                    </svg>
                                    <input type="email" class="form-control" id="email" name="username" placeholder="Masukkan username" required>
                                </div>
                                </div>
                                                            <input type="hidden" name="tujuan" class="form-control" value="/shortcut"/>

                                <div class="form-group mb-3" id="wrap_perusahaan" style="display:none;">
                                <label for="perusahaan_id" class="form-label-custom">Perusahaan</label>
                                <select class="form-control" id="perusahaan_id" name="perusahaan_id">
                                    <option value="">-- Pilih perusahaan mitra --</option>
                                </select>
                                </div>

                                <div class="form-group mb-3">
                                <label for="password" class="form-label-custom">Password</label>
                                <div class="input-icon-wrapper">
                                    <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4"/>
                                    <path d="M14 13.12c0 2.38 0 6.38-1 8.88"/>
                                    <path d="M17.29 21.02c.12-.6.43-2.3.5-3.02"/>
                                    <path d="M2 12a10 10 0 0 1 18-6"/>
                                    <path d="M2 16h.01"/>
                                    <path d="M21.8 16c.2-2 .131-5.354 0-6"/>
                                    <path d="M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2"/>
                                    <path d="M8.65 22c.21-.66.45-1.32.57-2"/>
                                    <path d="M9 6.8a6 6 0 0 1 9 5.2v2"/>
                                    </svg>
                                    <input type="password" class="form-control" id="password" name="password" placeholder="Masukkan password" required>
                                    <button type="button" class="toggle-password" onclick="togglePassword()" aria-label="Toggle password">
                                    <svg id="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                    </button>
                                </div>
                                </div>
<div class="form-group">
