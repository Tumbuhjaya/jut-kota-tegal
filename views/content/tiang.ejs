            color: #fff;
            transform: translateX(5px);
        }

        /* ============================================================
            SHORTCUT CARD
            ============================================================ */
        .shortcut-card {
            display: flex;
            align-items: center;
            /* height: 100%; */
            /* width: 100%; */
            background: rgba(255, 255, 255, 0.12);
