    <script type="text/javascript">
       var rooturl = '';

$(document).ready(function () {
    // Init Select2
    $('.autocomplete').select2({ theme: 'bootstrap4' });

    // Load filter dari API
    loadKecamatan();
    loadKondisi();
    loadTiang(); // load awal

    // Event: kecamatan berubah → load kelurahan
    $('#filter-kecamatan').on('change', function () {
        loadKelurahan($(this).val());
    });

    // Event: tombol filter
    $('#btn-filter').on('click', function (e) {
        e.preventDefault();
        data_table.ajax.reload();
    });

    // Event: tombol reset
    $('#btn-reset').on('click', function (e) {
        e.preventDefault();
        $('#filter-kecamatan').val('').trigger('change');
        $('#filter-kondisi').val('').trigger('change');
        $('#filter-kelurahan').html('<option value="">-- Pilih --</option>')
            .trigger('change.select2');
        data_table.ajax.reload();
    });
});

/* =========================================================
   LOAD FILTER DARI API
   ========================================================= */

function loadKecamatan() {
    $.get('/get_kec', function (res) {
        let opts = '<option value="">-- Pilih --</option>';
        (res.data || []).forEach(function (k) {
            opts += `<option value="${k.id_kec}" data-kecid="${k.kec_id}">${k.kecamatan}</option>`;
        });
        $('#filter-kecamatan').html(opts).trigger('change.select2');
    });
}

function loadKelurahan(kecId) {
    let opts = '<option value="">-- Pilih --</option>';
    if (!kecId) {
        $('#filter-kelurahan').html(opts).trigger('change.select2');
        return;
    }
    // /get_kel/:id → id = kec_id (lihat route di express)
    $.get('/get_kel/' + kecId, function (res) {
        (res.data || []).forEach(function (k) {
            opts += `<option value="${k.id}">${k.desa}</option>`;
        });
        $('#filter-kelurahan').html(opts).trigger('change.select2');
    });
}

function loadKondisi() {
    // sesuai permintaan: /dis/:d/:t → d = kondisi, t = tiang
    $.get('/dis/kondisi/tiang', function (res) {
        let opts = '<option value="">-- Pilih --</option>';
        (res.data || []).forEach(function (d) {
            let v = d.kondisi;
            if (v) opts += `<option value="${v}">${v}</option>`;
        });
        $('#filter-kondisi').html(opts).trigger('change.select2');
    });
}

/* =========================================================
   DATATABLE — LOAD TIANG BERDASARKAN FILTER
   ========================================================= */

function renderFoto(kode, type, row) {
    if (!kode) return '-';
    let url = 'https://storage.googleapis.com/jut-tegal/' + kode;
    return `<a href="${url}" data-fancybox="galeri-${row.id}">
                <img src="${url}" alt="foto" style="width:150px;height:200px;object-fit:cover;">
            </a>`;
}
function googleMapsUrl(row) {
    // Prioritas 1: koordinat dari SHAPE
    if (row.lat && row.lng) {
        return 'https://www.google.com/maps?q=' + row.lat + ',' + row.lng;
    }
    // Prioritas 2: fallback cari berdasarkan alamat (ruas + kelurahan + kecamatan)
    let q = [row.nm_ruas, row.desa, row.kecamatan, 'Tegal']
        .filter(Boolean).join(', ');
    if (q) {
        return 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(q);
    }
    return null;
}
let data_table = $('#list-data').DataTable({
    "processing": true,
    "language": {
        "sProcessing":   "Sedang memproses...",
        "sLengthMenu":   "_MENU_",
        "sZeroRecords":  "Tidak ditemukan data yang sesuai",
        "sInfo":         "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
        "sInfoEmpty":    "Menampilkan 0 sampai 0 dari 0 entri",
        "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
        "oPaginate": {
            "sFirst":    "Pertama",
            "sPrevious": "Sebelumnya",
            "sNext":     "Selanjutnya",
            "sLast":     "Terakhir"
        }
    },
    "ajax": {
        "url": "/api/list_tiang",
        "type": "POST",
        "data": function (d) {
            d.kd_kec  = $('#filter-kecamatan').val() || '';
            d.kd_kel  = $('#filter-kelurahan').val() || '';
            d.kondisi = $('#filter-kondisi').val()   || '';
              d.search  = $('#filter-search').val()    || '';   

            d.shape=1
        },
        "dataSrc": function (json) {
            return (json && json.data) ? json.data : [];
        }
    },
    "columns": [
    { "data": null, "orderable": false, "className": "text-center" },
        { "data": "kode_gps",   "defaultContent": "-" },   
    { "data": "nm_ruas",    "defaultContent": "-" },
    { "data": "kecamatan",  "defaultContent": "-" },
    { "data": "desa",       "defaultContent": "-" },
    { "data": "jumlah_tia", "defaultContent": "0" },
    { "data": "kondisi",    "defaultContent": "-" },
    { "data": "ciri_tiang", "defaultContent": "-" },
    { "data": "kd_foto_1",  "orderable": false, "render": renderFoto },
    { "data": "kd_foto_2",  "orderable": false, "render": renderFoto },
    { "data": "kd_foto_3",  "orderable": false, "render": renderFoto },
    {
        "data": null, "orderable": false, "className": "text-center",
        "render": function (data, type, row) {
            // Tombol Maps
            let url = googleMapsUrl(row);
            let mapsBtn = url
                ? `<a href="${url}" target="_blank" rel="noopener"
                      class="btn btn-primary btn-sm" title="Buka di Google Maps">
                      <i class="fas fa-location-arrow"></i>
                   </a>`
                : `<button class="btn btn-secondary btn-sm" disabled title="Koordinat tidak tersedia">
                      <i class="fas fa-location-arrow"></i>
                   </button>`;

            // ✅ Tombol Edit hanya untuk provider 'Tidak Teridentifikasi'
            let editBtn = '';
            if (row.provider === 'Tidak Teridentifikasi') {
                editBtn = `<button class="btn btn-warning btn-sm ml-1 btn-edit-pengaku"
                            data-id="${row.id}"
                            data-pengaku="${row.pengaku ?? ''}"
                            data-no="${row.no ?? ''}"
                            title="Edit Pengaku (Assign Provider)">
                            <i class="fas fa-edit"></i>
                           </button>`;
            }

            return `<div style="width:100%;display:flex;justify-content:center;">
                        ${mapsBtn}${editBtn}
                    </div>`;
        }
    }
],
"columnDefs": [
        { "width": "40px", "targets": 0 }
    ],
    "drawCallback": function () {
        // Renumber baris sesuai page
        let info = this.api().page.info();
        this.api().column(0, { page: 'current' }).nodes().each(function (cell, i) {
            cell.innerHTML = (i + 1 + info.start) + '.';
        });
        // Rebind Fancybox untuk foto yang baru dimuat
        Fancybox.bind("[data-fancybox]", {});
    }
});

function loadTiang() {
    data_table.ajax.reload();
}

