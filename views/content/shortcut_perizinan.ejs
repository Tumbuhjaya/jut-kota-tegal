    <script type="text/javascript">
        var rooturl = '';

        // Efek tilt 3D + spotlight mengikuti kursor pada kartu menu
        (function () {
            var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            var canHover = window.matchMedia && window.matchMedia('(hover: hover)').matches;
            if (reduce || !canHover) return;

            document.querySelectorAll('.menu-card').forEach(function (card) {
                card.addEventListener('animationend', function () {
                    card.style.opacity = 1;
                    card.style.animation = 'none';
                }, { once: true });

                card.addEventListener('mousemove', function (e) {
                    var r = card.getBoundingClientRect();
                    var x = e.clientX - r.left, y = e.clientY - r.top;
                    var rx = ((y / r.height) - 0.5) * -10;
                    var ry = ((x / r.width) - 0.5) * 10;
                    card.style.setProperty('--mx', x + 'px');
                    card.style.setProperty('--my', y + 'px');
                    card.style.transform = 'perspective(700px) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg) translateY(-6px)';
                });
                card.addEventListener('mouseleave', function () {
                    card.style.transform = '';
                    card.style.setProperty('--mx', '50%');
                    card.style.setProperty('--my', '50%');
                });
            });
        })();
        
        let data_table  =$('#list-data').DataTable({
            "language": {
                "sProcessing":   "Sedang memproses...",
                "sLengthMenu":   "_MENU_",
                "sZeroRecords":  "Tidak ditemukan data yang sesuai",
                "sInfo":         "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
                "sInfoEmpty":    "Menampilkan 0 sampai 0 dari 0 entri",
                "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
                "sInfoPostFix":  "",
                "sUrl":          "",
                "oPaginate": {
                    "sFirst":    "Pertama",
                    "sPrevious": "Sebelumnya",
                    "sNext":     "Selanjutnya",
                    "sLast":     "Terakhir"
                }
            },
            // "processing": true,
            // "ajax":  `${rooturl}`,
            // "columns": [
            //     { "data": null},
            // ],
            // "columnDefs": [
            //     { "width": "40px", "targets": 0},
            // ],
        });

        data_table.on( 'draw.dt', function () {
            let PageInfo = $('#list-data').DataTable().page.info();
            data_table.column(0, { page: 'current' }).nodes().each( function (cell, i) {
                cell.innerHTML = i + 1 + PageInfo.start;
            });
        });
    </script>
