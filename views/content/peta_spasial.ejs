        /**
 * Format angka ke mata uang Rupiah (Indonesia)
 */
function formatRupiah(angka, denganRp = true, tampilkanDesimal = false) {
    if (angka === undefined || angka === null || angka === '') return '-';

    let cleaned = String(angka).replace(/[^0-9,.]/g, '').replace(',', '.');
    let num = parseFloat(cleaned);
    if (isNaN(num)) return '-';

    let isFloat = (num % 1 !== 0) || tampilkanDesimal;
    let parts = num.toFixed(isFloat ? 2 : 0).split('.');
    let integerPart = parts[0];
    let decimalPart = parts[1] || '';

    let integerWithSeparator = integerPart.replace(/\B(?=(\d{3})+(?!\d))/g, '.');

    let result = integerWithSeparator;
    if (isFloat && decimalPart) {
        result += ',' + decimalPart.padEnd(2, '0');
    }

    return denganRp ? 'Rp ' + result : result;
}
