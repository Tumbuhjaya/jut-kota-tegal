                 /* ============================================================
                  *  filterDataBtn()
                  *  - Await hasil getJSON supaya bisa ekstrak provider.
                  *  - Hitung provider UNIK (union tiang + kabel) sesuai checkbox.
                  *  - Set ke #jml_p (kanan) dan #jml_p_1 (kiri).
                  *  - Fix typo "math.round" → "Math.round".
                  * ============================================================ */
                 async function filterDataBtn() {
    let kec_id      = $('#kec_id').val();
let noruas = $('#no_ruas_id').val() || $('#ruas_id').val();
    let provider_id = $('#provider_id').val();

    let showTiang = $('#chkChart').prop('checked');
    let showKabel = $('#chkPrediction').prop('checked');

    // Set gabungan provider unik dari hasil filter
    let providerSet = new Set();

    // --- 1. Muat Kecamatan ---
    let geoJsonUrlKec = root + "peta/topojson_kec?id_kec=" + kec_id;
    $.getJSON(geoJsonUrlKec)
        .done(loadGeoJsonkec)
        .then(function() {
            // --- 2. Muat Ruas Jalan ---
            let geoJsonUrlJalan = root + "peta/sk_jalan?no=" + noruas;
            $.getJSON(geoJsonUrlJalan).done(loadGeoJsonSk_jalan);
        });

    // --- 3. Tiang (jika dicentang) ---
    if (showTiang) {
        let urlTiang = root + `peta/tiang?no=${noruas}&kd_kec=${kec_id}&provider_id=${provider_id}`;
        let tiangData = await $.getJSON(urlTiang);

        // Kumpulkan provider unik dari hasil tiang
        extractProviderSet(tiangData).forEach(function(p) { providerSet.add(p); });

        loadGeoJsonTiang(tiangData);

        let jumlah_tiang = await $.get(root + `peta/tiang?no=${noruas}&kd_kec=${kec_id}&provider_id=${provider_id}&sum=1`);
        console.log(jumlah_tiang);
        if (jumlah_tiang && jumlah_tiang[0]) {
            $('#jml_t').html(jumlah_tiang[0].jumlah_tiang);
        }
    } else {
        $('#jml_t').html(0);
        if (tiang_layer) {
            map.removeLayer(tiang_layer);
            tiang_layer = null;
        }
    }

    // --- 4. Kabel (jika dicentang) ---
    if (showKabel) {
        let urlKabel = root + `peta/ruas_kabel?no=${noruas}&kd_kec=${kec_id}&provider_id=${provider_id}`;
        let kabelData = await $.getJSON(urlKabel);

        // Kumpulkan provider unik dari hasil kabel
        extractProviderSet(kabelData).forEach(function(p) { providerSet.add(p); });

        loadGeoJsonRuasKabel(kabelData);

        let a = await $.get(root + `peta/ruas_kabel?no=${noruas}&kd_kec=${kec_id}&provider_id=${provider_id}&sum=1`);
        console.log(a);
        if (a && a[0]) {
            $('#pjg_k').html(Math.round(a[0].panjang_kabel));
        }
    } else {
        if (ruasKabelLayer) {
            map.removeLayer(ruasKabelLayer);
            ruasKabelLayer = null;
        }
        $('#pjg_k').html(0);
    }

    // --- 5. Tampilkan jumlah provider unik (gabungan tiang + kabel) ---
    let jmlProviderTampil = provider_id ? 1 : providerSet.size;
    $('#jml_p').html(jmlProviderTampil);     // kanan (offcanvas detail)
    $('#jml_p_1').html(jmlProviderTampil);   // kiri (sidebar ringkasan)
}
