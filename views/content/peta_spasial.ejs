function getColorByProvider(provider) {
    var providerColors = {
      "My Republik":'#e74c3c'

    };

    if (!providerColors[provider]) {
        if (!colorPalette[provider]) {
            colorPalette[provider] = randomColor();
        }
        return colorPalette[provider];
    }
    return providerColors[provider];
}

function randomColor() {
    return '#' + Math.floor(Math.random()*16777215).toString(16).padStart(6, '0');
}

/* ================================================================
 *  Helper: ambil daftar provider unik (Set) dari response
 *  GeoJSON / TopoJSON.
 * ================================================================ */
function extractProviderSet(data) {
    let set = new Set();
    if (!data) return set;

    let geojson;
    if (data.type === 'Topology') {
        let key = Object.keys(data.objects)[0];
        geojson = topojson.feature(data, data.objects[key]);
    } else {
        geojson = data;
    }

    if (geojson && geojson.features) {
        geojson.features.forEach(function (f) {
            let p = f.properties && f.properties.provider;
            if (p !== undefined && p !== null && String(p).trim() !== '') {
                set.add(String(p).trim());
            }
        });
    }
    return set;
}

