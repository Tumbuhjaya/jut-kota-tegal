            border-radius: 14px;
            padding: 1.2rem 1.4rem;
            margin-bottom: 1rem;
            transition: border-color 0.25s, box-shadow 0.3s;
        }
        .offcanvas-right .offcanvas-body .summary-item:hover {
            border-color: #4a9eff;
            box-shadow: 0 0 30px rgba(74, 158, 255, 0.08);
        }
        .offcanvas-right .offcanvas-body .summary-item .label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #4a6a8a;
            font-weight: 600;
            font-family: 'Inter Tight', sans-serif;
        }
        .offcanvas-right .offcanvas-body .summary-item .value {
            font-size: 1.4rem;
            font-weight: 700;
            color: #e6f1ff;
            margin-top: 4px;
            font-family: 'Orbitron', sans-serif;
        }
        .offcanvas-right .offcanvas-body .summary-item .value small {
            font-weight: 400;
